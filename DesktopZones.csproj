<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DeskOrder</AssemblyName>
    <Product>DeskOrder - 秩序桌面</Product>
    <Description>轻量级 Windows 桌面图标管理和美化工具</Description>
    <Company>Three-Freeze</Company>
    <Authors>Three-Freeze</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ponytail 2026-08-24: 把托管栏同款图标挂到 taskbar / Alt-Tab / EXE 文件属性。
         DesktopZones.ico 是 16+32+48+256 多分辨率（Resources/Icons/RebuildMultiResIco 打包），
         不带这个 tag 时 taskbar 走 Windows 默认空图标。 -->
    <ApplicationIcon>Resources\Icons\DesktopZones.ico</ApplicationIcon>
    <!-- 更新检测与 About 页的唯一版本来源。Directory.Build.props 关闭了
         GenerateAssemblyInfo 及各版本属性生成（CA1416 修复的历史原因），
         这里逐项重新打开，让 <Version> 真正写进程序集。 -->
    <Version>0.9.0</Version>
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>true</GenerateAssemblyInformationalVersionAttribute>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Resources\Icons\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="i18n\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- RebuildMultiResIco is a standalone console tool (its own .csproj). Its
       top-level Program.Main must NOT be compiled into DeskOrder, otherwise it
       becomes the WPF app's entry point and double-clicking DeskOrder.exe runs
       the icon tool (and crashes looking for icon-*.png in the wrong directory). -->
  <ItemGroup>
    <Compile Remove="Resources\Icons\RebuildMultiResIco\**\*.cs" />
    <None Remove="Resources\Icons\RebuildMultiResIco\**\*" />
    <Content Remove="Resources\Icons\RebuildMultiResIco\**\*" />
    <EmbeddedResource Remove="Resources\Icons\RebuildMultiResIco\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
