<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DeskOrder</AssemblyName>
    <Product>DeskOrder - 秩序桌面</Product>
    <Description>桌面分区管理工具，将混乱的桌面整理为有序的工作区域</Description>
    <Company>Three-Freeze</Company>
    <Authors>Three-Freeze</Authors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Resources\Icons\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="i18n\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <SeedTranslations Condition="'$(SeedTranslations)'==''">false</SeedTranslations>
  </PropertyGroup>

  <Target Name="SeedI18n" BeforeTargets="BeforeBuild"
          Condition="'$(SeedTranslations)'=='true'">
    <Message Text="==> Seeding missing translations..." Importance="high" />
    <Exec Command="dotnet run --project tools/seed-translations --verbosity quiet"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="ValidateI18n" AfterTargets="Build"
          Condition="'$(SeedTranslations)'=='true' AND Exists('$(MSBuildProjectDirectory)\i18n\source.zh.json')">
    <Message Text="==> Validating i18n..." Importance="high" />
    <Exec Command="dotnet run --project tools/seed-translations -- --validate-only"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <ItemGroup>
    <Compile Remove="DesktopZones.Tests\**" />
    <Page Remove="DesktopZones.Tests\**" />
    <ApplicationDefinition Remove="DesktopZones.Tests\**" />
    <None Remove="DesktopZones.Tests\**" />
    <Compile Remove="tools\**" />
    <Page Remove="tools\**" />
    <ApplicationDefinition Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <!-- i18n/ files are not source code, exclude from SDK globs -->
  <ItemGroup>
    <Compile Remove="i18n\**" />
    <Page Remove="i18n\**" />
    <Content Remove="i18n\**" />
  </ItemGroup>

</Project>
