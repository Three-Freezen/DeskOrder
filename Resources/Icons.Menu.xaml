  <!-- ══════════════════════════════════════════════════════════════════
       DeskOrder 右键菜单图标 · 方案 B · 简笔 LESS
       16×16 网格 · 描边 1.15 · 字形盒 10.6 · 全无填充
       ─────────────────────────────────────────────────────────────────
       设计稿与生成器：UI重构/menu-icons/
         · svg/02-B.svg          方案板（1:1 菜单 + 图标族）
         · DESIGN.md            规范、WPF 映射、验收清单

       规矩（改之前先读一遍）：
       1. 只描边、不填色。颜色一律 {DynamicResource Menu.Text.Secondary}，
          菜单跟系统主题（Helpers/MenuThemeService）走，不跟应用主题。
       2. 尺寸固定 16×16，配 ContextMenu.xaml 里 24px 的图标列（16 图标 + 8 间隔）。
          不要为「看起来大一点」改 Width —— 会顶到文字。
       3. 删除项用 MenuItemIconDanger（#FF6666，与现有 Foreground 一致）。
       4. 「设置」「锁定」两枚不走几何：直接用分区标题栏那两个字符
          （⚙ / 🔓 🔒），保证菜单和标题栏是同一个东西。见 MenuItemGlyph。
       ══════════════════════════════════════════════════════════════════ -->

  <!-- ── 菜单项图标样式 ──────────────────────────────────────────── -->
  <Style x:Key="MenuItemIcon" TargetType="Path">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="{DynamicResource Menu.Text.Secondary}"/>
    <Setter Property="StrokeThickness" Value="1.15"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>

  <Style x:Key="MenuItemIconDanger" TargetType="Path" BasedOn="{StaticResource MenuItemIcon}">
    <Setter Property="Stroke" Value="#FF6666"/>
  </Style>

  <!-- 文字字形图标：⚙ / 🔓 / 🔒 —— 与分区标题栏 EditBtnText / LockBtnText 同字符，
       字号按 16px 图标列放大（标题栏是 10px 小按钮）。15 是实测值：13 明显比其他
       图标轻一档，17 会从 16px 的图标列里溢出来，15 与 16px 矢量图标视觉等大。 -->
  <Style x:Key="MenuItemGlyph" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="{DynamicResource Menu.Text.Secondary}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
  </Style>

