<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Bg.Base">#000000</Color>
  <Color x:Key="Color.Bg.Chrome">#000000</Color>
  <Color x:Key="Color.Bg.Surface">#000000</Color>
  <Color x:Key="Color.Bg.Hover">#1A1A1A</Color>
  <Color x:Key="Color.Bg.Active">#2D2D2D</Color>
  <Color x:Key="Color.Bg.Input">#000000</Color>
  <Color x:Key="Color.Border.Subtle">#808080</Color>
  <Color x:Key="Color.Border.Default">#FFFFFF</Color>
  <Color x:Key="Color.Border.Strong">#FFFFFF</Color>
  <Color x:Key="Color.Text.Primary">#FFFFFF</Color>
  <Color x:Key="Color.Text.Secondary">#FFFFFF</Color>
  <Color x:Key="Color.Text.Tertiary">#C0C0C0</Color>
  <Color x:Key="Color.Text.Disabled">#808080</Color>
  <Color x:Key="Color.Accent">#FFFF00</Color>
  <Color x:Key="Color.Accent.Wash">#33FFFF00</Color>
  <!-- ponytail 2026-08-25: HC 主题下 Solid = mix(#FFFF00, black, 20%) = #CCCC00; On 保留 #000000 黑（高对比）-->
  <Color x:Key="Color.Accent.Solid">#CCCC00</Color>
  <Color x:Key="Color.Accent.Solid.Hover">#B3B300</Color>
  <Color x:Key="Color.Accent.Solid.Press">#E6E600</Color>
  <Color x:Key="Color.Accent.Solid.Disabled">#AACCCC00</Color>
  <Color x:Key="Color.Accent.On">#000000</Color>
  <Color x:Key="Color.Accent.On.Disabled">#66000000</Color>
  <Color x:Key="Color.Accent.2">#00FFFF</Color>
  <Color x:Key="Color.Success">#00FF00</Color>
  <Color x:Key="Color.Warning">#FFFF00</Color>
  <Color x:Key="Color.Danger">#FF0000</Color>
  <Color x:Key="Color.Danger.Solid">#FF0000</Color>
  <Color x:Key="Color.Danger.Wash">#33FF0000</Color>
  <Color x:Key="Color.Close.Hover">#FF0000</Color>
</ResourceDictionary>
