<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Bg.Base">#F5F6F8</Color>
  <Color x:Key="Color.Bg.Chrome">#FFFFFF</Color>
  <Color x:Key="Color.Bg.Surface">#FFFFFF</Color>
  <Color x:Key="Color.Bg.Hover">#F0F1F4</Color>
  <Color x:Key="Color.Bg.Active">#E8EAEE</Color>
  <Color x:Key="Color.Bg.Input">#FFFFFF</Color>
  <Color x:Key="Color.Border.Subtle">#E4E7EC</Color>
  <Color x:Key="Color.Border.Default">#CFD4DC</Color>
  <Color x:Key="Color.Border.Strong">#98A2B3</Color>
  <Color x:Key="Color.Text.Primary">#1A1D21</Color>
  <Color x:Key="Color.Text.Secondary">#5A6069</Color>
  <Color x:Key="Color.Text.Tertiary">#868C96</Color>
  <Color x:Key="Color.Text.Disabled">#B0B5BD</Color>
  <Color x:Key="Color.Accent">#1E88E5</Color>
  <Color x:Key="Color.Accent.Wash">#1A1E88E5</Color>
  <!-- ponytail 2026-08-25: 镂空算法静态值 — Solid = mix(#1E88E5, black, 20%) = #1370BB;
       On = mix(#1E88E5, #F5F6F8, 50%) = #8AB1C2.
       Brush.Accent.Solid/On = {DynamicResource Color.Accent.Solid/On} 自动跟随主题切换。-->
  <Color x:Key="Color.Accent.Solid">#1370BB</Color>
  <Color x:Key="Color.Accent.Solid.Hover">#0E5A99</Color>
  <Color x:Key="Color.Accent.Solid.Press">#1F86CC</Color>
  <Color x:Key="Color.Accent.Solid.Disabled">#991370BB</Color>
  <Color x:Key="Color.Accent.On">#8AB1C2</Color>
  <Color x:Key="Color.Accent.On.Disabled">#551370BB</Color>
  <Color x:Key="Color.Accent.2">#00ACC1</Color>
  <Color x:Key="Color.Success">#3D9E4F</Color>
  <Color x:Key="Color.Warning">#B36A00</Color>
  <Color x:Key="Color.Danger">#C5221F</Color>
  <Color x:Key="Color.Danger.Solid">#C5221F</Color>
  <Color x:Key="Color.Danger.Wash">#14C5221F</Color>
  <Color x:Key="Color.Close.Hover">#E81123</Color>
</ResourceDictionary>