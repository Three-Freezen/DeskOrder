<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Brush.Bg.Base"             Color="{DynamicResource Color.Bg.Base}"/>
  <SolidColorBrush x:Key="Brush.Bg.Chrome"           Color="{DynamicResource Color.Bg.Chrome}"/>
  <SolidColorBrush x:Key="Brush.Bg.Surface"          Color="{DynamicResource Color.Bg.Surface}"/>
  <SolidColorBrush x:Key="Brush.Bg.Hover"            Color="{DynamicResource Color.Bg.Hover}"/>
  <SolidColorBrush x:Key="Brush.Bg.Active"           Color="{DynamicResource Color.Bg.Active}"/>
  <SolidColorBrush x:Key="Brush.Bg.Input"            Color="{DynamicResource Color.Bg.Input}"/>
  <SolidColorBrush x:Key="Brush.Border.Subtle"       Color="{DynamicResource Color.Border.Subtle}"/>
  <SolidColorBrush x:Key="Brush.Border.Default"      Color="{DynamicResource Color.Border.Default}"/>
  <SolidColorBrush x:Key="Brush.Border.Strong"       Color="{DynamicResource Color.Border.Strong}"/>
  <SolidColorBrush x:Key="Brush.Text.Primary"        Color="{DynamicResource Color.Text.Primary}"/>
  <SolidColorBrush x:Key="Brush.Text.Secondary"      Color="{DynamicResource Color.Text.Secondary}"/>
  <SolidColorBrush x:Key="Brush.Text.Tertiary"       Color="{DynamicResource Color.Text.Tertiary}"/>
  <SolidColorBrush x:Key="Brush.Text.Disabled"       Color="{DynamicResource Color.Text.Disabled}"/>
  <SolidColorBrush x:Key="Brush.Accent"              Color="{DynamicResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.Accent.Wash"         Color="{DynamicResource Color.Accent.Wash}"/>
  <SolidColorBrush x:Key="Brush.Accent.Solid"        Color="{DynamicResource Color.Accent.Solid}"/>
  <SolidColorBrush x:Key="Brush.Accent.Solid.Hover"  Color="{DynamicResource Color.Accent.Solid.Hover}"/>
  <SolidColorBrush x:Key="Brush.Accent.Solid.Press"  Color="{DynamicResource Color.Accent.Solid.Press}"/>
  <!-- ponytail 2026-08-25: 镂空设计新增 brush。Solid.Disabled = 淡填充（禁用态），
       On = 同色淡化版（镂空文字，效果"若隐若现"），On.Disabled = 更淡（禁用态文字）。 -->
  <SolidColorBrush x:Key="Brush.Accent.Solid.Disabled" Color="{DynamicResource Color.Accent.Solid.Disabled}"/>
  <SolidColorBrush x:Key="Brush.Accent.On"           Color="{DynamicResource Color.Accent.On}"/>
  <SolidColorBrush x:Key="Brush.Accent.On.Disabled"  Color="{DynamicResource Color.Accent.On.Disabled}"/>
  <!-- ponytail 2026-08-28: 固定蓝色按钮系 — 不跟随系统强调色（FillBtn / OutlineBtn /
       勾选类控件共用）。深蓝底 = Solid 系；亮蓝底 = Outline 系；文字/√/圆点 = On 白。 -->
  <SolidColorBrush x:Key="Brush.Btn.Solid" Color="#256FC8"/>
  <SolidColorBrush x:Key="Brush.Btn.Solid.Hover" Color="#2E83D5"/>
  <SolidColorBrush x:Key="Brush.Btn.Solid.Press" Color="#1F5DAB"/>
  <SolidColorBrush x:Key="Brush.Btn.Solid.Disabled" Color="#66256FC8"/>
  <SolidColorBrush x:Key="Brush.Btn.On" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Btn.On.Disabled" Color="#66FFFFFF"/>
  <SolidColorBrush x:Key="Brush.Btn.Outline" Color="#2E97F0"/>
  <SolidColorBrush x:Key="Brush.Btn.Outline.Hover" Color="#3AA3F2"/>
  <SolidColorBrush x:Key="Brush.Btn.Outline.Press" Color="#2784CF"/>
  <SolidColorBrush x:Key="Brush.Btn.Border" Color="#59AEF4"/>
  <SolidColorBrush x:Key="Brush.Btn.Border.Hover" Color="#7CC2F9"/>
  <SolidColorBrush x:Key="Brush.Accent.2"            Color="{DynamicResource Color.Accent.2}"/>
  <SolidColorBrush x:Key="Brush.Success"             Color="{DynamicResource Color.Success}"/>
  <SolidColorBrush x:Key="Brush.Warning"             Color="{DynamicResource Color.Warning}"/>
  <SolidColorBrush x:Key="Brush.Danger"              Color="{DynamicResource Color.Danger}"/>
  <SolidColorBrush x:Key="Brush.Danger.Solid"        Color="{DynamicResource Color.Danger.Solid}"/>
  <SolidColorBrush x:Key="Brush.Danger.Wash"         Color="{DynamicResource Color.Danger.Wash}"/>
  <SolidColorBrush x:Key="Brush.Close.Hover"         Color="{DynamicResource Color.Close.Hover}"/>
</ResourceDictionary>