<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Bg.Base">#1C1C1C</Color>
  <Color x:Key="Color.Bg.Chrome">#222222</Color>
  <Color x:Key="Color.Bg.Surface">#262626</Color>
  <Color x:Key="Color.Bg.Hover">#2E2E2E</Color>
  <Color x:Key="Color.Bg.Active">#333333</Color>
  <Color x:Key="Color.Bg.Input">#2A2A2A</Color>
  <Color x:Key="Color.Border.Subtle">#333333</Color>
  <Color x:Key="Color.Border.Default">#454545</Color>
  <Color x:Key="Color.Border.Strong">#5A5A5A</Color>
  <Color x:Key="Color.Text.Primary">#ECECEC</Color>
  <Color x:Key="Color.Text.Secondary">#A8A8A8</Color>
  <Color x:Key="Color.Text.Tertiary">#767676</Color>
  <Color x:Key="Color.Text.Disabled">#565656</Color>
  <Color x:Key="Color.Accent">#2E97F0</Color>
  <Color x:Key="Color.Accent.Wash">#242E97F0</Color>
  <!-- ponytail 2026-08-25: 镂空算法静态值（避免运行时 brush dict 替换导致 ApplyBtn 镂空丢失）。
       Solid = mix(#2E97F0, black, 20%) = #256FC8; On = mix(#2E97F0, #1C1C1C, 50%) = #255A86.
       Theme.Brushes.xaml 里 Brush.Accent.Solid = {DynamicResource Color.Accent.Solid} 会自动跟随。-->
  <Color x:Key="Color.Accent.Solid">#256FC8</Color>
  <Color x:Key="Color.Accent.Solid.Hover">#1F5DAB</Color>
  <Color x:Key="Color.Accent.Solid.Press">#2E83D5</Color>
  <Color x:Key="Color.Accent.Solid.Disabled">#99256FC8</Color>
  <Color x:Key="Color.Accent.On">#255A86</Color>
  <Color x:Key="Color.Accent.On.Disabled">#55256FC8</Color>
  <Color x:Key="Color.Accent.2">#14BFD4</Color>
  <Color x:Key="Color.Success">#5BC46E</Color>
  <Color x:Key="Color.Warning">#FFB020</Color>
  <Color x:Key="Color.Danger">#FF6B6B</Color>
  <Color x:Key="Color.Danger.Solid">#D13438</Color>
  <Color x:Key="Color.Danger.Wash">#24FF6B6B</Color>
  <Color x:Key="Color.Close.Hover">#E81123</Color>
</ResourceDictionary>