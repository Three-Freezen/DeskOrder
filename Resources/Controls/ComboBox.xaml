<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════
       ComboBox — spec §5.2
       Closed: 32px high, 4px corner radius, bg.input, 1px border.default
       Open:   border.accent, chevron rotated 180°
       Popup:  bg.surface, 1px border.default, 6px corner radius,
               AllowsTransparency=True, PopupAnimation=None
       — ponytail 2026-08-24:
         (1) ToggleButton now fills the entire surface (was 28px on the right).
             ContentSite sits on top with IsHitTestVisible=False so clicks
             anywhere on the row fall through to ToggleButton and toggle the
             dropdown. Chevron is still right-aligned via Grid alignment inside
             ToggleButton's own template.
         (2) Chevron Path has RenderTransformOrigin="0.5,0.5" so the
             RotateTransform Angle=180 spins around the icon center instead of
             the top-left (which used to make the arrow visibly jump on toggle).
         (3) DropDownBorder is wrapped in a Grid that carries a ScaleTransform
             (RenderTransformOrigin 0.5,0 top) so opening plays a "expand down"
             storyboard — Opacity 0→1 + ScaleY 0.92→1, Motion.Fast + StandardSpline.
             Closing reverses via ExitActions.
       ═══════════════════════════════════════════ -->

  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Input}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="10,4,28,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <Grid>
                <!-- ToggleButton fills the entire surface: clicks anywhere
                     on the row (including over ContentSite text) fall through
                     to it because ContentSite is IsHitTestVisible=False. -->
                <ToggleButton x:Name="ToggleButton"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Grid Background="Transparent">
                        <!-- Chevron: right-aligned in the right gutter; origin
                             (0.5,0.5) so the rotate transform doesn't make it
                             shift position. -->
                        <Path x:Name="Chevron"
                              Width="12" Height="12"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              Stretch="Uniform"
                              RenderTransformOrigin="0.5,0.5"
                              Stroke="{DynamicResource Brush.Text.Secondary}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="{StaticResource Icon.ChevronDown}"/>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chevron" Property="RenderTransform">
                            <Setter.Value>
                              <RotateTransform Angle="180"/>
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <!-- ContentSite: hit-test transparent so clicks fall through to ToggleButton. -->
                <ContentPresenter x:Name="ContentSite"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
              </Grid>
            </Border>

            <!-- Drop-down popup -->
            <Popup x:Name="PART_Popup"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="None"
                   HorizontalOffset="0"
                   VerticalOffset="2">
              <!-- Wrap in a Grid that carries a ScaleTransform at top-center
                   so the open animation can scale the popup out from its
                   top edge ("expand down"). -->
              <Grid x:Name="DropDownRoot"
                    RenderTransformOrigin="0.5,0"
                    Opacity="0">
                <Grid.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="0.92"/>
                </Grid.RenderTransform>
                <!-- ponytail 2026-08-24: TemplateBind to ComboBox chrome so callers
                     that want a locked dropdown (e.g. StickyNoteWindow's FontSizeCombo
                     which sets LockedDark brushes) get the popup chrome matching the
                     closed state. ComboBoxes without explicit overrides still resolve
                     via the Style setter above (Brush.Bg.Input / Brush.Border.Default)
                     so existing call sites are unaffected. -->
                <Border x:Name="DropDownBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="280">
                  <ScrollViewer Padding="0,4" CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DropDownRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="{StaticResource Motion.Fast}"
                                     EasingFunction="{StaticResource Motion.StandardSpline}"/>
                    <DoubleAnimation Storyboard.TargetName="DropDownRoot"
                                     Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.92" To="1"
                                     Duration="{StaticResource Motion.Fast}"
                                     EasingFunction="{StaticResource Motion.StandardSpline}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DropDownRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="{StaticResource Motion.Fast}"/>
                    <DoubleAnimation Storyboard.TargetName="DropDownRoot"
                                     Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.92"
                                     Duration="{StaticResource Motion.Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Base}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComboBoxItem — 32px high, hover bg.hover, selected accent.wash + check icon -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Margin" Value="4,2"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4"
                  Padding="10,0"
                  SnapsToDevicePixels="True">
            <Grid>
              <ContentPresenter HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0"/>
              <!-- Check icon: visible only when selected -->
              <Path x:Name="Check"
                    Width="16" Height="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Stretch="Uniform"
                    Stroke="{DynamicResource Brush.Accent}"
                    StrokeThickness="1.5"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Data="{StaticResource Icon.Check}"
                    Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Wash}"/>
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <!-- Selected + hovered: brighten wash (40% alpha) -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background">
                <Setter.Value>
                  <SolidColorBrush Color="{DynamicResource Color.Accent}" Opacity="0.40"/>
                </Setter.Value>
              </Setter>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>