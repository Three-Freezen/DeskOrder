<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════
       ContextMenu — spec §5.3
       bg.surface, 1px border.default, 6px corner radius, 4px vertical padding
       MenuItem: 32px high, 4px corner radius, 4px horizontal margin,
                 optional 16px icon area (text starts at 34px when present, 10px otherwise)
       ═══════════════════════════════════════════ -->

  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="0,4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Margin" Value="4,1"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <!-- Icon gutter: 16px when present, 0 when absent (handled via Icon binding) -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- Optional icon area: renders only when Icon is set -->
              <ContentPresenter x:Name="Icon"
                                Grid.Column="0"
                                Width="16" Height="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                ContentSource="Icon"
                                SnapsToDevicePixels="True"/>

              <!-- Header text -->
              <ContentPresenter Grid.Column="1"
                                ContentSource="Header"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                RecognizesAccessKey="True"/>

              <!-- Right-side input gesture text (e.g. shortcut hint) -->
              <TextBlock Grid.Column="2"
                         x:Name="InputGestureText"
                         Margin="16,0,0,0"
                         VerticalAlignment="Center"
                         FontSize="11"
                         Foreground="{DynamicResource Brush.Text.Tertiary}"
                         Text="{TemplateBinding InputGestureText}"/>
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <!-- When icon absent, push header to 0px left padding -->
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Width" Value="0"/>
              <Setter TargetName="Icon" Property="Margin" Value="0"/>
            </Trigger>

            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Hover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Separator inside menu -->
  <Style TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}"/>
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="4,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Background="{TemplateBinding Background}"
                  Height="{TemplateBinding Height}"
                  Margin="{TemplateBinding Margin}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>