<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Switch style: based on CheckBox so IsChecked/Click handlers work as-is. -->
  <Style x:Key="SwitchStyle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Width" Value="36"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="{TemplateBinding Background}"
                SnapsToDevicePixels="True">
            <Border x:Name="Track"
                    Width="36" Height="20"
                    CornerRadius="10"
                    Background="{DynamicResource Brush.Bg.Active}">
              <Border x:Name="Dot"
                      Width="16" Height="16"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      CornerRadius="8"
                      Background="{DynamicResource Brush.Text.Tertiary}">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="DotTransform" X="2"/>
                </Border.RenderTransform>
              </Border>
            </Border>
          </Grid>

          <ControlTemplate.Triggers>
            <!-- ponytail 2026-08-25: 镂空 Switch — 开启时 Track = Accent.Solid（深 accent 填充），
                 Dot = Accent.On（同色淡化 60%，镂空效果），不用 ColorAnimation 因为 brush 是 SolidColorBrush 的 Color DP。
                 关闭时恢复 Brush.Bg.Active 灰色 Track + Brush.Text.Tertiary 灰色 Dot。 -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent.Solid}"/>
              <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.Accent.On}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
