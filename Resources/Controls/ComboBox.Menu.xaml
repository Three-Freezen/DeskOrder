<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════
       ComboBox (Menu 调色板) — 跟随系统深浅色，不跟随管理界面主题。
       与 Resources/Controls/ComboBox.xaml 同款模板，只是把 Brush.*
       换成 Menu.*（由 MenuThemeService 随 Windows 深浅色实时改写）。
       供便签字体字号下拉框等「非管理界面」控件使用。
       ═══════════════════════════════════════════════════════════ -->

  <Style x:Key="Menu.ComboBox" TargetType="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Menu.Bg.Hover}"/>
    <Setter Property="Foreground" Value="{DynamicResource Menu.Text.Primary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Menu.Border.Subtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="10,4,28,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <Grid>
                <ToggleButton x:Name="ToggleButton"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                      <Grid Background="Transparent">
                        <Path x:Name="Chevron"
                              Width="12" Height="12"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              Stretch="Uniform"
                              RenderTransformOrigin="0.5,0.5"
                              Stroke="{DynamicResource Menu.Text.Secondary}"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="{StaticResource Icon.ChevronDown}"/>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="Chevron" Property="RenderTransform">
                            <Setter.Value>
                              <RotateTransform Angle="180"/>
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="ContentSite"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
              </Grid>
            </Border>

            <Popup x:Name="PART_Popup"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="None"
                   HorizontalOffset="0"
                   VerticalOffset="2">
              <Grid x:Name="DropDownRoot"
                    RenderTransformOrigin="0.5,0"
                    Opacity="0">
                <Grid.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="0.92"/>
                </Grid.RenderTransform>
                <Border x:Name="DropDownBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="280">
                  <ScrollViewer Padding="0,4" CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Menu.Text.Secondary}"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Menu.Accent.Solid}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DropDownRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="{StaticResource Motion.Fast}"
                                     EasingFunction="{StaticResource Motion.StandardSpline}"/>
                    <DoubleAnimation Storyboard.TargetName="DropDownRoot"
                                     Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.92" To="1"
                                     Duration="{StaticResource Motion.Fast}"
                                     EasingFunction="{StaticResource Motion.StandardSpline}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DropDownRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="{StaticResource Motion.Fast}"/>
                    <DoubleAnimation Storyboard.TargetName="DropDownRoot"
                                     Storyboard.TargetProperty="(RenderTransform).(ScaleTransform.ScaleY)"
                                     To="0.92"
                                     Duration="{StaticResource Motion.Fast}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Menu.Bg.Surface}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Menu.Border.Subtle}"/>
              <Setter Property="Foreground" Value="{DynamicResource Menu.Text.Disabled}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComboBoxItem (Menu 调色板) -->
  <Style x:Key="Menu.ComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Menu.Text.Primary}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Margin" Value="4,2"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4"
                  Padding="10,0"
                  SnapsToDevicePixels="True">
            <Grid>
              <ContentPresenter HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0"/>
              <Path x:Name="Check"
                    Width="16" Height="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Stretch="Uniform"
                    Stroke="{DynamicResource Menu.Accent.On}"
                    StrokeThickness="1.5"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Data="{StaticResource Icon.Check}"
                    Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Menu.Bg.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Menu.Accent.Solid}"/>
              <Setter Property="Foreground" Value="{DynamicResource Menu.Accent.On}"/>
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Menu.Accent.Solid}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Menu.Text.Disabled}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
