<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DeskOrder.PluginApi</AssemblyName>
    <RootNamespace>DeskOrder.PluginApi</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Version>1.0.0</Version>
    <!-- 插件作者从 GitHub Release 下载本 DLL 引用；不发 NuGet。 -->
    <Product>DeskOrder Plugin SDK</Product>
    <Description>DeskOrder 插件 API（v1）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 宿主需要给 PluginWidgetContext 的回调赋值（internal init），
         保持公开 API 不含宿主实现细节。见 AssemblyInfo.cs。 -->
  </ItemGroup>

</Project>
