<Window x:Class="DesktopZones.Views.MotionSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Title="{loc:Loc Motion.Title} Width="320" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="10"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
            MouseLeftButtonDown="TitleBar_Down">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleLabel" Text="{loc:Loc Motion.Title} FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,12"/>

            <!-- Origin mode -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="OriginLabel" Text="{loc:Loc Motion.Origin} FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock x:Name="OriginHint" Text="{loc:Loc Motion.OriginHint} FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="OriginCombo" VerticalAlignment="Center" Width="140">
                    <ComboBoxItem x:Name="ItemOriginCenter" Content="{loc:Loc Motion.Origin.ButtonCenter} Tag="ButtonCenter"/>
                    <ComboBoxItem x:Name="ItemOriginCorner" Content="{loc:Loc Motion.Origin.ButtonCorner} Tag="ButtonCorner"/>
                </ComboBox>
            </Grid>

            <!-- Animation kind -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="AnimationKindLabel" Text="{loc:Loc Motion.AnimationKind} FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock x:Name="AnimationKindHint" Text="{loc:Loc Motion.AnimationKindHint} FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="AnimationCombo" VerticalAlignment="Center" Width="120">
                    <ComboBoxItem x:Name="ItemScaleExpand" Content="{loc:Loc Motion.Animation.ScaleExpand} Tag="ScaleExpand"/>
                    <ComboBoxItem x:Name="ItemFade" Content="{loc:Loc Motion.Animation.Fade} Tag="Fade"/>
                    <ComboBoxItem x:Name="ItemBounceExpand" Content="{loc:Loc Motion.Animation.BounceExpand} Tag="BounceExpand"/>
                    <ComboBoxItem x:Name="ItemDirectionalExpand" Content="{loc:Loc Motion.Animation.DirectionalExpand} Tag="DirectionalExpand"/>
                    <ComboBoxItem x:Name="ItemVerticalExpand" Content="{loc:Loc Motion.Animation.VerticalExpand} Tag="VerticalExpand"/>
                    <ComboBoxItem x:Name="ItemNone" Content="{loc:Loc Motion.Animation.None} Tag="None"/>
                </ComboBox>
            </Grid>

            <!-- Speed slider -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SpeedLabel" Text="{loc:Loc Motion.Speed} FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock x:Name="SpeedHint" Text="{loc:Loc Motion.SpeedHint} FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                </StackPanel>
                <Slider Grid.Column="1" x:Name="SpeedSlider"
                        Minimum="0.25" Maximum="2.0" TickFrequency="0.25"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock Grid.Column="2" x:Name="SpeedValueText"
                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="{loc:Loc Preset.Cancel}"
                        Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                        Padding="14,6" Cursor="Hand" Click="Cancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="OkBtn" Content="{loc:Loc Preset.Save}"
                        Background="{DynamicResource Brush.Accent}" Foreground="White"
                        BorderThickness="0" Padding="14,6" Margin="8,0,0,0"
                        Cursor="Hand" IsDefault="True" Click="Ok_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>