<Window x:Class="DesktopZones.Views.MotionSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="动效设置" Width="320" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="10"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
            MouseLeftButtonDown="TitleBar_Down">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleLabel" Text="动效设置" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,12"/>

            <!-- Origin mode -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="OriginLabel" Text="动效原点" FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock x:Name="OriginHint" Text="展开从按钮的哪个位置开始" FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="OriginCombo" VerticalAlignment="Center" Width="140">
                    <ComboBoxItem x:Name="ItemOriginCenter" Content="四周展开" Tag="ButtonCenter"/>
                    <ComboBoxItem x:Name="ItemOriginCorner" Content="按钮作为分区左上角" Tag="ButtonCorner"/>
                </ComboBox>
            </Grid>

            <!-- Animation kind -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="AnimationKindLabel" Text="展开动画" FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock x:Name="AnimationKindHint" Text="鼠标悬停触发的展开效果类型" FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="AnimationCombo" VerticalAlignment="Center" Width="120">
                    <ComboBoxItem x:Name="ItemScaleExpand" Content="缩放展开" Tag="ScaleExpand"/>
                    <ComboBoxItem x:Name="ItemFade" Content="淡入淡出" Tag="Fade"/>
                    <ComboBoxItem x:Name="ItemBounceExpand" Content="弹性" Tag="BounceExpand"/>
                    <ComboBoxItem x:Name="ItemDirectionalExpand" Content="定向" Tag="DirectionalExpand"/>
                    <ComboBoxItem x:Name="ItemVerticalExpand" Content="纵向" Tag="VerticalExpand"/>
                    <ComboBoxItem x:Name="ItemNone" Content="无" Tag="None"/>
                </ComboBox>
            </Grid>

            <!-- Speed slider -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SpeedLabel" Text="动画速度" FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock x:Name="SpeedHint" Text="0.5 = 慢，2.0 = 快" FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                </StackPanel>
                <Slider Grid.Column="1" x:Name="SpeedSlider"
                        Minimum="0.25" Maximum="2.0" TickFrequency="0.25"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock Grid.Column="2" x:Name="SpeedValueText"
                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="取消"
                        Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                        Padding="14,6" Cursor="Hand" Click="Cancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="OkBtn" Content="保存"
                        Background="{DynamicResource Brush.Accent}" Foreground="White"
                        BorderThickness="0" Padding="14,6" Margin="8,0,0,0"
                        Cursor="Hand" IsDefault="True" Click="Ok_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>