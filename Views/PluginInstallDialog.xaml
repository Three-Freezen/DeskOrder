<Window x:Class="DesktopZones.Views.PluginInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Width="600" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="12"
          BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
    <Grid Margin="22,18,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
        <TextBlock x:Name="TitleText" Text="{loc:Loc Key=Plugin.InstallConfirm.Title}"
                   FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
      </Grid>

      <StackPanel Grid.Row="1" Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{loc:Loc Key=Plugin.Name}" FontSize="12" Width="86"
                     Foreground="{DynamicResource Brush.Text.Tertiary}"/>
          <TextBlock x:Name="NameText" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                     TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}"/>
        </Grid>
        <TextBlock x:Name="MetaText" Margin="86,6,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
        <TextBlock x:Name="ContentsText" Margin="86,4,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
        <TextBlock x:Name="PermissionsText" Margin="86,4,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
        <Grid x:Name="HashRow" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="86"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{loc:Loc Key=Plugin.Hash}" FontSize="12"
                     Foreground="{DynamicResource Brush.Text.Tertiary}"/>
          <TextBox x:Name="HashBox" Grid.Column="1" IsReadOnly="True" BorderThickness="0"
                   Background="Transparent" FontFamily="Cascadia Code, Consolas, monospace"
                   FontSize="10.5" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
          <Button Grid.Column="2" Content="{loc:Loc Key=Common.Copy}" Width="52" Height="22" FontSize="10.5"
                  Cursor="Hand" Style="{DynamicResource OutlineBtn}" Click="CopyHash_Click"
                  ToolTip="Copy SHA-256"/>
        </Grid>
      </StackPanel>

      <Border Grid.Row="2" Margin="0,16,0,0" Padding="12,9" CornerRadius="6"
              Background="#14FFB020" BorderBrush="#40FFB020" BorderThickness="1">
        <TextBlock x:Name="WarningText" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
      </Border>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="{loc:Loc Key=Common.Cancel}" Width="92" Height="32" Cursor="Hand"
                Style="{DynamicResource OutlineBtn}" Click="Cancel_Click"/>
        <Button x:Name="InstallButton" Content="{loc:Loc Key=Plugin.Install}" Width="92" Height="32"
                Margin="10,0,0,0" Cursor="Hand" FontWeight="SemiBold"
                Style="{DynamicResource FillBtn}" Click="Install_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
