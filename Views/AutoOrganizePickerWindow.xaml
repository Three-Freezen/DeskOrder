<Window x:Class="DesktopZones.Views.AutoOrganizePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" Height="400" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="12"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
            MouseLeftButtonDown="TitleBar_Down">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>

            <!-- Title/content divider (自适应文字色,同液态玻璃二级窗口) -->
            <Border Grid.Row="1" Height="1" Margin="0,0,0,10"
                    Background="{DynamicResource Menu.Separator}"/>

            <!-- Preset group (extension mode only) -->
            <TextBlock x:Name="PresetGroupLabel" Grid.Row="2" FontSize="11"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,4"/>
            <WrapPanel x:Name="PresetChips" Grid.Row="3" Margin="0,0,0,12"/>

            <!-- Custom group label + add -->
            <DockPanel Grid.Row="4" Margin="0,0,0,6" LastChildFill="True">
                <Button x:Name="AddBtn" DockPanel.Dock="Right" Width="28" Height="28"
                        Content="+" FontSize="16"
                        Background="{DynamicResource Brush.Bg.Input}"
                        Foreground="{DynamicResource Brush.Text.Secondary}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                        Cursor="Hand" Click="Add_Click"/>
                <TextBlock x:Name="CustomGroupLabel" FontSize="11"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Custom chips -->
            <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="CustomChips"/>
            </ScrollViewer>

            <!-- OK / Cancel -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelBtn" Padding="16,6" Cursor="Hand" FontSize="12"
                        Click="Cancel_Click" IsCancel="True"
                        Style="{DynamicResource OutlineBtn}"/>
                <Button x:Name="OkBtn" Padding="16,6" Margin="8,0,0,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                        Click="Ok_Click" IsDefault="True"
                        Style="{DynamicResource FillBtn}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
