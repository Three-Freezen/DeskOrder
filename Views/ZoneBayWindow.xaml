<Window x:Class="DesktopZones.Views.ZoneBayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zone Bay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MinWidth="44" MinHeight="44"
        Width="800" Height="60"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid x:Name="Root" Background="Transparent">
        <!-- 胶囊背板：窗口 == 可见胶囊（一格高，60 DIP）。
             玻璃开着时窗口整体交给 DWM 合成 / 壁纸采样层，这里只保留边框。 -->
        <Border x:Name="Backplate"
                CornerRadius="12"
                BorderThickness="1"
                Background="#08000000"
                BorderBrush="#38FFFFFF">
            <Grid>
                <!-- 自绘玻璃层（渲染方案 = 壁纸采样时使用）；垫在芯片/图标下面。 -->
                <Grid x:Name="GlassHost"
                      ClipToBounds="True"
                      IsHitTestVisible="False"
                      Visibility="Collapsed"/>
                <Grid x:Name="ContentHost" Margin="12,0" Background="Transparent">
                    <ContentPresenter x:Name="PluginContent"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>
                    <ScrollViewer x:Name="ChipScroll"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  PanningMode="HorizontalOnly">
                        <StackPanel x:Name="FallbackChips"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                    </ScrollViewer>
                </Grid>
                <TextBlock x:Name="EmptyHint"
                           Text=""
                           FontSize="11.5"
                           Foreground="#70FFFFFF"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- 拖入高亮：不参与命中测试 -->
        <Border x:Name="DropHighlight"
                CornerRadius="12"
                BorderThickness="2"
                BorderBrush="#FF6AA8FF"
                Background="#186AA8FF"
                Visibility="Collapsed"
                IsHitTestVisible="False"/>

        <!-- 坞自己的恢复按钮（最小化后） -->
        <Border x:Name="RestoreButton"
                Width="36" Height="36"
                CornerRadius="10"
                Background="#331E1E1E"
                BorderThickness="1"
                BorderBrush="#55FFFFFF"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="4,4,0,0"
                Visibility="Collapsed"
                Cursor="Hand"
                MouseLeftButtonUp="RestoreButton_MouseLeftButtonUp">
            <Path x:Name="RestoreIcon"
                  Width="20" Height="20"
                  Stretch="Uniform"
                  Stroke="#F0FFFFFF"
                  StrokeThickness="1.5"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
        </Border>

        <!-- 自动隐藏时露出的 3px 触发条；贴在当前可见的那条边 -->
        <Border x:Name="TriggerStrip"
                Height="3"
                Background="#24000000"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Visibility="Collapsed"
                MouseEnter="TriggerStrip_MouseEnter"/>

        <!-- 芯片拖出/换位的跟随影子（Popup 不会抢焦点，也不吃鼠标） -->
        <Popup x:Name="ChipGhost"
               AllowsTransparency="True"
               StaysOpen="True"
               IsHitTestVisible="False"
               Placement="AbsolutePoint">
            <Border x:Name="ChipGhostBox"
                    Width="40" Height="40"
                    CornerRadius="10"
                    Background="#CC1E1E1E"
                    BorderThickness="1"
                    BorderBrush="#55FFFFFF"
                    Opacity="0.85">
                <Image x:Name="ChipGhostImage"
                       Width="28" Height="28"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>
        </Popup>
    </Grid>
</Window>
