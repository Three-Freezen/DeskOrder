<Window x:Class="DesktopZones.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
        xmlns:l="clr-namespace:DesktopZones.Services"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Width="800" Height="450"
        MinWidth="400" MinHeight="300"
        AllowDrop="True"
        DragEnter="Panel_DragEnter"
        DragOver="Panel_DragOver"
        Drop="Panel_Drop">

    <Grid>
        <Border x:Name="PanelBorder" CornerRadius="10"
                BorderBrush="#30FFFFFF" BorderThickness="1.5"
                Background="Transparent">
            <Grid>
                <!-- Background image -->
                <Border x:Name="BgImageBorder" ClipToBounds="True" CornerRadius="10"
                        IsHitTestVisible="False">
                    <Image x:Name="BgImage" Stretch="UniformToFill"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Rectangle x:Name="FillRect" Fill="#08000000"
                           RadiusX="10" RadiusY="10" IsHitTestVisible="False"/>

                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top bar: clock | title+zone selector | search | view toggle | settings -->
                    <Border x:Name="TopBar" Grid.Row="0" Height="44"
                            Background="#10FFFFFF"
                            CornerRadius="10,10,0,0"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="TitleBar_Drag">
                        <Grid Margin="12,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Clock + Date -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="ClockText" Text="🕐"
                                           FontSize="14" Foreground="#A0FFFFFF"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="DateText" Text=""
                                           FontSize="11" Foreground="#8080A0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Panel title + zone selector -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="TitleText" Text="桌面"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#E8E8F0"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="ZoneSelector" Width="100" Height="24"
                                          FontSize="11" SelectedIndex="0"
                                          SelectionChanged="ZoneSelector_Changed"/>
                            </StackPanel>

                            <!-- Search bar -->
                            <Border Grid.Column="2" Height="28" CornerRadius="14"
                                    Background="#15FFFFFF" BorderBrush="#20FFFFFF"
                                    BorderThickness="1" VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <Grid Margin="8,0">
                                    <TextBlock x:Name="SearchPlaceholder" Text="{loc:Loc Key=Panel.Search}"
                                               FontSize="11" Foreground="#606080"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="SearchBox" FontSize="11"
                                             Foreground="#E8E8F0" Background="Transparent"
                                             BorderThickness="0" CaretBrush="#E8E8F0"
                                             VerticalAlignment="Center"
                                             TextChanged="SearchBox_TextChanged"/>
                                </Grid>
                            </Border>

                            <!-- Grid/List toggle -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border x:Name="GridToggleBtn" Width="26" Height="26"
                                        CornerRadius="4" Background="#20FFFFFF"
                                        Cursor="Hand" Margin="0,0,4,0"
                                        MouseLeftButtonDown="GridToggle_Click">
                                    <TextBlock Text="▦" FontSize="12" Foreground="#E8E8F0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="ListToggleBtn" Width="26" Height="26"
                                        CornerRadius="4" Background="Transparent"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="ListToggle_Click">
                                    <TextBlock Text="≡" FontSize="12" Foreground="#8080A0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Import/New button -->
                            <Border Grid.Column="4" x:Name="ImportBtn" Width="26" Height="26"
                                    CornerRadius="4" Background="#30FFFFFF"
                                    Cursor="Hand" Margin="0,0,8,0"
                                    MouseLeftButtonDown="ImportBtn_Click"
                                    MouseEnter="Ctrl_Enter" MouseLeave="Ctrl_Leave"
                                    ToolTip="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Panel.Import]}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="CtxImportFiles" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Panel.ImportFiles]}" Click="ImportFile_Click"/>
                                        <MenuItem x:Name="CtxImportFolder" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Panel.ImportFolder]}" Click="ImportFolder_Click"/>
                                        <Separator/>
                                        <MenuItem x:Name="CtxNew" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Panel.New]}">
                                            <MenuItem x:Name="CtxNewFolder" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Panel.NewFolder]}" Click="NewFolder_Click"/>
                                            <Separator/>
                                            <MenuItem x:Name="CtxNewTextFile" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Panel.NewTxt]}" Click="NewTextFile_Click"/>
                                            <MenuItem x:Name="CtxNewWordFile" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Panel.NewDocx]}" Click="NewWordFile_Click"/>
                                            <MenuItem x:Name="CtxNewPptFile" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Panel.NewPptx]}" Click="NewPptFile_Click"/>
                                            <MenuItem x:Name="CtxNewExcelFile" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Panel.NewXlsx]}" Click="NewExcelFile_Click"/>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <TextBlock Text="+" FontSize="14" FontWeight="Bold"
                                           Foreground="#80FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Settings + Hide -->
                            <StackPanel Grid.Column="5" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border x:Name="SettingsBtn" Width="26" Height="26"
                                        CornerRadius="4" Background="#30FFFFFF"
                                        Cursor="Hand" Margin="0,0,4,0"
                                        MouseLeftButtonDown="SettingsBtn_Click"
                                        MouseEnter="Ctrl_Enter" MouseLeave="Ctrl_Leave"
                                        ToolTip="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Panel.Settings]}">
                                    <TextBlock Text="⚙" FontSize="12" Foreground="#8080A0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="HideBtn" Width="26" Height="26"
                                        CornerRadius="4" Background="#30FFFFFF"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="HideButton_Click"
                                        MouseEnter="Ctrl_Enter" MouseLeave="Ctrl_Leave"
                                        ToolTip="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Panel.Hide]}">
                                    <TextBlock Text="─" FontSize="10" Foreground="#8080A0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content area -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" Margin="8,4,8,8"
                                  MouseRightButtonDown="ContentArea_RightClick">
                        <StackPanel x:Name="ContentStack"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Resize grips -->
        <Border Width="12" Height="12"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="SizeNWSE" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down"/>
        <Border Width="12" Height="12"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="SizeNESW" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down"/>
        <Border Width="12" Height="12"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Cursor="SizeNESW" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down"/>
        <Border Width="12" Height="12"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="SizeNWSE" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down"/>
    </Grid>
</Window>
