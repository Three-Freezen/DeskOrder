<Window x:Class="DesktopZones.Views.IconPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Title="{loc:Loc Key=IconPicker.Title}" Width="380" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="12"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleLabel" Text="Pick Icon" FontSize="14"
                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="4,4,0,10"/>

            <!-- Title/content divider -->
            <Border Grid.Row="1" Height="1" Margin="0,0,0,10"
                    Background="{DynamicResource Menu.Separator}"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="IconGrid"/>
            </ScrollViewer>

            <Button x:Name="CancelBtn" Content="Cancel" Grid.Row="3"
                    Padding="16,6" Cursor="Hand" FontSize="12"
                    HorizontalAlignment="Right" Margin="0,10,0,0"
                    Click="Cancel_Click"
                    Style="{DynamicResource OutlineBtn}"/>
        </Grid>
    </Border>
</Window>
