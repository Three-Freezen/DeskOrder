<Window x:Class="DesktopZones.Views.PluginDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Width="720" Height="580" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="12"
          BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="60"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="22,0,14,0" Background="Transparent"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="{loc:Loc Key=Plugin.Detail}" FontSize="14" FontWeight="SemiBold"
                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}"/>
        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28"
                Cursor="Hand" Foreground="{DynamicResource Brush.Text.Secondary}"
                Click="Close_Click" ToolTip="{loc:Loc Key=Common.Close}">
          <Path Data="{StaticResource Icon.Close}" Width="10" Height="10" Stretch="Uniform"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                StrokeLineJoin="Round"/>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="72" Height="72" CornerRadius="10" Background="{DynamicResource Brush.Bg.Hover}"
                    ClipToBounds="True">
              <Grid>
                <Path x:Name="PlaceholderIcon" Width="30" Height="30" Stretch="Uniform"
                      Fill="{DynamicResource Brush.Text.Tertiary}" Data="{StaticResource Icon.Plugin}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="IconImage" Stretch="Uniform" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis"
                           MaxWidth="480"/>
                <Border x:Name="OfficialPill" Visibility="Collapsed" Margin="10,0,0,0" Height="20"
                        Padding="8,0" CornerRadius="10" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Accent.Wash}">
                  <TextBlock Text="{loc:Loc Key=Plugin.Official}" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                </Border>
              </StackPanel>
              <TextBlock x:Name="MetaText" Margin="0,6,0,0" FontSize="12"
                         Foreground="{DynamicResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
              <TextBlock x:Name="StateText" Margin="0,6,0,0" FontSize="11"
                         Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
              <TextBlock x:Name="SignatureText" Margin="0,4,0,0" FontSize="11"
                         Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>

          <Border x:Name="NoticeBar" Visibility="Collapsed" Margin="0,16,0,0" Padding="12,9"
                  CornerRadius="6" Background="#16FF5A5A" BorderBrush="#40FF5A5A" BorderThickness="1">
            <TextBlock x:Name="NoticeText" FontSize="11.5" TextWrapping="Wrap" LineHeight="18"
                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
          </Border>

          <TextBlock x:Name="SummaryText" Margin="0,18,0,0" FontSize="13" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Text.Primary}"/>
          <TextBlock x:Name="DescriptionText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.Text.Secondary}"/>

          <StackPanel x:Name="LanguageBlock" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock Text="{loc:Loc Key=Plugin.Type.Language}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,6"/>
            <TextBlock x:Name="LanguageText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
          </StackPanel>

          <StackPanel x:Name="AppearanceBlock" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock Text="{loc:Loc Key=Plugin.Type.Appearance}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,6"/>
            <TextBlock x:Name="AppearanceText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
          </StackPanel>

          <!-- 一个包多类型：逐条列出这个包提供的能力（有运行时计数就带上数量）。 -->
          <StackPanel x:Name="CapabilitiesBlock" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock Text="{loc:Loc Key=Plugin.Contents.Capabilities}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,6"/>
            <TextBlock x:Name="CapabilitiesText" FontSize="12" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
          </StackPanel>

          <StackPanel x:Name="PermissionsBlock" Visibility="Collapsed" Margin="0,16,0,0">
            <TextBlock Text="{loc:Loc Key=Plugin.Permissions}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,6"/>
            <TextBlock x:Name="PermissionsText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
          </StackPanel>

          <Border x:Name="PreviewHost" Visibility="Collapsed" Margin="0,16,0,0" CornerRadius="8"
                  MinHeight="120" ClipToBounds="True" Background="{DynamicResource Brush.Bg.Hover}">
            <Grid>
              <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="300"/>
              <!-- 多图轮播：箭头与计数只在预览图 ≥2 张时出现（±在代码里按总数切换）。 -->
              <Button x:Name="PreviewPrevButton" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Width="28" Height="28" Margin="8,0,0,0" Padding="0" Cursor="Hand"
                      Style="{DynamicResource OutlineBtn}" Visibility="Collapsed"
                      ToolTip="{loc:Loc Key=Plugin.Preview.Prev}" Click="PreviewPrev_Click">
                <Path Data="{StaticResource Icon.ChevronLeft}" Width="8" Height="8" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
              </Button>
              <Button x:Name="PreviewNextButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Width="28" Height="28" Margin="0,0,8,0" Padding="0" Cursor="Hand"
                      Style="{DynamicResource OutlineBtn}" Visibility="Collapsed"
                      ToolTip="{loc:Loc Key=Plugin.Preview.Next}" Click="PreviewNext_Click">
                <Path Data="{StaticResource Icon.ChevronRight}" Width="8" Height="8" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
              </Button>
              <Border x:Name="PreviewCounter" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,8,8,0" Padding="8,2" CornerRadius="9" Background="#B31A1D23"
                      Visibility="Collapsed">
                <TextBlock x:Name="PreviewCountText" FontSize="10.5" Foreground="#FFF2F4F8"
                           FontFamily="Cascadia Code, Consolas, monospace"/>
              </Border>
            </Grid>
          </Border>

          <TextBlock x:Name="RepoText" Margin="0,16,0,4" FontSize="11"
                     Foreground="{DynamicResource Brush.Text.Tertiary}"/>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2" Margin="22,0,22,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Button x:Name="GithubButton" Content="{loc:Loc Key=Plugin.Repo}" Height="30" Padding="12,0"
                  FontSize="11.5" Cursor="Hand" Style="{DynamicResource OutlineBtn}"
                  Click="Github_Click"/>
          <Button x:Name="ReportButton" Content="{loc:Loc Key=Plugin.Report}" Height="30" Padding="12,0"
                  Margin="8,0,0,0" FontSize="11.5" Cursor="Hand"
                  Style="{DynamicResource OutlineBtn}" Click="Report_Click"
                  ToolTip="{loc:Loc Key=Plugin.Report.Hint}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <!-- widget 插件启用后：已安装行的入口是压缩的「＋」图标，这里的文字按钮是主要入口。 -->
          <Button x:Name="NewWidgetButton" Content="{loc:Loc Key=PluginWidget.New}" Height="32" Width="104"
                  Margin="0,0,10,0" Cursor="Hand" FontSize="12"
                  Style="{DynamicResource OutlineBtn}" Click="NewWidget_Click" Visibility="Collapsed"/>
          <Button x:Name="UninstallButton" Content="{loc:Loc Key=Plugin.Uninstall}" Height="32" Width="92"
                  Cursor="Hand" FontSize="12" Foreground="#FFE05A5A" Background="#14FF5A5A"
                  BorderBrush="#66FF5A5A"
                  Style="{DynamicResource OutlineBtn}" Click="Uninstall_Click" Visibility="Collapsed"/>
          <Button x:Name="ToggleButton" Content="{loc:Loc Key=Plugin.Disable}" Height="32" Width="92"
                  Margin="10,0,0,0" Cursor="Hand" FontSize="12"
                  Style="{DynamicResource OutlineBtn}" Click="Toggle_Click" Visibility="Collapsed"/>
          <Button x:Name="PrimaryButton" Content="{loc:Loc Key=Plugin.Install}" Height="32" Width="104"
                  Margin="10,0,0,0" Cursor="Hand" FontWeight="SemiBold"
                  Style="{DynamicResource FillBtn}" Click="Primary_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
