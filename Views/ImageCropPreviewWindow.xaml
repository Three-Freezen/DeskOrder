<Window x:Class="DesktopZones.Views.ImageCropPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Crop Preview" Width="800" Height="600"
        MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SnapsToDevicePixels="True">

    <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="12"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#AA000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="Auto"/>  <!-- Title-bar divider -->
                <RowDefinition Height="*"/>     <!-- Preview area -->
                <RowDefinition Height="Auto"/>  <!-- Controls -->
                <RowDefinition Height="Auto"/>  <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title Bar with current values display -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="DialogTitle" Text="Image Crop Preview"
                           FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="OffsetDisplay" Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="{DynamicResource Brush.Text.Secondary}" Margin="4,0"/>
                    <TextBlock x:Name="ZoomDisplay" Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

            </Grid>

            <!-- ponytail: title-bar divider — dedicated full-width row with the
                 theme-adaptive secondary text color so it is clearly visible in
                 light/dark/high-contrast AND in System-accent mode (where the
                 Border.* brushes are repainted at low alpha by ThemeService). -->
            <Border Grid.Row="1" Height="2" Margin="0,0,0,10"
                    Background="{DynamicResource Brush.Text.Secondary}"/>

            <!-- Preview Area -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Bg.Surface}" CornerRadius="8"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                    ClipToBounds="True" x:Name="PreviewBorder"
                    MouseWheel="PreviewBorder_MouseWheel"
                    MouseLeftButtonDown="PreviewBorder_MouseLeftButtonDown"
                    MouseLeftButtonUp="PreviewBorder_MouseLeftButtonUp"
                    MouseMove="PreviewBorder_MouseMove"
                    SizeChanged="PreviewBorder_SizeChanged">

                <Grid x:Name="PreviewGrid">
                    <!-- Background image -->
                    <Canvas x:Name="ImageCanvas" ClipToBounds="True" IsHitTestVisible="False">
                        <Image x:Name="CropImage" Stretch="UniformToFill"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScale"/>
                                    <TranslateTransform x:Name="ImageTranslate"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Canvas>

                    <!-- Rule-of-thirds grid lines (theme-adaptive so they stay visible
                         in light/dark/high-contrast; drawn above the image). -->
                    <Canvas x:Name="GridLinesCanvas" IsHitTestVisible="False" Opacity="0.55"/>

                    <!-- Real-widget title-bar/body boundary guide (snap target). -->
                    <Canvas x:Name="DividerCanvas" IsHitTestVisible="False"/>

                    <!-- Crop area overlay (semi-transparent dark outside zone) -->
                    <Canvas x:Name="CropOverlay" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Controls Panel -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- BgZoom slider: zoom of the background image (formerly ZoomSlider).
                     Slider-only UI — adjusts CropImage transform but does not bind to Zone. -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="LabelZoom" Text="Zoom:" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Slider x:Name="BgZoom" Width="150" Minimum="0.01" Maximum="10.0"
                                TickFrequency="0.1" Value="1.0"
                                ValueChanged="BgZoom_ValueChanged"/>
                        <TextBlock x:Name="ZoomValueText" Text="1.0x"
                                   Foreground="{DynamicResource Brush.Text.Primary}" FontSize="12"
                                   Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- BgOpacity slider: opacity of the background image (formerly OpacitySlider).
                     Slider-only UI — adjusts CropImage opacity but does not bind to Zone. -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="LabelOpacity" Text="Opacity:" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Slider x:Name="BgOpacity" Width="80" Minimum="5" Maximum="100"
                                TickFrequency="5" Value="40"
                                ValueChanged="BgOpacity_ValueChanged"/>
                        <TextBlock x:Name="OpacityValueText" Text="40%"
                                   Foreground="{DynamicResource Brush.Text.Primary}" FontSize="12"
                                   Width="36" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="ResetButton" Content="Reset"
                        Background="{DynamicResource Brush.Bg.Surface}" Foreground="{DynamicResource Brush.Text.Secondary}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                        Padding="16,8" Cursor="Hand" FontSize="12"
                        Click="ResetButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="CancelButton" Content="Cancel"
                        Background="{DynamicResource Brush.Bg.Surface}" Foreground="{DynamicResource Brush.Text.Secondary}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                        Padding="20,8" Margin="8,0,0,0" Cursor="Hand" FontSize="12"
                        Click="CancelButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="ConfirmButton" Content="Confirm"
                        Background="{DynamicResource Brush.Accent.Solid}" Foreground="{DynamicResource Brush.Accent.On}"
                        BorderThickness="0" Padding="20,8" Margin="8,0,0,0"
                        Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                        Click="ConfirmButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                    <Button.Style>
                      <!-- ponytail 2026-08-25: 镂空 + 禁用态淡化 -->
                      <Style TargetType="Button">
                        <Style.Triggers>
                          <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Solid.Disabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.On.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ponytail: corner resize grips — the preview (zone outline / image / grid /
             title-bar divider) auto-fits the window size via PreviewBorder.SizeChanged →
             CalculatePreviewScale. -->
        <Border x:Name="GripTL" Width="12" Height="12"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="SizeNWSE" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down"/>
        <Border x:Name="GripTR" Width="12" Height="12"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="SizeNESW" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down"/>
        <Border x:Name="GripBL" Width="12" Height="12"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Cursor="SizeNESW" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down"/>
        <Border x:Name="GripBR" Width="12" Height="12"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="SizeNWSE" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down"/>
        </Grid>
    </Border>
</Window>
