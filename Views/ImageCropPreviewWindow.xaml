<Window x:Class="DesktopZones.Views.ImageCropPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Crop Preview" Width="800" Height="600"
        MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#E610111A"/>
        <SolidColorBrush x:Key="Acc" Color="#7C3AED"/>
        <SolidColorBrush x:Key="T1" Color="#E8E8F0"/>
        <SolidColorBrush x:Key="T2" Color="#8888A0"/>
        <SolidColorBrush x:Key="T3" Color="#606080"/>
        <SolidColorBrush x:Key="IBg" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="IBd" Color="#15FFFFFF"/>
        
        <Style x:Key="DTb" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource IBg}"/>
            <Setter Property="Foreground" Value="{StaticResource T1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource IBd}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="DLb" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource T2}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        
        <ControlTemplate x:Key="DarkComboTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                    Background="{StaticResource IBg}" BorderBrush="{StaticResource IBd}"
                    BorderThickness="1" Foreground="{StaticResource T1}"
                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                    ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="6,4">
                                <Grid>
                                    <Path x:Name="Arrow" Data="M0,0L4,4L8,0" Fill="{StaticResource T2}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}"
                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,4,20,4"
                    VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                    AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Border x:Name="DropDownBorder" Background="{StaticResource IBg}"
                            BorderBrush="{StaticResource IBd}" BorderThickness="1" CornerRadius="4"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}">
                        <ScrollViewer><ItemsPresenter/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboTemplate}"/>
            <Setter Property="Background" Value="{StaticResource IBg}"/>
            <Setter Property="Foreground" Value="{StaticResource T1}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource IBg}"/>
            <Setter Property="Foreground" Value="{StaticResource T1}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" CornerRadius="12" 
            BorderBrush="#15FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#AA000000" Opacity="0.6"/>
        </Border.Effect>
        
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="*"/>     <!-- Preview area -->
                <RowDefinition Height="Auto"/>  <!-- Controls -->
                <RowDefinition Height="Auto"/>  <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title Bar with current values display -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="DialogTitle" Text="Image Crop Preview" 
                           FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource T1}"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="OffsetDisplay" Foreground="{StaticResource T2}" 
                               FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="{StaticResource T2}" Margin="4,0"/>
                    <TextBlock x:Name="ZoomDisplay" Foreground="{StaticResource T2}" 
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Preview Area -->
            <Border Grid.Row="1" Background="#08FFFFFF" CornerRadius="8" 
                    BorderBrush="{StaticResource IBd}" BorderThickness="1"
                    ClipToBounds="True" x:Name="PreviewBorder"
                    MouseWheel="PreviewBorder_MouseWheel"
                    MouseLeftButtonDown="PreviewBorder_MouseLeftButtonDown"
                    MouseLeftButtonUp="PreviewBorder_MouseLeftButtonUp"
                    MouseMove="PreviewBorder_MouseMove"
                    SizeChanged="PreviewBorder_SizeChanged">
                
                <Grid x:Name="PreviewGrid">
                    <!-- Zone outline (dashed border showing target dimensions) -->
                    <Border x:Name="ZoneOutline" BorderBrush="#7C3AED"
                            BorderThickness="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="Transparent" IsHitTestVisible="False"/>
                    <Ellipse x:Name="ZoneOutlineEllipse" Stroke="#7C3AED"
                             StrokeThickness="2"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="Transparent" IsHitTestVisible="False"
                             Visibility="Collapsed"/>

                    <!-- Grid lines for alignment (optional) -->
                    <Canvas x:Name="GridLinesCanvas" IsHitTestVisible="False" Opacity="0.3"/>

                    <!-- Background image -->
                    <Canvas x:Name="ImageCanvas" ClipToBounds="True" IsHitTestVisible="False">
                        <Image x:Name="CropImage" Stretch="UniformToFill"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ImageScale"/>
                                    <TranslateTransform x:Name="ImageTranslate"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Canvas>

                    <!-- Crop area overlay (semi-transparent dark outside zone) -->
                    <Canvas x:Name="CropOverlay" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Controls Panel -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- Zoom slider -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="LabelZoom" Text="Zoom:" Foreground="{StaticResource T2}" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Slider x:Name="ZoomSlider" Width="150" Minimum="0.01" Maximum="10.0"
                                TickFrequency="0.1" Value="1.0"
                                ValueChanged="ZoomSlider_ValueChanged"/>
                        <TextBlock x:Name="ZoomValueText" Text="1.0x"
                                   Foreground="{StaticResource T1}" FontSize="12"
                                   Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Opacity slider -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="LabelOpacity" Text="Opacity:" Foreground="{StaticResource T2}" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Slider x:Name="OpacitySlider" Width="80" Minimum="5" Maximum="100"
                                TickFrequency="5" Value="40"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                        <TextBlock x:Name="OpacityValueText" Text="40%"
                                   Foreground="{StaticResource T1}" FontSize="12"
                                   Width="36" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" 
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="ResetButton" Content="Reset" 
                        Background="#15FFFFFF" Foreground="{StaticResource T2}" 
                        BorderBrush="{StaticResource IBd}" BorderThickness="1" 
                        Padding="16,8" Cursor="Hand" FontSize="12"
                        Click="ResetButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="CancelButton" Content="Cancel" 
                        Background="#15FFFFFF" Foreground="{StaticResource T2}" 
                        BorderBrush="{StaticResource IBd}" BorderThickness="1" 
                        Padding="20,8" Margin="8,0,0,0" Cursor="Hand" FontSize="12"
                        Click="CancelButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="ConfirmButton" Content="Confirm" 
                        Background="{StaticResource Acc}" Foreground="White" 
                        BorderThickness="0" Padding="20,8" Margin="8,0,0,0" 
                        Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                        Click="ConfirmButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>