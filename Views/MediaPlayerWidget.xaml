<Window x:Class="DesktopZones.Views.MediaPlayerWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        xmlns:h="clr-namespace:DesktopZones.Helpers"
        xmlns:components="clr-namespace:DesktopZones.Views.Components"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True">

    <Grid PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
          PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">
        <Border x:Name="MainContent" ClipToBounds="True" CornerRadius="12">
            <Grid>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="CtxSettings" Header="{loc:Loc Key=Media.Settings}" Click="Settings_Click"/>
                        <Separator/>
                        <MenuItem x:Name="CtxLock" Header="{loc:Loc Key=Common.Lock}" Click="LockBtn_Click"/>
                        <MenuItem x:Name="CtxMinimize" Header="{loc:Loc Key=Media.Minimize}" Click="Minimize_Click"/>
                        <MenuItem x:Name="CtxDelete" Header="{loc:Loc Key=Media.Delete}" Click="Delete_Click" Foreground="#FF6666"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <Border x:Name="BorderRoot" CornerRadius="12" BorderBrush="#40FFFFFF" BorderThickness="1">
                    <Grid>
                        <!-- 填充层单独一个 Rectangle：透明窗口里这样重绘最可靠（同时钟/分区） -->
                        <Rectangle x:Name="FillRect" RadiusX="12" RadiusY="12" Fill="#08000000" IsHitTestVisible="False"/>

                        <!-- 背景图（全出血，圆角由 MainContent 裁） -->
                        <Border x:Name="BgImageBorder" ClipToBounds="True" IsHitTestVisible="False" Visibility="Collapsed">
                            <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="0"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- ══ 律动条模式 ══ -->
                        <Grid x:Name="BarsPanel" Margin="18,12,18,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 条区（单击 = 播放/暂停，由窗口统一判定点击） -->
                            <Grid x:Name="BarsRoot" Grid.Row="0" Background="Transparent">
                                <components:SpectrumBars x:Name="Bars"/>
                                <TextBlock x:Name="BarsHint" Text="{loc:Loc Key=Media.NoMediaHint}"
                                           FontSize="11" Foreground="#66FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Grid>

                            <!-- 分割线：比条区略长（左右各 -8），可单独隐藏 -->
                            <Rectangle x:Name="Divider" Grid.Row="1" Height="1" Margin="-8,7,-8,0"
                                       Fill="#3CFFFFFF" HorizontalAlignment="Stretch"/>

                            <!-- 下半部分：曲名/歌手 + 控制按钮；紧贴条区底部 -->
                            <Grid x:Name="TrackPanel" Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText" Text="{loc:Loc Key=Media.NoMedia}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#EEFFFFFF"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ArtistText" Text="" FontSize="11" Foreground="#99FFFFFF"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel x:Name="BarsControls" Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="BarsPrevBtn" Width="26" Height="26" Click="Prev_Click"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Template="{x:Static h:HoverHighlight.RoundedButtonTemplate}"
                                            h:HoverHighlight.IsEnabled="True">
                                        <Path Width="12" Height="12" Stretch="Uniform" Stroke="#E6FFFFFF"
                                              StrokeThickness="1.4" StrokeLineJoin="Round"
                                              Data="{StaticResource Icon.MediaPrev}"/>
                                    </Button>
                                    <Button x:Name="BarsPlayBtn" Width="30" Height="30" Click="PlayPause_Click"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Template="{x:Static h:HoverHighlight.RoundedButtonTemplate}"
                                            h:HoverHighlight.IsEnabled="True">
                                        <Path x:Name="BarsPlayIcon" Width="13" Height="13" Stretch="Uniform"
                                              Stroke="#FFFFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round"
                                              Data="{StaticResource Icon.MediaPause}"/>
                                    </Button>
                                    <Button x:Name="BarsNextBtn" Width="26" Height="26" Click="Next_Click"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Template="{x:Static h:HoverHighlight.RoundedButtonTemplate}"
                                            h:HoverHighlight.IsEnabled="True">
                                        <Path Width="12" Height="12" Stretch="Uniform" Stroke="#E6FFFFFF"
                                              StrokeThickness="1.4" StrokeLineJoin="Round"
                                              Data="{StaticResource Icon.MediaNext}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ══ 唱片机模式 ══ -->
                        <Grid x:Name="VinylPanel" Visibility="Collapsed" Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" x:Name="DiscHost" Background="Transparent">
                                <components:VinylPlayerVisual x:Name="Disc"/>
                                <!-- 唱臂单独一层：只在落针/抬起的摆动期间重绘，
                                     盘面每帧转的时候不连累它（见 TonearmVisual 注释） -->
                                <components:TonearmVisual x:Name="Arm"/>
                                <TextBlock x:Name="VinylHint" Text="{loc:Loc Key=Media.NoMedia}"
                                           FontSize="11" Foreground="#88FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                           Margin="0,0,0,4" Visibility="Collapsed"/>
                            </Grid>

                            <Grid x:Name="VinylInfo" Grid.Column="1" Width="160" Margin="14,4,2,4">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="VinylTitle" Text="{loc:Loc Key=Media.NoMedia}"
                                               FontSize="16" FontWeight="SemiBold" Foreground="#EEFFFFFF"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               LineHeight="21" MaxHeight="46"/>
                                    <TextBlock x:Name="VinylArtist" Text="" FontSize="12" Foreground="#B0FFFFFF"
                                               Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="VinylAlbum" Text="" FontSize="10" Foreground="#80FFFFFF"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel x:Name="VinylControls" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="-6,16,0,0">
                                        <Button x:Name="VinylPrevBtn" Width="30" Height="30" Click="Prev_Click"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Template="{x:Static h:HoverHighlight.RoundedButtonTemplate}"
                                                h:HoverHighlight.IsEnabled="True">
                                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="#E6FFFFFF"
                                                  StrokeThickness="1.4" StrokeLineJoin="Round"
                                                  Data="{StaticResource Icon.MediaPrev}"/>
                                        </Button>
                                        <Button x:Name="VinylPlayBtn" Width="36" Height="36" Click="PlayPause_Click"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Template="{x:Static h:HoverHighlight.RoundedButtonTemplate}"
                                                h:HoverHighlight.IsEnabled="True">
                                            <Path x:Name="VinylPlayIcon" Width="15" Height="15" Stretch="Uniform"
                                                  Stroke="#FFFFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round"
                                                  Data="{StaticResource Icon.MediaPause}"/>
                                        </Button>
                                        <Button x:Name="VinylNextBtn" Width="30" Height="30" Click="Next_Click"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Template="{x:Static h:HoverHighlight.RoundedButtonTemplate}"
                                                h:HoverHighlight.IsEnabled="True">
                                            <Path Width="13" Height="13" Stretch="Uniform" Stroke="#E6FFFFFF"
                                                  StrokeThickness="1.4" StrokeLineJoin="Round"
                                                  Data="{StaticResource Icon.MediaNext}"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 顶部悬浮按钮（磁贴模式隐藏） -->
                        <Button x:Name="LockBtn" Content="🔓" Width="20" Height="20"
                                FontSize="10" Foreground="#60FFFFFF"
                                Background="Transparent" BorderThickness="0"
                                Template="{x:Static h:HoverHighlight.RoundedButtonTemplate}"
                                h:HoverHighlight.IsEnabled="True"
                                Cursor="Hand" Click="LockBtn_Click"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="6,4,0,0" Panel.ZIndex="10"/>
                        <Button x:Name="HideBtn" Content="─" Width="20" Height="20"
                                FontSize="10" Foreground="#60FFFFFF"
                                Background="Transparent" BorderThickness="0"
                                Template="{x:Static h:HoverHighlight.RoundedButtonTemplate}"
                                h:HoverHighlight.IsEnabled="True"
                                Cursor="Hand" Click="HideBtn_Click"
                                MouseLeftButtonDown="HideBtn_MouseDown"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,4,6,0" Panel.ZIndex="10"/>
                    </Grid>
                </Border>

                <!-- 液态玻璃色差描边（叠加层，不替代用户边框） -->
                <Border x:Name="GlassBorder" CornerRadius="12" Background="Transparent"
                        BorderThickness="0" IsHitTestVisible="False" Panel.ZIndex="20"/>
            </Grid>
        </Border>

        <!-- 恢复按钮（最小化后只剩它） -->
        <Border x:Name="RestoreButton"
                Visibility="Collapsed"
                Width="40" Height="40"
                CornerRadius="20"
                Background="{DynamicResource Menu.Bg.Surface}"
                BorderThickness="0"
                Cursor="Hand"
                MouseLeftButtonDown="Restore_MouseDown"
                MouseMove="Restore_MouseMove"
                MouseLeftButtonUp="Restore_MouseUp"
                MouseEnter="Restore_Enter" MouseLeave="Restore_Leave">
            <Grid>
                <Path x:Name="RestoreIconPath" Width="20" Height="20"
                      Stretch="Uniform" Stroke="#C0FFFFFF" StrokeThickness="1.5"
                      StrokeLineJoin="Round" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="RestoreIconChar" Text="♫"
                           FontSize="18" Foreground="#C0FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 四角缩放把手 -->
        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="SizeNWSE" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="TL"/>
        <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="SizeNESW" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="TR"/>
        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Cursor="SizeNESW" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="BL"/>
        <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="SizeNWSE" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="BR"/>
    </Grid>
</Window>
