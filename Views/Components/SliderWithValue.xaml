<UserControl x:Class="DesktopZones.Views.Components.SliderWithValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="48"/>
    </Grid.ColumnDefinitions>
    <!-- ponytail 2026-10: 原来没有吸附, 拖动时 WPF 会把像素位置换算回 33.47 / 40.32
         这种小数, 右侧数字于是显示两位小数(用户报的问题)。
         这里不用 IsSnapToTickEnabled —— 那会连 Tick(5) 一起吸附, 变成只能选 5 的倍数。
         改为: Tick 只画刻度, 值的取整由 code-behind 按 1 的步长吸附。 -->
    <Slider x:Name="PART_Slider" Grid.Column="0"
            Minimum="{Binding Min, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Maximum="{Binding Max, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Value="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
            TickFrequency="{Binding Tick, RelativeSource={RelativeSource AncestorType=UserControl}}"
            VerticalAlignment="Center"/>
    <Border x:Name="ValueBox" Grid.Column="1" Margin="8,0,0,0"
            Background="Transparent" BorderThickness="0" CornerRadius="2"
            Padding="6,2" HorizontalAlignment="Right">
      <TextBlock x:Name="ValueText"
                 FontFamily="Cascadia Code, Consolas, monospace"
                 FontSize="11"
                 Foreground="{DynamicResource Brush.Text.Secondary}"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 MouseLeftButtonDown="ValueText_DoubleClick"/>
    </Border>
  </Grid>
</UserControl>
