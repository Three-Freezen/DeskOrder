<UserControl x:Class="DesktopZones.Views.Components.Segmented"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ponytail 2026-08-26: sliding-highlight segmented pill. A Border slides
       under the selected segment (200ms Motion.StandardSpline ease-out, driven
       from code-behind) instead of the segment repainting its own fill — the
       "background glides to the target segment" motion. Segments render with
       SegmentItem.Slide (same look as SegmentItem minus the self-drawn
       selected fill). Equal-width segments via UniformGrid. -->
  <Border x:Name="Track" Background="{DynamicResource Brush.Bg.Input}"
          BorderBrush="{DynamicResource Brush.Border.Default}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="0">
    <Grid x:Name="HostGrid" SizeChanged="HostGrid_SizeChanged">
      <Border x:Name="Highlight"
              Background="{DynamicResource Brush.Accent.Solid}"
              CornerRadius="4"
              Margin="2"
              HorizontalAlignment="Left"
              IsHitTestVisible="False"
              Visibility="Collapsed">
        <Border.RenderTransform>
          <TranslateTransform x:Name="HighlightTranslate" X="0"/>
        </Border.RenderTransform>
      </Border>
      <ItemsControl x:Name="ItemsHost">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>
