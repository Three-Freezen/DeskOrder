<UserControl x:Class="DesktopZones.Views.Components.PropertyTabGhostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DesktopZones.Views.Components"
             IsHitTestVisible="False" Focusable="False">
  <UserControl.Resources>
    <local:IconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
  </UserControl.Resources>
  <Border x:Name="GhostBorder" Padding="10,3" CornerRadius="4"
          Background="{DynamicResource Brush.Bg.Chrome}"
          BorderBrush="{DynamicResource Brush.Accent}"
          BorderThickness="1" Opacity="0.7">
    <Border.Effect>
      <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="Black" Opacity="0.4"/>
    </Border.Effect>
    <Border.RenderTransform>
      <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
    </Border.RenderTransform>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Path Width="14" Height="14" Margin="0,0,6,0" Stretch="Uniform"
            StrokeThickness="1.5" StrokeLineJoin="Round"
            Stroke="{DynamicResource Brush.Text.Secondary}"
            Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"/>
      <TextBlock VerticalAlignment="Center" FontSize="12"
                 Foreground="{DynamicResource Brush.Text.Primary}"
                 Text="{Binding Title}"/>
    </StackPanel>
  </Border>
</UserControl>
