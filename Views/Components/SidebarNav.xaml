<UserControl x:Class="DesktopZones.Views.Components.SidebarNav"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
             xmlns:local="clr-namespace:DesktopZones.Views.Components"
             Width="216">
  <UserControl.Resources>
    <!-- Base nav item: 32 high, 8px margin, 6px corner radius -->
    <Style x:Key="NavItem" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
              <Grid>
                <!-- ponytail 2026-08-28: 选中态左侧指示条 — 锁死深 accent 蓝 #256FC8,
                     不随管理界面主题(系统/亮/暗)或系统强调色覆盖而变色。 -->
                <Border x:Name="Bar" Width="3" Height="16" HorizontalAlignment="Left"
                        Margin="0" CornerRadius="2"
                        Background="#256FC8"
                        Visibility="Collapsed" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform>
                    <ScaleTransform x:Name="BarScale" ScaleY="0"/>
                  </Border.RenderTransform>
                </Border>
                <ContentPresenter Margin="16,0,12,0" VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Wash}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY"
                                       From="0" To="1" Duration="{StaticResource Motion.Normal}"
                                       EasingFunction="{StaticResource Motion.StandardSpline}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Danger variant: same template, hover foreground goes to Danger -->
    <Style x:Key="NavItemDanger" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
              <Grid>
                <!-- ponytail 2026-08-28: 选中态左侧指示条 — 锁死深 accent 蓝 #256FC8,
                     不随管理界面主题(系统/亮/暗)或系统强调色覆盖而变色。 -->
                <Border x:Name="Bar" Width="3" Height="16" HorizontalAlignment="Left"
                        Margin="0" CornerRadius="2"
                        Background="#256FC8"
                        Visibility="Collapsed" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform>
                    <ScaleTransform x:Name="BarScale" ScaleY="0"/>
                  </Border.RenderTransform>
                </Border>
                <ContentPresenter Margin="16,0,12,0" VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Bg.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Wash}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY"
                                       From="0" To="1" Duration="{StaticResource Motion.Normal}"
                                       EasingFunction="{StaticResource Motion.StandardSpline}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource Brush.Bg.Chrome}"
          BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,1,0">
    <DockPanel>

      <!-- Top: nav content (scrollable) -->
      <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,0">

          <!-- Group: 分区 -->
          <TextBlock Text="{loc:Loc Key=Manage.Zones}" Margin="16,4,16,8" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Text.Tertiary}"/>
          <Button x:Name="NavZones" Style="{StaticResource NavItem}" Tag="zones" Click="NavItem_Click">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Zones}"/>
              <TextBlock Text="{loc:Loc Key=Manage.Zones}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavMerged" Style="{StaticResource NavItem}" Tag="merged" Click="NavItem_Click">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Merged}"/>
              <TextBlock Text="{loc:Loc Key=Sidebar.MergedZones}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavPanel" Style="{StaticResource NavItem}" Tag="panel" Click="NavItem_Click">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Panel}"/>
              <TextBlock Text="{loc:Loc Key=Panel.Title}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Group: 组件 -->
          <TextBlock Text="{loc:Loc Key=Sidebar.Widgets}" Margin="16,16,16,8" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Text.Tertiary}"/>
          <Button x:Name="NavCalendar" Style="{StaticResource NavItem}" Tag="calendar" Click="NavItem_Click">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Calendar}"/>
              <TextBlock Text="{loc:Loc Key=Manage.Calendars}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavClock" Style="{StaticResource NavItem}" Tag="clock" Click="NavItem_Click">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Clock}"/>
              <TextBlock Text="{loc:Loc Key=Manage.Clocks}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavSticky" Style="{StaticResource NavItem}" Tag="sticky" Click="NavItem_Click">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Sticky}"/>
              <TextBlock Text="{loc:Loc Key=Manage.Notes}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Separator above global actions -->
          <Border Height="1" Margin="8,12" Background="{DynamicResource Brush.Border.Subtle}"/>

          <!-- Global actions -->
          <Button x:Name="BtnShowAll" Style="{StaticResource NavItem}" Click="ShowAll_Click">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Eye}"/>
              <TextBlock Text="{loc:Loc Key=Sidebar.ShowAll}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnMinimizeAll" Style="{StaticResource NavItem}" Click="MinimizeAll_Click">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Minimize}"/>
              <TextBlock Text="{loc:Loc Key=Sidebar.MinimizeAll}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnHideAll" Style="{StaticResource NavItemDanger}" Click="HideAll_Click">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.EyeOff}"/>
              <TextBlock Text="{loc:Loc Key=Manage.FullHideAll}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <!-- Separator below global actions -->
          <Border Height="1" Margin="8,12" Background="{DynamicResource Brush.Border.Subtle}"/>

          <!-- Settings / About -->
          <Button x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="settings" Click="NavItem_Click">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Settings}"/>
              <TextBlock Text="{loc:Loc Key=Sidebar.Settings}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="about" Click="NavItem_Click">
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeLineJoin="Round"
                    Data="{StaticResource Icon.About}"/>
              <TextBlock Text="{loc:Loc Key=Sidebar.About}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

        </StackPanel>
      </ScrollViewer>

      <!-- Bottom: version -->
      <Border DockPanel.Dock="Bottom"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
              Padding="16,12">
        <TextBlock Text="v0.9.0" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      </Border>

    </DockPanel>
  </Border>
</UserControl>