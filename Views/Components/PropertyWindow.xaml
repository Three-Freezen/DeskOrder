<Window x:Class="DesktopZones.Views.Components.PropertyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopZones.Views.Components"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="420" MinHeight="480"
        WindowStartupLocation="Manual"
        Opacity="0"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                           Duration="{StaticResource Motion.Normal}"
                           EasingFunction="{StaticResource Motion.StandardSpline}"/>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>
  <Border x:Name="RootBorder"
          Background="{DynamicResource Brush.Bg.Chrome}"
          BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
          CornerRadius="10"
          RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform>
      <ScaleTransform x:Name="RootScale" ScaleX="0.97" ScaleY="0.97"/>
    </Border.RenderTransform>
    <Border.Triggers>
      <EventTrigger RoutedEvent="Border.Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" From="0.97" To="1"
                             Duration="{StaticResource Motion.Normal}"
                             EasingFunction="{StaticResource Motion.StandardSpline}"/>
            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" From="0.97" To="1"
                             Duration="{StaticResource Motion.Normal}"
                             EasingFunction="{StaticResource Motion.StandardSpline}"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Border.Triggers>
    <!-- ponytail 2026-08-25: DropShadowEffect 拆了 — 之前 BlurRadius=24 是软件渲染（CPU 位图卷积），
         在 AllowsTransparency=True 的窗口上每帧都要重栅格化 layered window DIBSection，
         拖动时 WPF 渲染线程和 UI 线程打爆，PropertyWindow 拖动一卡一卡的。
         Win11 DWM 自带的窗口阴影（HWND 层渲染，GPU 加速）取代之；视觉差异几乎不可见。 -->
    <DockPanel>
      <!-- ponytail: top border is the title bar — MouseLeftButtonDown on it
           drives DragMove; double-click toggles maximize. Original code had no
           drag handler, so the floating panel was un-grabbable. -->
      <Border x:Name="TitleBar" DockPanel.Dock="Top"
              Background="{DynamicResource Brush.Bg.Chrome}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1"
              PreviewMouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <controls:PropertyTabStrip x:Name="TabStrip"/>
      </Border>
      <controls:PropertyPanel x:Name="BodyPanel" Margin="0"/>
    </DockPanel>
  </Border>
</Window>
