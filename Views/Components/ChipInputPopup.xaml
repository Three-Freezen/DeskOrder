<Window x:Class="DesktopZones.Views.Components.ChipInputPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" Height="200" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="12"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
            MouseLeftButtonDown="TitleBar_Down">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>

            <!-- Title/content divider (自适应文字色,同液态玻璃二级窗口) -->
            <Border Grid.Row="1" Height="1" Margin="0,0,0,10"
                    Background="{DynamicResource Menu.Separator}"/>

            <TextBox x:Name="InputBox" Grid.Row="2" FontSize="12" Padding="6,4,6,4" Margin="0,0,0,6"/>
            <TextBlock x:Name="ErrorText" Grid.Row="3" FontSize="11"
                       Foreground="{DynamicResource Brush.Danger}" Visibility="Collapsed"
                       Margin="0,0,0,10" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Padding="14,6" Cursor="Hand" FontSize="12"
                        Click="Cancel_Click" IsCancel="True"
                        Style="{DynamicResource OutlineBtn}"/>
                <Button x:Name="OkBtn" Padding="14,6" Margin="8,0,0,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                        Click="Ok_Click" IsDefault="True"
                        Style="{DynamicResource FillBtn}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
