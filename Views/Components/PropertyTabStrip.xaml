<UserControl x:Class="DesktopZones.Views.Components.PropertyTabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
             xmlns:local="clr-namespace:DesktopZones.Views.Components">
  <UserControl.Resources>
    <local:IconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>

    <DataTemplate x:Key="PropertyTabTemplate" DataType="{x:Type local:PropertyTab}">
      <Border x:Name="TabRoot" Padding="10,3" Margin="0,0,1,0"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,1,0"
              Cursor="Hand"
              MouseLeftButtonDown="TabRoot_MouseLeftButtonDown"
              MouseLeftButtonUp="TabRoot_MouseLeftButtonUp"
              PreviewMouseDown="TabRoot_PreviewMouseDown">
        <Border.RenderTransform>
          <TranslateTransform x:Name="TabTransform"/>
        </Border.RenderTransform>
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Base}"/>
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="14" Height="14" Margin="0,0,6,0"
                  Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                  Stroke="{DynamicResource Brush.Text.Secondary}"
                  Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"/>
            <TextBlock VerticalAlignment="Center" FontSize="12"
                       Text="{Binding DisplayTitle}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                  <Setter Property="FontStyle" Value="Normal"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPreview}" Value="True">
                      <Setter Property="FontStyle" Value="Italic"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button Width="14" Height="14" Margin="6,0,0,0" Padding="0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="{loc:Loc Key=Common.Close}"
                    Command="{Binding CloseCommand}">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=TabRoot}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Path Width="10" Height="10" Stretch="Uniform"
                    StrokeThickness="1.5" StrokeLineJoin="Round"
                    Stroke="{DynamicResource Brush.Text.Tertiary}"
                    Data="{StaticResource Icon.Close}"/>
            </Button>
          </StackPanel>

          <Border Grid.Row="1">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                  </DataTrigger>
                  <!-- ponytail: preview tab gets a dashed 1-px tertiary line so it
                       reads as "tentative, not pinned". Pinned+active wins over
                       preview (active=accent solid bar). -->
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsPreview}" Value="True"/>
                      <Condition Binding="{Binding IsActive}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Text.Tertiary}"/>
                    <Setter Property="Opacity" Value="0.5"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
          </Border>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="{DynamicResource Brush.Bg.Base}"
          BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1"
          Padding="0,4">
    <local:PropertyTabScroller x:Name="TabsScroller"
                               Tabs="{Binding Tabs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               ItemTemplate="{StaticResource PropertyTabTemplate}"
                               MinTabWidth="100"/>
  </Border>
</UserControl>
