<UserControl x:Class="DesktopZones.Views.Components.SubfolderPresetPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DesktopZones.ViewModels"
             Width="128" Height="128">
    <Border CornerRadius="{Binding Subfolder.CornerRounded, Converter={x:Static vm:BoolToCornerRadiusConverter.Instance}, FallbackValue=8}"
            Background="#22000000"
            BorderBrush="#60FFFFFF"
            BorderThickness="1">
        <TextBlock Text="{Binding Name}"
                   FontSize="11" Foreground="#E0FFFFFF"
                   TextAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   MaxWidth="100"/>
    </Border>
</UserControl>
