<UserControl x:Class="DesktopZones.Views.Components.PropertyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopZones.Helpers"
             xmlns:local="clr-namespace:DesktopZones.Views.Components">
  <Grid x:Name="RootGrid"
        RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <TranslateTransform x:Name="RootTranslate" X="0"/>
    </Grid.RenderTransform>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Chrome}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1"
            Padding="16,0">
      <Grid>
        <!-- ponytail 2026-08-25: icon + window name header, matching the tab
             strip and the zone editor. Zone previously had no icon here — the
             code-behind assigns Icon.Zones / Icon.Clock / Icon.Calendar /
             Icon.Sticky / Icon.Panel per target and collapses it for the
             NoTarget / NotImplemented placeholders. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Path x:Name="InstanceIcon" Width="14" Height="14" Margin="0,0,8,0"
                Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                Stroke="{DynamicResource Brush.Text.Primary}"
                Data="{StaticResource Icon.Zones}"/>
          <TextBlock x:Name="InstanceNameText"
                     Text="{Binding InstanceName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     FontSize="13" FontWeight="Medium"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="PersistErrorDot" Text="●" Foreground="#FF6666" FontSize="12"
                     VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{loc:Loc Key=PropertyPanel.SaveFailed}"
                     Visibility="Collapsed"/>
          <!-- ponytail: one toggle button that doubles as undock (when docked)
               and dock-back (when floating). IsFloating DP swaps icon + tooltip
               and rotates the icon 360° for a small "flip" feel. -->
          <Button x:Name="ToggleBtn" Width="28" Height="28" Background="Transparent"
                  BorderThickness="0" Cursor="Hand"
                  ToolTip="{loc:Loc Key=Common.Undock}"
                  Click="ToggleBtn_Click">
            <!-- ponytail: ScaleX=-1 is a true horizontal mirror (flips the
                 button over its vertical axis), not a Z-axis spin. Stays at
                 -1 while floating, returns to 1 when docked back. -->
            <Path x:Name="ToggleIcon" Width="14" Height="14"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.5" StrokeLineJoin="Round"
                  RenderTransformOrigin="0.5,0.5"
                  Data="{StaticResource Icon.Undock}">
              <Path.RenderTransform>
                <ScaleTransform x:Name="ToggleIconScale" ScaleX="1" ScaleY="1"/>
              </Path.RenderTransform>
            </Path>
          </Button>
          <Button x:Name="CollapseBtn" Width="28" Height="28" Background="Transparent"
                  BorderThickness="0" Cursor="Hand" ToolTip="{loc:Loc Key=Common.Collapse}"
                  Click="CollapseBtn_Click">
            <Path Width="14" Height="14"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.5" StrokeLineJoin="Round"
                  Data="{StaticResource Icon.ChevronLeft}"/>
          </Button>
          <!-- ponytail: explicit X to close the currently active tab. Host
               (ManagementWindow or floating PropertyWindow) wires the click
               to its PropertyTabStrip.CloseActiveTab(). Hidden when no active
               tab (host sets the visibility via the property). -->
          <Button x:Name="CloseTabBtn" Width="28" Height="28" Background="Transparent"
                  BorderThickness="0" Cursor="Hand"
                  ToolTip="{loc:Loc Key=Common.Close}"
                  Visibility="Collapsed"
                  Click="CloseTabBtn_Click">
            <Path Width="14" Height="14"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.5" StrokeLineJoin="Round"
                  Data="{StaticResource Icon.Close}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 状态区 — 原「边框+横杠」占位。改为实时状态条：显示/锁定滑动开关、
         删除分区按钮、状态 chips（文件夹映射/监听中/组合分区中）、面板与便签的
         快捷键设置。内容由 code-behind 按当前 Target 动态构建（BuildStatusArea），
         随 ZonesChanged / NotesChanged / ClocksChanged / CalendarsChanged 实时刷新。 -->
    <Border x:Name="StatusArea" Grid.Row="1" Margin="16,12,16,12" CornerRadius="6"
            Background="{DynamicResource Brush.Bg.Base}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
            Visibility="Collapsed">
      <StackPanel x:Name="StatusHost" Margin="12,12"/>
    </Border>

    <ScrollViewer x:Name="FieldScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0">
      <TextBlock Margin="16" Text="{loc:Loc Key=PropertyPanel.NoTarget}"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
    </ScrollViewer>

    <Border Grid.Row="3" Background="{DynamicResource Brush.Bg.Chrome}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
            Padding="12,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <!-- ponytail 2026-08-25: 前 3 个描边按钮 — Border + Foreground 跟主题。
             Border.Default 在 system 模式下被 ThemeService 改写，描边跟随；Text.Secondary 同理。
             IsEnabled=False 时 WPF 默认把 Foreground 改成 Brush.Text.Disabled（已在 ThemeService 重算）。-->
        <Button x:Name="LoadPresetBtn" Content="{loc:Loc Key=PropertyPanel.Btn.LoadPreset}" Cursor="Hand"
                Background="Transparent" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Padding="12,6" Click="LoadPresetBtn_Click" IsEnabled="False"
                ToolTip="{loc:Loc Key=PropertyPanel.Btn.LoadPreset}">
          <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
        </Button>
        <Button x:Name="SavePresetBtn" Content="{loc:Loc Key=PropertyPanel.Btn.SavePreset}" Cursor="Hand"
                Background="Transparent" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Padding="12,6" Margin="6,0,0,0" Click="SavePresetBtn_Click" IsEnabled="False"
                ToolTip="{loc:Loc Key=PropertyPanel.Btn.SavePreset}">
          <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
        </Button>
        <Button x:Name="CancelBtn" Content="{loc:Loc Key=PropertyPanel.Btn.Cancel}" Cursor="Hand"
                Background="Transparent" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                Foreground="{DynamicResource Brush.Text.Secondary}"
                Padding="12,6" Margin="6,0,0,0" Click="CancelBtn_Click" IsEnabled="False"
                ToolTip="{loc:Loc Key=PropertyPanel.Btn.Cancel}">
          <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
        </Button>
        <!-- ponytail 2026-08-25: Apply 是填充按钮 — 用 Brush.Accent.Solid + Brush.Accent.On 镂空主题色。
             不绑 .Disabled brush（用户要求：填充按钮不需要颜色自适应模块）。
             禁用态保持 Solid+On 不变（WPF 自动调低文字前景到 Brush.Text.Disabled 不影响填充）。-->
        <Button x:Name="ApplyBtn" Content="{loc:Loc Key=PropertyPanel.Btn.Apply}" Cursor="Hand"
                Background="{DynamicResource Brush.Accent.Solid}" Foreground="{DynamicResource Brush.Accent.On}"
                BorderThickness="0" Padding="12,6" Margin="6,0,0,0" Click="ApplyBtn_Click" IsEnabled="False"
                ToolTip="{loc:Loc Key=PropertyPanel.Btn.Apply}">
          <Button.Resources>
            <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
          </Button.Resources>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>