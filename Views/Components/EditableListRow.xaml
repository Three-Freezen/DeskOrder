<UserControl x:Class="DesktopZones.Views.Components.EditableListRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
             xmlns:local="clr-namespace:DesktopZones.Views.Components">
  <UserControl.Resources>
    <local:IconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
    <local:StringNotEmptyToVisibilityConverter x:Key="StrToVis"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <Storyboard x:Key="PressDown">
      <DoubleAnimation Storyboard.TargetName="PressScale"
                       Storyboard.TargetProperty="ScaleX"
                       To="0.98" Duration="{StaticResource Motion.Fast}"
                       EasingFunction="{StaticResource Motion.StandardSpline}"/>
      <DoubleAnimation Storyboard.TargetName="PressScale"
                       Storyboard.TargetProperty="ScaleY"
                       To="0.98" Duration="{StaticResource Motion.Fast}"
                       EasingFunction="{StaticResource Motion.StandardSpline}"/>
    </Storyboard>
    <Storyboard x:Key="PressUp">
      <DoubleAnimation Storyboard.TargetName="PressScale"
                       Storyboard.TargetProperty="ScaleX"
                       To="1" Duration="{StaticResource Motion.Fast}"
                       EasingFunction="{StaticResource Motion.StandardSpline}"/>
      <DoubleAnimation Storyboard.TargetName="PressScale"
                       Storyboard.TargetProperty="ScaleY"
                       To="1" Duration="{StaticResource Motion.Fast}"
                       EasingFunction="{StaticResource Motion.StandardSpline}"/>
    </Storyboard>
  </UserControl.Resources>
  <Border x:Name="Root"
          Background="{DynamicResource Brush.Bg.Surface}"
          BorderBrush="{DynamicResource Brush.Border.Subtle}"
          BorderThickness="3"
          CornerRadius="6"
          Padding="12,8"
          Margin="0,0,0,6"
          Cursor="Hand"
          RenderTransformOrigin="0.5,0.5">
    <!-- ponytail 2026-08-25: 删了 Border.Loaded 的 fade+slide 入场动画。
         之前每次 RefreshList() 重建 ListHost.ItemsSource（每改一项属性 → ZoneManager
         .ZonesChanged → RefreshList），每个新 EditableListRow 都触发 Border.Loaded 一次，
         Motion.Normal 段全部行同步淡入 + 下滑，看起来"动画一直跳"。
         选中和按压动画（PreviewMouseLeftButtonDown/Up/MouseLeave）保留 — 它们跟着用户
         操作，不受 Rebuild 影响。-->
    <Border.RenderTransform>
      <!-- ponytail 2026-08-25: DragTranslate lets the row's host (or the row itself during
           a self-drag) shift the row up/down without affecting layout. Used by the long-press
           drag-to-reorder loop to (a) let the dragged row follow the cursor and (b) animate
           sibling rows sliding into the freed slot. The XAML-level name exposes it to code. -->
      <TransformGroup>
        <TranslateTransform x:Name="DragTranslate" Y="0"/>
        <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
      </TransformGroup>
    </Border.RenderTransform>
    <Border.Triggers>
      <EventTrigger RoutedEvent="Border.PreviewMouseLeftButtonDown">
        <BeginStoryboard Storyboard="{StaticResource PressDown}"
                         HandoffBehavior="SnapshotAndReplace"/>
      </EventTrigger>
      <EventTrigger RoutedEvent="Border.PreviewMouseLeftButtonUp">
        <BeginStoryboard Storyboard="{StaticResource PressUp}"
                         HandoffBehavior="SnapshotAndReplace"/>
      </EventTrigger>
      <EventTrigger RoutedEvent="Border.MouseLeave">
        <BeginStoryboard Storyboard="{StaticResource PressUp}"
                         HandoffBehavior="SnapshotAndReplace"/>
      </EventTrigger>
    </Border.Triggers>
    <Border.Style>
      <Style TargetType="Border">
        <Style.Triggers>
          <!-- IsMouseOver trigger first; IsSelected below wins when both fire. -->
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}"/>
          </Trigger>
          <!-- ponytail 2026-08-25: 选中态 = Brush.Accent.Wash 背景（保持原 Wash）+ Brush.Accent.Solid 边框（深 accent）-->
          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Value="True">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Wash}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Solid}"/>
            <Setter Property="Effect">
              <Setter.Value>
                <DropShadowEffect Color="{DynamicResource Color.Accent.Solid}"
                                  BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
              </Setter.Value>
            </Setter>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <!-- ponytail 2026-08-25: 选中态左侧指示条 = Brush.Accent.Solid（深 accent 填充）-->
      <Border x:Name="SelectionBar" Width="2" HorizontalAlignment="Left"
              Background="{DynamicResource Brush.Accent.Solid}"
              VerticalAlignment="Stretch" Visibility="Collapsed"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <ScaleTransform x:Name="SelectionScale" ScaleY="0"/>
        </Border.RenderTransform>
        <Border.Style>
          <Style TargetType="Border">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

      <!-- Icon slot: show Path when IconKey set, TextBlock when IconText (emoji) set -->
      <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
              Background="{DynamicResource Brush.Accent.Wash}"
              VerticalAlignment="Center" Margin="0,0,12,0">
        <Grid>
          <Path Width="16" Height="16"
                Stroke="{DynamicResource Brush.Accent}"
                StrokeThickness="1.5" StrokeLineJoin="Round"
                Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="{Binding IconKey, RelativeSource={RelativeSource AncestorType=UserControl},
                               Converter={StaticResource IconKeyToGeometry}}"
                Visibility="{Binding IconKey, RelativeSource={RelativeSource AncestorType=UserControl},
                             Converter={StaticResource StrToVis}}"/>
          <TextBlock FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     Text="{Binding IconText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Visibility="{Binding IconText, RelativeSource={RelativeSource AncestorType=UserControl},
                                  Converter={StaticResource StrToVis}}"/>
        </Grid>
      </Border>

      <!-- Title stack + optional status badge chip -->
      <Grid Grid.Column="1" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="TitleStack" Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="13" FontWeight="Medium"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     MouseLeftButtonDown="TitleText_DoubleClick"/>
          <TextBlock x:Name="SubText" FontSize="11" Margin="0,2,0,0"
                     FontFamily="Cascadia Code, Consolas, monospace"
                     Foreground="{DynamicResource Brush.Text.Secondary}"
                     Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>
        <Border Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                CornerRadius="10" Padding="8,2" BorderThickness="0"
                Background="{Binding StatusBadgeBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Visibility="{Binding HasStatusBadge, RelativeSource={RelativeSource AncestorType=UserControl},
                             Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock FontSize="10" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Text.Primary}"
                     Text="{Binding StatusBadge, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Border>
      </Grid>

      <StackPanel x:Name="Ops" Grid.Column="2" Orientation="Horizontal"
                  Visibility="Collapsed" VerticalAlignment="Center">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                           Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <Button Width="24" Height="24" Margin="2,0" Cursor="Hand" Click="LockBtn_Click"
                Background="Transparent" BorderThickness="0" ToolTip="{loc:Loc Key=Common.Lock}">
          <Path Width="14" Height="14" StrokeThickness="1.5"
                Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeLineJoin="Round"
                Data="{StaticResource Icon.Lock}"/>
        </Button>
        <Button Width="24" Height="24" Margin="2,0" Cursor="Hand" Click="EyeBtn_Click"
                Background="Transparent" BorderThickness="0" ToolTip="{loc:Loc Key=ToolTip.Show}">
          <Path Width="14" Height="14" StrokeThickness="1.5"
                Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeLineJoin="Round"
                Data="{StaticResource Icon.Eye}"/>
        </Button>
        <Button Width="24" Height="24" Margin="2,0" Cursor="Hand" Click="TrashBtn_Click"
                Background="Transparent" BorderThickness="0" ToolTip="{loc:Loc Key=Manage.DeleteBtn}">
          <Path Width="14" Height="14" StrokeThickness="1.5"
                Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeLineJoin="Round"
                Data="{StaticResource Icon.Trash}"/>
        </Button>
      </StackPanel>
    </Grid>
    </Grid>
  </Border>
</UserControl>
