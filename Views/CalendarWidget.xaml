<Window x:Class="DesktopZones.Views.CalendarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        Width="300" Height="490">

    <Grid>
        <Border x:Name="MainContent" Visibility="Visible" ClipToBounds="True" CornerRadius="10">
        <Grid>
        <Border x:Name="CalendarBorder" CornerRadius="10"
                Background="Transparent" BorderBrush="#30FFFFFF"
                BorderThickness="1">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="CtxToggleRestore" Header="Disable Restore" Click="ToggleRestore_Click"/>
                    <Separator/>
                    <MenuItem x:Name="CtxDelete" Header="Delete Calendar" Click="DeleteCalendar_Click" Foreground="#FF6666"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <!-- ponytail: separate Rectangle for fill color (mirrors ZoneWindow's FillRect).
                     Setting Border.Background inside a transparent window does not reliably
                     re-render when reassigned; a dedicated Rectangle child does. -->
                <Rectangle x:Name="FillRect" RadiusX="10" RadiusY="10"
                           Fill="#F0151530" IsHitTestVisible="False"/>
                <Grid>
                <!-- Background image -->
                <Border x:Name="CalBgBorder" ClipToBounds="True" IsHitTestVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Image x:Name="CalBgImage" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Opacity="0" IsHitTestVisible="False"/>
                </Border>
                <!-- Hide button overlaying top-right -->
                <Button x:Name="HideBtn" Content="─" Width="20" Height="20"
                        FontSize="10" Foreground="#40FFFFFF"
                        Background="#10FFFFFF" BorderThickness="0"
                        Cursor="Hand" Click="HideBtn_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,4,6,0" Panel.ZIndex="1">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <!-- Lock button (top-left, symmetric with HideBtn top-right) -->
                <Button x:Name="LockBtn" Content="🔓" Width="20" Height="20"
                        FontSize="10" Foreground="#40FFFFFF"
                        Background="#10FFFFFF" BorderThickness="0"
                        Cursor="Hand" Click="LockBtn_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="6,4,0,0" Panel.ZIndex="2">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- ponytail: fixed date row height (6 × 40px) so all months lay out
                         identically regardless of widget size. Old Auto let dates stretch
                         into the available height, making some widgets feel cramped. -->
                    <RowDefinition Height="240"/>
                    <!-- ponytail: notes row pinned to 120px to match NotesPanel MaxHeight.
                         Old * let the notes panel grow/shrink with widget height, causing
                         the panel to sit at inconsistent y positions across calendars. -->
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <!-- Month/Year header + nav -->
                <Grid Grid.Row="0" Margin="0,0,0,4"
                      MouseLeftButtonDown="Window_Drag">
                    <Button x:Name="PrevMonthBtn" Content="&#x25C0;" Width="24" Height="24" FontSize="10"
                            Foreground="#AAFFFFFF" Background="Transparent"
                            BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Left" Margin="14,0,0,0"
                            Click="PrevMonth_Click"/>
                    <TextBlock x:Name="MonthTitleText" Text="2026年6月"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#EEFFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button x:Name="NextMonthBtn" Content="&#x25B6;" Width="24" Height="24" FontSize="10"
                            Foreground="#AAFFFFFF" Background="Transparent"
                            BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Right" Margin="0,0,14,0"
                            Click="NextMonth_Click"/>
                </Grid>

                <!-- Today button -->
                <Button Grid.Row="1" x:Name="TodayBtn" Content="Today"
                        FontSize="10" Foreground="#6C63FF" Background="Transparent"
                        BorderBrush="#406C63FF" BorderThickness="1"
                        Padding="8,3" Cursor="Hand"
                        HorizontalAlignment="Center" Margin="0,0,0,4"
                        Click="Today_Click"/>

                <!-- Day-of-week headers -->
                <UniformGrid Grid.Row="2" Columns="7" Margin="0,0,0,2">
                    <TextBlock x:Name="Dow0" Text="一" TextAlignment="Center"
                               FontSize="10" Foreground="#8080A0"/>
                    <TextBlock x:Name="Dow1" Text="二" TextAlignment="Center"
                               FontSize="10" Foreground="#8080A0"/>
                    <TextBlock x:Name="Dow2" Text="三" TextAlignment="Center"
                               FontSize="10" Foreground="#8080A0"/>
                    <TextBlock x:Name="Dow3" Text="四" TextAlignment="Center"
                               FontSize="10" Foreground="#8080A0"/>
                    <TextBlock x:Name="Dow4" Text="五" TextAlignment="Center"
                               FontSize="10" Foreground="#8080A0"/>
                    <TextBlock x:Name="Dow5" Text="六" TextAlignment="Center"
                               FontSize="10" Foreground="#8080A0"/>
                    <TextBlock x:Name="Dow6" Text="日" TextAlignment="Center"
                               FontSize="10" Foreground="#8080A0"/>
                </UniformGrid>

                <!-- Day cells grid -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CellBorder"
                                    CornerRadius="4" Margin="2"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="DayCell_Click"
                                    Tag="{Binding DateKey}"
                                    Background="Transparent">
                                <Grid>
                                    <!-- Today highlight (rounded square, was Ellipse circle) -->
                                    <Border x:Name="TodayCircle" Width="26" Height="26"
                                            CornerRadius="4" Background="#306C63FF" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DayNumber}"
                                                   FontSize="12" Foreground="#CCFFFFFF"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                        <!-- Note indicator dot -->
                                        <Ellipse Width="4" Height="4" Margin="0,1,0,0"
                                                 HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasNotes}" Value="True">
                                                            <Setter Property="Fill" Value="#408080A0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NotePriority}" Value="1">
                                                            <Setter Property="Fill" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NotePriority}" Value="2">
                                                            <Setter Property="Fill" Value="#FFC107"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NotePriority}" Value="3">
                                                            <Setter Property="Fill" Value="#FF5252"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasNotes}" Value="False">
                                                            <Setter Property="Fill" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="TodayCircle" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InMonth}" Value="False">
                                    <Setter TargetName="CellBorder" Property="Opacity" Value="0.25"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Notes panel for selected date -->
                <Border Grid.Row="4" x:Name="NotesPanel"
                        Background="#15FFFFFF" CornerRadius="6"
                        Margin="0,4,0,0" Padding="6" MaxHeight="120">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock x:Name="NotesDateLabel" Text="备注"
                                       FontSize="11" Foreground="#AAA0C0"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="AddNoteBtn" Content="+" Width="20" Height="20"
                                    FontSize="12" Foreground="#6C63FF"
                                    Background="#20FFFFFF" BorderThickness="0"
                                    Cursor="Hand" Margin="6,0,0,0"
                                    Click="AddNote_Click"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="90">
                            <ItemsControl ItemsSource="{Binding SelectedNotes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1" ColumnDefinitions="Auto,*,Auto"
                                              MouseLeftButtonDown="NoteItem_Click"
                                              Background="Transparent" Cursor="Hand">
                                            <!-- Checkbox -->
                                            <Border Grid.Column="0" Width="14" Height="14" CornerRadius="3"
                                                    BorderBrush="#50FFFFFF" BorderThickness="1"
                                                    Background="Transparent" Cursor="Hand"
                                                    VerticalAlignment="Center" Margin="1,0"
                                                    MouseLeftButtonDown="NoteCheck_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Background" Value="#306C63FF"/>
                                                                <Setter Property="BorderBrush" Value="#806C63FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="✓" FontSize="10"
                                                           Foreground="#6C63FF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Content with ellipsis -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Content}"
                                                       FontSize="11" Foreground="#D0D0E0"
                                                       VerticalAlignment="Center" Margin="4,0,4,0"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                            <!-- Delete button -->
                                            <Button Grid.Column="2" Content="X" Width="16" Height="16"
                                                    FontSize="9" Foreground="#80666688"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="DeleteNote_Click"
                                                    Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Four corner resize grips -->
        <Border x:Name="GripTL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="SizeNWSE" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="TL"/>
            <Border x:Name="GripTR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Cursor="SizeNESW" Background="Transparent"
                    MouseLeftButtonDown="ResizeGrip_Down" Tag="TR"/>
            <Border x:Name="GripBL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Cursor="SizeNESW" Background="Transparent"
                    MouseLeftButtonDown="ResizeGrip_Down" Tag="BL"/>
            <Border x:Name="GripBR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Cursor="SizeNWSE" Background="Transparent"
                    MouseLeftButtonDown="ResizeGrip_Down" Tag="BR"/>
            </Grid>
        </Border>

        <!-- Restore button (minimized state) -->

        <Border x:Name="RestoreButton"
                Visibility="Collapsed"
                Width="36" Height="36"
                CornerRadius="18"
                Background="#DD1A1A2E"
                BorderBrush="#60FFFFFF"
                BorderThickness="1"
                Cursor="Hand"
                MouseLeftButtonDown="Restore_MouseDown"
                MouseMove="Restore_MouseMove"
                MouseLeftButtonUp="Restore_MouseUp"
                MouseEnter="Restore_Enter" MouseLeave="Restore_Leave">
            <TextBlock x:Name="RestoreIconChar" Text="📅"
                       FontSize="18" Foreground="#C0FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
