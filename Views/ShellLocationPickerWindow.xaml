<Window x:Class="DesktopZones.Views.ShellLocationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Title="{loc:Loc Key=ShellPicker.Title}" Width="430" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="10"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleLabel" Text="Import System Items" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,10"/>
            <Border Grid.Row="1" Background="{DynamicResource Brush.Bg.Input}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="330" Padding="10,6">
                    <StackPanel x:Name="ListPanel"/>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="CustomHintLabel" Text="Custom shell location:" FontSize="11"
                           Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="SpecInput" Background="{DynamicResource Brush.Bg.Input}"
                         Foreground="{DynamicResource Brush.Text.Primary}"
                         BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                         Padding="8,6" FontSize="12" KeyDown="NameInput_KeyDown"/>
                <TextBlock x:Name="CustomNameLabel" Text="Display name (optional):" FontSize="11"
                           Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,6,0,4"/>
                <DockPanel>
                    <Button x:Name="AddBtn" Content="+" DockPanel.Dock="Right"
                            Background="{DynamicResource Brush.Accent.Solid}" Foreground="{DynamicResource Brush.Accent.On}"
                            BorderThickness="0" Padding="12,6" Margin="8,0,0,0" Cursor="Hand" Click="AddCustom_Click">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                    <TextBox x:Name="NameInput" Background="{DynamicResource Brush.Bg.Input}"
                             Foreground="{DynamicResource Brush.Text.Primary}"
                             BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                             Padding="8,6" FontSize="12" KeyDown="NameInput_KeyDown"/>
                </DockPanel>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelBtn" Content="Cancel"
                        Background="Transparent" Foreground="{DynamicResource Brush.Text.Secondary}"
                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                        Padding="14,6" Cursor="Hand" Click="Cancel_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
                <Button x:Name="OkBtn" Content="Import"
                        Background="{DynamicResource Brush.Accent.Solid}" Foreground="{DynamicResource Brush.Accent.On}"
                        BorderThickness="0" Padding="14,6" Margin="8,0,0,0"
                        Cursor="Hand" Click="Ok_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
