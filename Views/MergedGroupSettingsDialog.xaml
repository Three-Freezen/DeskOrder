<Window x:Class="DesktopZones.Views.MergedGroupSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merged Group Settings" Width="480" Height="760"
        MinWidth="440" MinHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#E610111A"/>
        <SolidColorBrush x:Key="Acc" Color="#7C3AED"/>
        <SolidColorBrush x:Key="T1" Color="#E8E8F0"/>
        <SolidColorBrush x:Key="T2" Color="#8888A0"/>
        <SolidColorBrush x:Key="T3" Color="#606080"/>
        <SolidColorBrush x:Key="IBg" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="IBd" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#10FFFFFF"/>

        <Style x:Key="DTb" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource IBg}"/>
            <Setter Property="Foreground" Value="{StaticResource T1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource IBd}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="DLb" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource T2}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Dark ComboBox -->
        <ControlTemplate x:Key="DarkComboTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                    Background="{StaticResource IBg}" BorderBrush="{StaticResource IBd}"
                    BorderThickness="1" Foreground="{StaticResource T1}"
                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                    ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="6,4">
                                <Grid>
                                    <Path x:Name="Arrow" Data="M0,0L4,4L8,0" Fill="{StaticResource T2}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}"
                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,4,20,4"
                    VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                    AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Border x:Name="DropDownBorder" Background="{StaticResource IBg}"
                            BorderBrush="{StaticResource IBd}" BorderThickness="1" CornerRadius="4"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}">
                        <ScrollViewer><ItemsPresenter/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboTemplate}"/>
            <Setter Property="Background" Value="{StaticResource IBg}"/>
            <Setter Property="Foreground" Value="{StaticResource T1}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource IBg}"/>
            <Setter Property="Foreground" Value="{StaticResource T1}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" CornerRadius="12" BorderBrush="#15FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#AA000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="DialogTitle" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource T1}" Margin="0,4,0,8"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- 1. Name -->
                    <TextBlock x:Name="LabelName" Style="{StaticResource DLb}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource DTb}"/>

                    <!-- 1b. QuickBar Mode -->
                    <CheckBox x:Name="QuickBarModeToggle" Foreground="{StaticResource T1}" FontSize="13" Margin="0,8,0,0">
                        <TextBlock x:Name="LabelQuickBarMode"/>
                    </CheckBox>

                    <!-- 2. Zone Name Color -->
                    <TextBlock x:Name="LabelTextColor" Style="{StaticResource DLb}"/>
                    <StackPanel x:Name="TextColorPresets" Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#00000000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TextColorPreset_Click" ToolTip="Transparent"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#CCCCCC" Offset="0.5"/><GradientStop Color="#FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#A0000000" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="TextColorPreset_Click"><Border.Background><SolidColorBrush Color="#000000"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#A0FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="TextColorPreset_Click"><Border.Background><SolidColorBrush Color="#FFFFFF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#A0808080" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TextColorPreset_Click"><Border.Background><SolidColorBrush Color="#808080"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#A0FF0000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TextColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF0000"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#A0FF7D00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TextColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF7D00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#A0FFFF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TextColorPreset_Click"><Border.Background><SolidColorBrush Color="#FFFF00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#A000FF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TextColorPreset_Click"><Border.Background><SolidColorBrush Color="#00FF00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#A00000FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TextColorPreset_Click"><Border.Background><SolidColorBrush Color="#0000FF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#A000FFFF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TextColorPreset_Click"><Border.Background><SolidColorBrush Color="#00FFFF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#A0FF00FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TextColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF00FF"/></Border.Background></Border>
                        <Button x:Name="TextColorCustomBtn" Content="..." Width="32" Height="28" Background="{StaticResource IBg}" Foreground="{StaticResource T2}" BorderBrush="{StaticResource IBd}" BorderThickness="1" Cursor="Hand" FontSize="10" Click="TextColorCustom_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
                    </StackPanel>

                    <!-- 3. Icon -->
                    <TextBlock x:Name="LabelIcon" Style="{StaticResource DLb}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource IBg}" BorderBrush="{StaticResource IBd}" BorderThickness="1">
                            <TextBlock x:Name="IconPreview" Text="&#x229E;" FontSize="18" Foreground="{StaticResource T1}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBox x:Name="IconCharBox" Style="{StaticResource DTb}" MaxLength="2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="&#x1F4C1;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F4C1;"/>
                                <Button Content="&#x1F3AE;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F3AE;"/>
                                <Button Content="&#x1F4BB;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F4BB;"/>
                                <Button Content="&#x1F3B5;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F3B5;"/>
                                <Button Content="&#x1F4DD;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F4DD;"/>
                                <Button Content="&#x1F310;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F310;"/>
                                <Button Content="&#x26A1;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x26A1;"/>
                                <Button Content="&#x2764;&#xFE0F;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x2764;&#xFE0F;"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Button Content="&#x2B50;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x2B50;"/>
                                <Button Content="&#x1F525;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F525;"/>
                                <Button Content="&#x1F4A1;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F4A1;"/>
                                <Button Content="&#x1F4DA;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F4DA;"/>
                                <Button Content="&#x1F3AF;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F3AF;"/>
                                <Button Content="&#x1F527;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F527;"/>
                                <Button Content="&#x1F3E0;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F3E0;"/>
                                <Button Content="&#x1F3A8;" Width="26" Height="22" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White" Click="IconPreset_Click" Tag="&#x1F3A8;"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 4. Icon Color -->
                    <TextBlock x:Name="LabelIconColor" Style="{StaticResource DLb}"/>
                    <StackPanel x:Name="IconColorPresets" Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#00000000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="IconColorPreset_Click" ToolTip="Transparent"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#CCCCCC" Offset="0.5"/><GradientStop Color="#FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#000000" Background="#000000" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="IconColorPreset_Click"/>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#FFFFFF" Background="#FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="IconColorPreset_Click"/>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#808080" Background="#808080" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="IconColorPreset_Click"/>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#FF0000" Background="#FF0000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="IconColorPreset_Click"/>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#FF7D00" Background="#FF7D00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="IconColorPreset_Click"/>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#FFFF00" Background="#FFFF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="IconColorPreset_Click"/>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#00FF00" Background="#00FF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="IconColorPreset_Click"/>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#0000FF" Background="#0000FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="IconColorPreset_Click"/>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#00FFFF" Background="#00FFFF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="IconColorPreset_Click"/>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#FF00FF" Background="#FF00FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="IconColorPreset_Click"/>
                        <Button x:Name="IconColorCustomBtn" Content="..." Width="32" Height="28" Background="{StaticResource IBg}" Foreground="{StaticResource T2}" BorderBrush="{StaticResource IBd}" BorderThickness="1" Cursor="Hand" FontSize="10" Click="IconColorCustom_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
                    </StackPanel>

                    <!-- 5. Border Thickness -->
                    <TextBlock x:Name="LabelBorderThickness" Style="{StaticResource DLb}"/>
                    <TextBox x:Name="BorderThicknessBox" Style="{StaticResource DTb}"/>

                    <!-- 6. Border Color -->
                    <TextBlock x:Name="LabelBorderColor" Style="{StaticResource DLb}"/>
                    <StackPanel x:Name="BorderColorPresets" Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#00000000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click" ToolTip="Transparent"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#CCCCCC" Offset="0.5"/><GradientStop Color="#FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60000000" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#000000"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#FFFFFF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60808080" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#808080"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF0000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF0000"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF7D00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF7D00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FFFF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#FFFF00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#6000FF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#00FF00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#600000FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#0000FF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#6000FFFF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#00FFFF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF00FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF00FF"/></Border.Background></Border>
                        <Button x:Name="BorderCustomBtn" Content="..." Width="32" Height="28" Background="{StaticResource IBg}" Foreground="{StaticResource T2}" BorderBrush="{StaticResource IBd}" BorderThickness="1" Cursor="Hand" FontSize="10" Click="BorderCustom_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
                    </StackPanel>

                    <!-- 7. Title Bar Fill -->
                    <TextBlock x:Name="LabelTitleBar" Style="{StaticResource DLb}"/>
                    <StackPanel x:Name="TitleBarPresets" Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#00000000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarColorPreset_Click" ToolTip="Transparent"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#CCCCCC" Offset="0.5"/><GradientStop Color="#FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60000000" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarColorPreset_Click"><Border.Background><SolidColorBrush Color="#000000"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarColorPreset_Click"><Border.Background><SolidColorBrush Color="#FFFFFF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60808080" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarColorPreset_Click"><Border.Background><SolidColorBrush Color="#808080"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF0000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF0000"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF7D00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF7D00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FFFF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarColorPreset_Click"><Border.Background><SolidColorBrush Color="#FFFF00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#6000FF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarColorPreset_Click"><Border.Background><SolidColorBrush Color="#00FF00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#600000FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarColorPreset_Click"><Border.Background><SolidColorBrush Color="#0000FF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#6000FFFF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarColorPreset_Click"><Border.Background><SolidColorBrush Color="#00FFFF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF00FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF00FF"/></Border.Background></Border>
                        <Button x:Name="TitleCustomBtn" Content="..." Width="32" Height="28" Background="{StaticResource IBg}" Foreground="{StaticResource T2}" BorderBrush="{StaticResource IBd}" BorderThickness="1" Cursor="Hand" FontSize="10" Click="TitleCustom_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
                    </StackPanel>

                    <!-- Title bar opacity -->
                    <TextBlock x:Name="LabelTitleOpacity" Style="{StaticResource DLb}"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Slider x:Name="TitleOpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" Background="Transparent" Cursor="Hand"/>
                        <TextBlock x:Name="TitleOpacityValue" Grid.Column="1" Foreground="{StaticResource T2}" FontSize="11" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>

                    <!-- Button opacity -->
                    <TextBlock x:Name="LabelCtrlOpacity" Style="{StaticResource DLb}"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Slider x:Name="CtrlOpacitySlider" Minimum="5" Maximum="100" TickFrequency="5" Background="Transparent" Cursor="Hand"/>
                        <TextBlock x:Name="CtrlOpacityValue" Grid.Column="1" Foreground="{StaticResource T2}" FontSize="11" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>

                    <!-- 8. Fill Color -->
                    <TextBlock x:Name="LabelFillColor" Style="{StaticResource DLb}"/>
                    <StackPanel x:Name="FillColorPresets" Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#00000000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click" ToolTip="Transparent"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#CCCCCC" Offset="0.5"/><GradientStop Color="#FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60000000" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#000000"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#FFFFFF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60808080" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#808080"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF0000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF0000"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF7D00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF7D00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FFFF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#FFFF00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#6000FF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#00FF00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#600000FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#0000FF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#6000FFFF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#00FFFF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF00FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF00FF"/></Border.Background></Border>
                        <Button x:Name="FillCustomBtn" Content="..." Width="32" Height="28" Background="{StaticResource IBg}" Foreground="{StaticResource T2}" BorderBrush="{StaticResource IBd}" BorderThickness="1" Cursor="Hand" FontSize="10" Click="FillCustom_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
                    </StackPanel>

                    <!-- Fill opacity -->
                    <TextBlock x:Name="LabelOpacity" Style="{StaticResource DLb}"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Slider x:Name="FillOpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" Background="Transparent" Cursor="Hand"/>
                        <TextBlock x:Name="FillOpacityValue" Grid.Column="1" Foreground="{StaticResource T2}" FontSize="11" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>

                    <!-- Fill mode: unified / keep original -->
                    <TextBlock x:Name="LabelFillMode" Style="{StaticResource DLb}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <RadioButton x:Name="UnifiedFillRadio" Foreground="{StaticResource T1}" FontSize="12" Margin="0,0,16,0" GroupName="FillMode"/>
                        <RadioButton x:Name="KeepOriginalRadio" Foreground="{StaticResource T1}" FontSize="12" GroupName="FillMode"/>
                    </StackPanel>

                    <!-- ══ Glass Preset Section ══ -->
                    <Border Background="#08FFFFFF" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="GlassSectionTitle" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource T1}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="LabelGlassIntensity" Style="{StaticResource DLb}" Margin="0,0,0,4"/>
                            <StackPanel x:Name="GlassIntensityPanel">
                                <Button x:Name="LiquidGlassSettingsBtn" Width="200" Height="34" FontSize="12" FontWeight="SemiBold"
                                        Cursor="Hand" Margin="0,0,0,4"
                                        Background="#7C3AED" Foreground="White"
                                        BorderThickness="1" BorderBrush="#807C3AED">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Background image -->
                    <TextBlock x:Name="LabelBgImage" Style="{StaticResource DLb}"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="BgImagePathBox" Style="{StaticResource DTb}" IsReadOnly="True"/>
                        <Button Grid.Column="1" x:Name="CropBtn" Content="&#x2702;" Width="28" Background="{StaticResource Acc}" Foreground="White" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand" FontSize="12" IsEnabled="False"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources></Button>
                        <Button Grid.Column="2" x:Name="BrowseBgBtn" Content="..." Width="32" Background="{StaticResource Acc}" Foreground="White" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand" FontSize="12"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources></Button>
                    </Grid>
                    <Button x:Name="ClearBgBtn" Background="Transparent" Foreground="#FF6666" BorderThickness="0" Cursor="Hand" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0"/>

                    <!-- Bg stretch -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelBgStretch" VerticalAlignment="Center" Foreground="{StaticResource T2}" FontSize="11" Width="60"/>
                        <ComboBox Grid.Column="1" x:Name="BgStretchCombo" Style="{StaticResource DarkCombo}" Margin="6,0,0,0">
                            <ComboBoxItem x:Name="CropFill" Content="Fill" Tag="Fill" Foreground="{StaticResource T1}" Background="{StaticResource IBg}"/>
                            <ComboBoxItem x:Name="CropUniform" Content="Uniform" Tag="Uniform" Foreground="{StaticResource T1}" Background="{StaticResource IBg}"/>
                            <ComboBoxItem x:Name="CropUniformToFill" Content="UniformToFill" Tag="UniformToFill" Foreground="{StaticResource T1}" Background="{StaticResource IBg}"/>
                            <ComboBoxItem x:Name="CropNone" Content="None" Tag="None" Foreground="{StaticResource T1}" Background="{StaticResource IBg}"/>
                        </ComboBox>
                    </Grid>

                    <!-- Image offset + zoom -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock x:Name="LabelOffsetX" Style="{StaticResource DLb}"/><TextBox x:Name="OffsetXBox" Style="{StaticResource DTb}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock x:Name="LabelOffsetY" Style="{StaticResource DLb}"/><TextBox x:Name="OffsetYBox" Style="{StaticResource DTb}"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelZoom" VerticalAlignment="Center" Foreground="{StaticResource T2}" FontSize="11" Width="60"/>
                        <Slider x:Name="BgZoomSlider" Grid.Column="1" Minimum="0.5" Maximum="3" TickFrequency="0.1" Background="Transparent" Cursor="Hand" Margin="6,0,0,0"/>
                        <TextBlock x:Name="BgZoomValue" Grid.Column="2" Foreground="{StaticResource T1}" FontSize="13" FontWeight="SemiBold" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>

                    <!-- Bg image opacity -->
                    <TextBlock x:Name="LabelBgOpacity" Style="{StaticResource DLb}"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Slider x:Name="BgOpacitySlider" Minimum="5" Maximum="100" TickFrequency="5" Background="Transparent" Cursor="Hand"/>
                        <TextBlock x:Name="BgOpacityValue" Grid.Column="1" Foreground="{StaticResource T2}" FontSize="11" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelButton" Background="#15FFFFFF" Foreground="{StaticResource T2}" BorderBrush="{StaticResource IBd}" BorderThickness="1" Padding="20,8" Cursor="Hand" FontSize="12"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
                <Button x:Name="ApplyButton" Background="{StaticResource Acc}" Foreground="White" BorderThickness="0" Padding="20,8" Margin="8,0,0,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
