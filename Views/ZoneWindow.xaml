<Window x:Class="DesktopZones.Views.ZoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DesktopZones.Services"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        xmlns:c="clr-namespace:DesktopZones.Views.Components"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Window.Resources>
        <ResourceDictionary>
            <!-- ponytail 2026-08-25: ZoneWindow.ItemsControl template selector (Task 6).
                 Type=SubFolder → SubfolderItemView; everything else → original item
                 template (key "ZoneItemTemplate"). The selector lives in
                 Views/Components/SubfolderItemTemplateSelector.cs. -->
            <DataTemplate x:Key="ZoneItemTemplate">
                <Grid Width="{Binding ItemSize}" Height="{Binding ItemHeight}"
                      Background="Transparent"
                      MouseLeftButtonDown="Item_MouseDown"
                      MouseMove="Item_MouseMove"
                      MouseLeftButtonUp="Item_MouseUp"
                      MouseEnter="Item_Enter"
                      MouseLeave="Item_Leave"
                      Cursor="Hand">
                    <Grid.ContextMenu>
                        <ContextMenu Opened="ItemMenu_Opened">
                            <MenuItem x:Name="CtxOpen" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Item.Open]}" Click="ItemOpen_Click"/>
                            <MenuItem x:Name="CtxOpenLocation" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Item.OpenLocation]}" Click="ItemOpenLocation_Click"/>
                            <MenuItem x:Name="CtxEmptyRecycle" Visibility="Collapsed"
                                      Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Item.EmptyRecycleBin]}"
                                      Click="ItemEmptyRecycle_Click"/>
                            <MenuItem x:Name="CtxRename" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Item.Rename]}" Click="ItemRename_Click"/>
                            <Separator x:Name="CtxSep1"/>
                            <MenuItem x:Name="CtxDelete" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Item.Delete]}" Click="ItemDelete_Click" Foreground="#FF6666"/>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <!-- 方形 hover 高光(仅图标格区域,与面板一致的标准正方形) -->
                    <Border x:Name="HoverBox" Width="{Binding ItemSize}" Height="{Binding ItemSize}"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="Transparent" CornerRadius="6" IsHitTestVisible="False"/>
                    <!-- 图标+名称整体垂直居中(面板对齐):80 格子里 40px 图标居中,名称在下方。 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <Image Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ItemNameText" Text="{Binding Name}" FontSize="10"
                                   Foreground="{Binding ItemTextBrush, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=#E0FFFFFF}"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="{Binding NameMaxWidth}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    <!-- 方形选中高光(标准正方形,不含名称行) -->
                    <Border x:Name="SelBox" Width="{Binding ItemSize}" Height="{Binding ItemSize}"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="Collapsed" IsHitTestVisible="False"
                            Background="#26FFFFFF" CornerRadius="6"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="SelBox" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <!-- 隐藏应用名：声明式绑定到窗口 Zone.HideAppName。容器实例化瞬间
                         即应用，避免缩窗重排/增删图标时「名字先显示再隐藏」的闪烁。 -->
                    <DataTrigger Binding="{Binding DataContext.Zone.HideAppName,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter TargetName="ItemNameText" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <DataTemplate x:Key="SubfolderItemTemplate">
                <Grid Width="{Binding ItemSize}" Height="{Binding ItemSize}"
                      Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="Item_MouseDown"
                      MouseMove="Item_MouseMove"
                      MouseLeftButtonUp="Item_MouseUp"
                      MouseEnter="Item_Enter"
                      MouseLeave="Item_Leave">
                    <Grid.ContextMenu>
                        <!-- ponytail: 次级文件夹右键菜单 — 打开/重命名/解散/删除。
                             与普通图标同款重命名弹窗;解散=图标散入分区(自动排列),删除=连同内部图标一起删。 -->
                        <ContextMenu>
                            <MenuItem x:Name="CtxSubOpen" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Item.Open]}" Click="SubfolderOpen_Click"/>
                            <MenuItem x:Name="CtxSubRename" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Item.Rename]}" Click="SubfolderRename_Click"/>
                            <MenuItem x:Name="CtxSubDissolve" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Subfolder.Dissolve]}" Click="SubfolderDissolve_Click"/>
                            <Separator/>
                            <MenuItem x:Name="CtxSubDelete" Header="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Item.Delete]}" Click="SubfolderDelete_Click" Foreground="#FF6666"/>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <c:SubfolderItemView HideName="{Binding DataContext.Zone.HideAppName, RelativeSource={RelativeSource AncestorType=Window}}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- 方形 hover 高光(次级分区图标格区域) -->
                    <Border x:Name="SubHoverBox" Width="{Binding ItemSize}" Height="{Binding ItemSize}"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="Transparent" CornerRadius="6" IsHitTestVisible="False"/>
                    <!-- 方形选中高光 -->
                    <Border x:Name="SubSelBox" Width="{Binding ItemSize}" Height="{Binding ItemSize}"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="Collapsed" IsHitTestVisible="False"
                            Background="#26FFFFFF" CornerRadius="6"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="SubSelBox" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <c:SubfolderItemTemplateSelector x:Key="SubfolderItemTemplateSelector"
                                             ZoneItemTemplate="{StaticResource ZoneItemTemplate}"
                                             SubfolderItemTemplate="{StaticResource SubfolderItemTemplate}"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- FULL ZONE -->
        <Border x:Name="MainContent" Visibility="Visible" ClipToBounds="True" CornerRadius="8">
            <Grid>
                <!-- Fill layer + bg image -->
                <Rectangle x:Name="FillRect" Fill="#08000000"
                           RadiusX="8" RadiusY="8" IsHitTestVisible="False"/>
                <Border x:Name="BgImageBorder" ClipToBounds="True" IsHitTestVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Image x:Name="BgImage" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Opacity="0" IsHitTestVisible="False"/>
                </Border>

                <Border x:Name="ZoneBorder"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Background="Transparent">
                    <Border.ContextMenu>
                        <ContextMenu Opened="ZoneMenu_Opened">
                            <!-- ponytail 2026-08-27: 5 段结构 — 导入 ▶ / 新建次级文件夹 /
                                 新建 ▶ / 设置 / 最小化 / 删除分区。导入与"新建"作为二级
                                 菜单(▶ 子菜单箭头),其它项平级。设置 → 弹 PropertyPanel
                                 样式浮窗;最小化 = 隐藏分区(沿用 HideZone);删除分区保留
                                 红色 #FF6666 提示。合并解散(条件显示)放在"删除分区"上方。 -->
                            <!-- ponytail 2026-08-27: 父项 CtxImport/CtxNew 不挂 Click — 只承担
                                 展开子菜单职责。挂 Click 会同时触发父项 + 子项两个 Click,
                                 导致"导入系统项目"关闭后父项 ImportFiles_Click 又弹一次。 -->
                            <MenuItem x:Name="CtxImport" Header="{loc:Loc Key=ZoneMenu.Import}">
                                <MenuItem x:Name="CtxImportFiles" Header="{loc:Loc Key=ZoneMenu.ImportFiles}" Click="ImportFiles_Click"/>
                                <MenuItem x:Name="CtxImportFolder" Header="{loc:Loc Key=ZoneMenu.ImportFolder}" Click="ImportFolder_Click"/>
                                <MenuItem x:Name="CtxImportShell" Header="{loc:Loc Key=Zone.ImportShellItems}" Click="ImportShellItems_Click"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="CtxNewSubZone" Header="{loc:Loc Key=SubZone.New}" Click="NewSubfolder_Click"/>
                            <MenuItem x:Name="CtxNew" Header="{loc:Loc Key=ZoneMenu.New}">
                                <MenuItem x:Name="CtxNewFolder" Header="{loc:Loc Key=ZoneMenu.NewFolder}" Click="NewFolder_Click"/>
                                <Separator/>
                                <MenuItem x:Name="CtxNewTxt" Header="{loc:Loc Key=ZoneMenu.NewTxt}" Click="NewTxt_Click"/>
                                <MenuItem x:Name="CtxNewDocx" Header="{loc:Loc Key=ZoneMenu.NewDocx}" Click="NewDocx_Click"/>
                                <MenuItem x:Name="CtxNewPptx" Header="{loc:Loc Key=ZoneMenu.NewPptx}" Click="NewPptx_Click"/>
                                <MenuItem x:Name="CtxNewXlsx" Header="{loc:Loc Key=ZoneMenu.NewXlsx}" Click="NewXlsx_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="CtxMapFolderNew" Header="{loc:Loc Key=FolderMap.MenuMap}" Click="FolderMapChoose_Click"/>
                            <Separator/>
                            <MenuItem x:Name="CtxSettings" Header="{loc:Loc Key=ZoneMenu.Settings}" Click="SettingsZone_Click"/>
                            <Separator/>
                            <MenuItem x:Name="CtxDisbandAll" Header="{loc:Loc Key=Merge.DisbandAll}" Click="DisbandAll_Click" Visibility="Collapsed"/>
                            <MenuItem x:Name="CtxDisbandThis" Header="{loc:Loc Key=Merge.DisbandSingle}" Click="DisbandThis_Click" Visibility="Collapsed"/>
                            <Separator x:Name="CtxMergeSep" Visibility="Collapsed"/>
                            <!-- ponytail 2026-08-27: 锁定/解锁 — 复用 LockBtn_Click; ApplyLockState
                                 切锁定态同步菜单 Header;合并组时随主分区状态同步(同一右键菜单)。 -->
                            <MenuItem x:Name="CtxLock" Header="{loc:Loc Key=Common.Lock}" Click="CtxLock_Click"/>
                            <MenuItem x:Name="CtxMinimize" Header="{loc:Loc Key=ZoneMenu.Minimize}" Click="HideZone_Click"/>
                            <MenuItem x:Name="CtxDelete" Header="{loc:Loc Key=ZoneMenu.DeleteZone}" Foreground="#FF6666" Click="DeleteZone_Click"/>
                            <Separator x:Name="CtxPasteSep" Visibility="Collapsed"/>
                            <MenuItem x:Name="CtxPaste" Header="{loc:Loc Key=FolderMap.Paste}" Click="PasteClipboard_Click" Visibility="Collapsed"/>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title bar — drag-to-move -->
                        <Border x:Name="TitleBarBg" Grid.Row="0" Height="24"
                                Background="#10FFFFFF"
                                CornerRadius="8,8,0,0"
                                Cursor="SizeAll"
                                RenderTransformOrigin="0.5,0.5"
                                MouseLeftButtonDown="TitleBar_Drag">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="TitleBarScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Path x:Name="TitleIconPath" Width="12" Height="12"
                                          Stretch="Uniform" Stroke="#A0FFFFFF" StrokeThickness="1.5"
                                          StrokeLineJoin="Round" VerticalAlignment="Center"
                                          Margin="0,0,4,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="TitleIconChar" Text="" FontSize="12"
                                               Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="ZoneTitleText" Text="New Zone"
                                             AllowDrop="False"
                                             FontSize="11" Foreground="#A0FFFFFF"
                                             Background="Transparent" BorderThickness="0"
                                             CaretBrush="#A0FFFFFF"
                                             VerticalAlignment="Center"
                                             MaxWidth="160"
                                             PreviewMouseLeftButtonDown="ZoneTitle_PreviewMouseLeftButtonDown"
                                             LostFocus="ZoneTitle_LostFocus"
                                             KeyDown="ZoneTitle_KeyDown"/>
                                </StackPanel>
                                <StackPanel x:Name="ControlPoint"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,4,0" Opacity="0.4">
                                    <Border x:Name="LockBtn" Width="18" Height="16"
                                            CornerRadius="3" Background="#30FFFFFF"
                                            Cursor="Hand" Margin="0,0,3,0"
                                            MouseLeftButtonDown="LockBtn_Click"
                                            MouseEnter="Ctrl_Enter" MouseLeave="Ctrl_Leave"
                                            ToolTip="{loc:Loc Key=Common.Lock}">
                                        <TextBlock x:Name="LockBtnText" Text="🔓" FontSize="9"
                                                   Foreground="#80FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ImportBtn" Width="18" Height="16"
                                            CornerRadius="3" Background="#30FFFFFF"
                                            Cursor="Hand" Margin="0,0,3,0"
                                            MouseLeftButtonDown="ImportBtn_Click"
                                            MouseEnter="Ctrl_Enter" MouseLeave="Ctrl_Leave"
                                            ToolTip="{loc:Loc Key=Subfolder.New}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <!-- ponytail 2026-08-27: 加号菜单 — 与右键结构一致
                                                 (导入 ▶ / 新建次级分区 / 新建 ▶ 含映射文件夹),
                                                 不再带设置/最小化/删除分区。父项不挂 Click 防双触发。 -->
                                            <MenuItem x:Name="CtxImport2" Header="{loc:Loc Key=ZoneMenu.Import}">
                                                <MenuItem x:Name="CtxImportFiles2" Header="{loc:Loc Key=ZoneMenu.ImportFiles}" Click="ImportFiles_Click"/>
                                                <MenuItem x:Name="CtxImportFolder2" Header="{loc:Loc Key=ZoneMenu.ImportFolder}" Click="ImportFolder_Click"/>
                                                <MenuItem x:Name="CtxImportShell2" Header="{loc:Loc Key=Zone.ImportShellItems}" Click="ImportShellItems_Click"/>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem x:Name="CtxNewSubZone2" Header="{loc:Loc Key=SubZone.New}" Click="NewSubfolder_Click"/>
                                            <MenuItem x:Name="CtxNew2" Header="{loc:Loc Key=ZoneMenu.New}">
                                                <MenuItem x:Name="CtxNewFolder2" Header="{loc:Loc Key=ZoneMenu.NewFolder}" Click="NewFolder_Click"/>
                                                <Separator/>
                                                <MenuItem x:Name="CtxNewTxt2" Header="{loc:Loc Key=ZoneMenu.NewTxt}" Click="NewTxt_Click"/>
                                                <MenuItem x:Name="CtxNewDocx2" Header="{loc:Loc Key=ZoneMenu.NewDocx}" Click="NewDocx_Click"/>
                                                <MenuItem x:Name="CtxNewPptx2" Header="{loc:Loc Key=ZoneMenu.NewPptx}" Click="NewPptx_Click"/>
                                                <MenuItem x:Name="CtxNewXlsx2" Header="{loc:Loc Key=ZoneMenu.NewXlsx}" Click="NewXlsx_Click"/>
                                            </MenuItem>
                                            <MenuItem x:Name="CtxMapFolder2" Header="{loc:Loc Key=FolderMap.MenuMap}" Click="FolderMapChoose_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                        <TextBlock x:Name="ImportBtnText" Text="+" FontSize="11" FontWeight="Bold"
                                                   Foreground="#80FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="EditBtn" Width="18" Height="16"
                                            CornerRadius="3" Background="#30FFFFFF"
                                            Cursor="Hand" Margin="0,0,3,0"
                                            MouseLeftButtonDown="EditButton_Click"
                                            MouseEnter="Ctrl_Enter" MouseLeave="Ctrl_Leave"
                                            ToolTip="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Zone.Edit]}">
                                        <TextBlock x:Name="EditBtnText" Text="⚙" FontSize="9"
                                                   Foreground="#80FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="HideBtn" Width="18" Height="16"
                                            CornerRadius="3" Background="#30FFFFFF"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="HideButton_Click"
                                            MouseEnter="Ctrl_Enter" MouseLeave="Ctrl_Leave"
                                            ToolTip="{Binding Source={x:Static l:LocalizationService.Instance}, Path=[Zone.Hide]}">
                                        <TextBlock x:Name="HideBtnText" Text="─" FontSize="10" Foreground="#80FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,-2,0,0"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sub-zone tabs (visible only when merged) -->
                        <Border x:Name="SubZoneTabsRow" Grid.Row="1" Height="24"
                                Background="#08FFFFFF" Visibility="Collapsed">
                            <StackPanel x:Name="SubZoneTabs" Orientation="Horizontal"
                                        Margin="4,0,0,0"/>
                        </Border>

                        <!-- Items (scrollable) -->
                        <ScrollViewer x:Name="ItemsViewport" Grid.Row="2" VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden" Background="Transparent">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform x:Name="ItemsViewportTranslate" X="0"/>
                            </ScrollViewer.RenderTransform>
                        <Grid>
                        <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas x:Name="ItemCanvas"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Background="Transparent"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplateSelector>
                                <c:SubfolderItemTemplateSelector ZoneItemTemplate="{StaticResource ZoneItemTemplate}"
                                                                 SubfolderItemTemplate="{StaticResource SubfolderItemTemplate}"/>
                            </ItemsControl.ItemTemplateSelector>
                        </ItemsControl>
                        <Canvas x:Name="DropIndicatorLayer" IsHitTestVisible="False" Background="Transparent"/>
                        </Grid>
                        </ScrollViewer>

                        <!-- Folder mapping view (visible when folder mapping is enabled) -->
                        <Border x:Name="FolderMappingView" Grid.Row="2" Visibility="Collapsed"
                                Background="#40000000" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header: up / path / refresh / disable — part of the
                                     title-bar band (fills + crop dividers include it). -->
                                <Border x:Name="FolderMapHeaderBg" Grid.Row="0" Background="#22FFFFFF">
                                    <DockPanel LastChildFill="True">
                                        <Border x:Name="FolderMapUpBtn" Width="20" Height="18" CornerRadius="3"
                                                Background="#30FFFFFF" Cursor="Hand" Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                MouseLeftButtonDown="FolderMapUp_Click"
                                                MouseEnter="Ctrl_Enter" MouseLeave="Ctrl_Leave"
                                                ToolTip="{loc:Loc Key=FolderMap.Up}">
                                            <TextBlock x:Name="FolderMapUpText" Text="↰" FontSize="10" Foreground="#A0FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="FolderMapCloseBtn" Width="20" Height="18" CornerRadius="3"
                                                Background="#30FFFFFF" Cursor="Hand" Margin="0,0,4,0"
                                                VerticalAlignment="Center" DockPanel.Dock="Right"
                                                MouseLeftButtonDown="FolderMapClose_Click"
                                                MouseEnter="Ctrl_Enter" MouseLeave="Ctrl_Leave"
                                                ToolTip="{loc:Loc Key=FolderMap.Disable}">
                                            <TextBlock x:Name="FolderMapCloseText" Text="✕" FontSize="9" Foreground="#A0FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="FolderMapRefreshBtn" Width="20" Height="18" CornerRadius="3"
                                                Background="#30FFFFFF" Cursor="Hand" Margin="0,0,3,0"
                                                VerticalAlignment="Center" DockPanel.Dock="Right"
                                                MouseLeftButtonDown="FolderMapRefresh_Click"
                                                MouseEnter="Ctrl_Enter" MouseLeave="Ctrl_Leave"
                                                ToolTip="{loc:Loc Key=FolderMap.Refresh}">
                                            <TextBlock x:Name="FolderMapRefreshText" Text="⟳" FontSize="10" Foreground="#A0FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="FolderMapPathText" Text="" FontSize="10" Foreground="#A0FFFFFF"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="6,0,6,0"/>
                                    </DockPanel>
                                </Border>

                                <ListBox x:Name="FolderList" Grid.Row="1" Background="Transparent"
                                         BorderThickness="0" SelectionMode="Extended"
                                         Margin="10,10,0,0"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         PreviewMouseLeftButtonDown="FolderList_PreviewMouseLeftButtonDown">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <c:VirtualizingWrapPanel ItemWidth="76" ItemHeight="66" Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <!-- Custom template: no ListBoxItemChrome, so the hover/selected
                                                 highlight is the zone's translucent white — never the
                                                 system-blue chrome. -->
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                CornerRadius="6" SnapsToDevicePixels="True">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#18FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#30FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Same geometry logic as a normal zone item: icon fills the
                                                 top of the cell, name sits directly underneath. -->
                                            <Border Width="76" Height="66" Background="Transparent"
                                                    CornerRadius="6" ToolTip="{Binding FullPath}">
                                                <Grid>
                                                    <Image Source="{Binding Icon}" Width="48" Height="48" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#E0FFFFFF"
                                                               TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                               Margin="1,0,1,1" MaxWidth="72"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Status hint (empty / invalid / loading) -->
                                <StackPanel x:Name="FolderMapHint" Grid.Row="1" Visibility="Collapsed"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="FolderMapHintText" FontSize="11" Foreground="#A0FFFFFF"
                                               HorizontalAlignment="Center" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="16,0"/>
                                    <Button x:Name="FolderMapHintBtn" Content="Choose again" Cursor="Hand"
                                            Margin="0,10,0,0" Padding="12,4,12,4" FontSize="11"
                                            Click="FolderMapChoose_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Bottom bar (no move — only visual) -->
                        <Border x:Name="BottomBarBg" Grid.Row="3" Height="8"
                                Background="#08FFFFFF"
                                CornerRadius="0,0,8,8"/>

                        <!-- 自定义图标双击脉冲反馈（仅磁贴单图标模式由代码触发 Opacity 动画） -->
                        <Border x:Name="ClickPulseBg" Grid.RowSpan="4" Background="#FFFFFF"
                                Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Four corner resize grips -->
                <Border x:Name="GripTL" Width="12" Height="12"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Cursor="SizeNWSE" Background="Transparent"
                        MouseLeftButtonDown="ResizeGrip_Down"/>
                <Border x:Name="GripTR" Width="12" Height="12"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Cursor="SizeNESW" Background="Transparent"
                        MouseLeftButtonDown="ResizeGrip_Down"/>
                <Border x:Name="GripBL" Width="12" Height="12"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Cursor="SizeNESW" Background="Transparent"
                        MouseLeftButtonDown="ResizeGrip_Down"/>
                <Border x:Name="GripBR" Width="12" Height="12"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Cursor="SizeNWSE" Background="Transparent"
                        MouseLeftButtonDown="ResizeGrip_Down"/>
            </Grid>
        </Border>

        <!-- Marquee multi-select overlay (long-press + drag on items / drag on empty area) -->
        <Canvas x:Name="MarqueeLayer" IsHitTestVisible="False" Background="Transparent">
            <Rectangle x:Name="MarqueeRect" Visibility="Collapsed" IsHitTestVisible="False"
                       Stroke="#C08AB4F8" StrokeThickness="1" Fill="#228AB4F8"/>
        </Canvas>

        <!-- Restore button (draggable with long press) -->
        <Border x:Name="RestoreButton"
                Visibility="Collapsed"
                Width="36" Height="36"
                CornerRadius="18"
                Background="{DynamicResource Menu.Bg.Surface}"
                BorderThickness="0"
                Cursor="Hand"
                MouseLeftButtonDown="Restore_MouseDown"
                MouseMove="Restore_MouseMove"
                MouseLeftButtonUp="Restore_MouseUp"
                MouseEnter="Restore_Enter" MouseLeave="Restore_Leave">
            <Grid>
                <Path x:Name="RestoreIconPath" Width="18" Height="18"
                      Stretch="Uniform" Stroke="#C0FFFFFF" StrokeThickness="1.5"
                      StrokeLineJoin="Round" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="RestoreIconChar" Text="⊞"
                           FontSize="18" Foreground="#C0FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ponytail 2026-08-26: SubFolder flyout — StaysOpen=True (ZoneWindow 自己管
             关闭)。Placement=AbsolutePoint:位置由 code-behind 在 flyout 布局完成后一次性
             确定(图标右侧 8px,越界翻侧 + 夹工作区),不再走 Custom 回调 — 回调的 target-
             relative 坐标与 Popup 重排会引入"每次展开位置/原点漂移"。打开动画锚点 =
             图标屏幕中心(按同一份位置数据反推,不读 flyout 自身 PointToScreen),视觉上
             "以图标为原点向右下角展开",关闭动画原路缩回图标。关闭:点击 Flyout 外
             (分区空白/桌面)、鼠标移出(200ms timer)都会触发反向动画后关闭。 -->
        <Popup x:Name="SubfolderFlyoutPopup" Placement="AbsolutePoint"
               AllowsTransparency="True" StaysOpen="True"
               Closed="SubfolderFlyoutPopup_Closed">
            <c:SubfolderFlyout x:Name="SubfolderFlyoutView"
                               MouseEnter="SubfolderFlyoutView_MouseEnter"
                               MouseLeave="SubfolderFlyoutView_MouseLeave"
                               EditStyleRequested="SubfolderFlyout_EditStyleRequested"
                               ItemDragOutRequested="SubfolderFlyout_ItemDragOutRequested"/>
        </Popup>
    </Grid>
</Window>
