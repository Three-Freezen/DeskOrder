<Window x:Class="DesktopZones.Views.SavePresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Title="Save Zone Preset"
        Width="380" Height="220"
        MinWidth="340" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="12"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#AA000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="DialogTitle" Text="{loc:Loc Key=Preset.SaveTitle.Zone}"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,12"/>

            <!-- Name label -->
            <TextBlock x:Name="LabelName" Grid.Row="1" Text="{loc:Loc Key=Preset.NameLabel}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" Margin="0,0,0,4"/>

            <!-- Name input -->
            <Grid Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,8">
                <TextBox x:Name="NameBox"
                         Background="{DynamicResource Brush.Bg.Input}"
                         Foreground="{DynamicResource Brush.Text.Primary}"
                         BorderBrush="{DynamicResource Brush.Border.Default}"
                         BorderThickness="1" Padding="8,6" FontSize="13"
                         TextChanged="NameBox_TextChanged"
                         KeyDown="NameBox_KeyDown"/>
                <TextBlock x:Name="EmptyHint" Text="{loc:Loc Key=Preset.EmptyNameHint}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="11"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Buttons -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Saved hint, briefly shown after a successful preset save. Lives here so every caller
                     of SavePresetDialog benefits without each one wiring its own timer. -->
                <TextBlock x:Name="SavedHint" Text="{loc:Loc Key=Preset.Saved}"
                           Foreground="{DynamicResource Brush.Success}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="Collapsed"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="{loc:Loc Key=Preset.Cancel}"
                        Background="{DynamicResource Brush.Bg.Surface}" Foreground="{DynamicResource Brush.Text.Secondary}"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                        Padding="20,8" Cursor="Hand" FontSize="12"
                        Click="CancelButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="SaveButton" Content="{loc:Loc Key=Preset.Save}"
                        Background="{DynamicResource Brush.Accent.Solid}" Foreground="{DynamicResource Brush.Accent.On}"
                        BorderThickness="0" Padding="20,8" Margin="8,0,0,0"
                        Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                        IsDefault="True"
                        Click="SaveButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
