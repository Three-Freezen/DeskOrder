<Window x:Class="DesktopZones.Views.SavePresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Zone Preset"
        Width="380" Height="220"
        MinWidth="340" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#E610111A"/>
        <SolidColorBrush x:Key="Acc" Color="#7C3AED"/>
        <SolidColorBrush x:Key="T1" Color="#E8E8F0"/>
        <SolidColorBrush x:Key="T2" Color="#8888A0"/>
        <SolidColorBrush x:Key="T3" Color="#606080"/>
        <SolidColorBrush x:Key="IBg" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="IBd" Color="#15FFFFFF"/>

        <Style x:Key="DTb" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource IBg}"/>
            <Setter Property="Foreground" Value="{StaticResource T1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource IBd}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" CornerRadius="12" BorderBrush="#15FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#AA000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="DialogTitle" Text="保存分区预设"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource T1}" Margin="0,0,0,12"/>

            <!-- Name label -->
            <TextBlock x:Name="LabelName" Grid.Row="1" Text="预设名称"
                       Foreground="{StaticResource T2}" FontSize="11" Margin="0,0,0,4"/>

            <!-- Name input -->
            <Grid Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,8">
                <TextBox x:Name="NameBox" Style="{StaticResource DTb}"
                         TextChanged="NameBox_TextChanged"
                         KeyDown="NameBox_KeyDown"/>
                <TextBlock x:Name="EmptyHint" Text="请输入预设名称"
                           Foreground="{StaticResource T3}" FontSize="11"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="CancelButton" Content="取消"
                        Background="#15FFFFFF" Foreground="{StaticResource T2}"
                        BorderBrush="{StaticResource IBd}" BorderThickness="1"
                        Padding="20,8" Cursor="Hand" FontSize="12"
                        Click="CancelButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="SaveButton" Content="保存"
                        Background="{StaticResource Acc}" Foreground="White"
                        BorderThickness="0" Padding="20,8" Margin="8,0,0,0"
                        Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                        IsDefault="True"
                        Click="SaveButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
