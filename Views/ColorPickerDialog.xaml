<Window x:Class="DesktopZones.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Title="{loc:Loc Key=ColorPicker.Title}" Width="300" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="24"/>
        </Style>
    </Window.Resources>

    <!-- 背景填充/文字跟随电脑深浅色(与分区右键菜单同一套 Menu.* 调色板,不跟随管理界面主题) -->
    <Border Background="{DynamicResource Menu.Bg.Surface}" CornerRadius="12"
            BorderBrush="{DynamicResource Menu.Border.Subtle}" BorderThickness="1"
            MouseLeftButtonDown="TitleBar_Down">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleLabel" Text="Pick Color" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Menu.Text.Primary}" Margin="0,4,0,12"/>

            <!-- Title/content divider (自适应文字色,同液态玻璃二级窗口) -->
            <Border Grid.Row="1" Height="1" Margin="0,0,0,10"
                    Background="{DynamicResource Menu.Separator}"/>

            <!-- Preview -->
            <Border x:Name="ColorPreview" Grid.Row="2" Height="40" CornerRadius="6"
                    BorderBrush="{DynamicResource Menu.Border.Subtle}" BorderThickness="1" Margin="0,0,0,8"/>

            <!-- Hex input -->
            <Grid Grid.Row="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" Foreground="{DynamicResource Menu.Text.Secondary}"
                           FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="HexBox" Grid.Column="1" Text="FFFFFF"
                         FontSize="14" Foreground="{DynamicResource Menu.Text.Primary}"
                         Background="{DynamicResource Menu.Bg.Hover}" BorderBrush="{DynamicResource Menu.Border.Subtle}"
                         BorderThickness="1" Padding="8,4"
                         MaxLength="6" TextChanged="HexBox_Changed"/>
            </Grid>

            <!-- R -->
            <Grid Grid.Row="4" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <!-- ponytail: channel label colors stay hardcoded — they encode the R/G/B
                     channel meaning (red/green/blue), not chrome; recoloring them to
                     Danger/Success/Accent would mislabel the controls. -->
                <TextBlock Text="R" Foreground="#FF6666" FontWeight="Bold" VerticalAlignment="Center"/>
                <Slider x:Name="SliderR" Grid.Column="1" Minimum="0" Maximum="255"
                        Style="{StaticResource SliderStyle}" ValueChanged="Slider_Changed"/>
                <TextBox x:Name="ValR" Grid.Column="2" Text="255" Width="32"
                         Foreground="{DynamicResource Menu.Text.Primary}"
                         Background="{DynamicResource Menu.Bg.Hover}" BorderBrush="{DynamicResource Menu.Border.Subtle}"
                         BorderThickness="1" Padding="2" FontSize="11"
                         TextChanged="ValR_Changed"/>
            </Grid>

            <!-- G -->
            <Grid Grid.Row="5" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="G" Foreground="#50FA7B" FontWeight="Bold" VerticalAlignment="Center"/>
                <Slider x:Name="SliderG" Grid.Column="1" Minimum="0" Maximum="255"
                        Style="{StaticResource SliderStyle}" ValueChanged="Slider_Changed"/>
                <TextBox x:Name="ValG" Grid.Column="2" Text="255" Width="32"
                         Foreground="{DynamicResource Menu.Text.Primary}"
                         Background="{DynamicResource Menu.Bg.Hover}" BorderBrush="{DynamicResource Menu.Border.Subtle}"
                         BorderThickness="1" Padding="2" FontSize="11"
                         TextChanged="ValG_Changed"/>
            </Grid>

            <!-- B -->
            <Grid Grid.Row="6" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="B" Foreground="#88CCFF" FontWeight="Bold" VerticalAlignment="Center"/>
                <Slider x:Name="SliderB" Grid.Column="1" Minimum="0" Maximum="255"
                        Style="{StaticResource SliderStyle}" ValueChanged="Slider_Changed"/>
                <TextBox x:Name="ValB" Grid.Column="2" Text="255" Width="32"
                         Foreground="{DynamicResource Menu.Text.Primary}"
                         Background="{DynamicResource Menu.Bg.Hover}" BorderBrush="{DynamicResource Menu.Border.Subtle}"
                         BorderThickness="1" Padding="2" FontSize="11"
                         TextChanged="ValB_Changed"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="Cancel" Padding="16,6" Cursor="Hand" FontSize="12"
                        Click="Cancel_Click"
                        Style="{DynamicResource OutlineBtn}"/>
                <Button x:Name="OkBtn" Content="OK" Padding="16,6" Margin="8,0,0,0"
                        Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                        Click="Ok_Click"
                        Style="{DynamicResource FillBtn}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
