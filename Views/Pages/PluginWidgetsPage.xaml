<UserControl x:Class="DesktopZones.Views.Pages.PluginWidgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopZones.Helpers">
    <!-- 与「分区 / 快捷栏 / 分区坞」列表页同一套页头与原生行（EditableListRow）：
         行上不出现任何操作按钮，点行 = 右侧打开原生属性面板，显示/锁定/删除都在面板状态区。 -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="20,16,20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Key=PluginWidget.Nav}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountText" Margin="8,0,0,0" FontSize="11"
                               FontFamily="Cascadia Code, Consolas, monospace"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="NewBtn" Grid.Column="2" Padding="14,6"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        FontWeight="SemiBold" Cursor="Hand"
                        Style="{DynamicResource FillBtn}"
                        Content="{loc:Loc Key=PluginWidget.New}"
                        Click="New_Click"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="8,0,8,0">
            <Grid Margin="12,12,12,12">
                <ItemsControl x:Name="ListHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <StackPanel x:Name="EmptyHint" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0">
                    <TextBlock Text="{loc:Loc Key=PluginWidget.Empty}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Key=PluginWidget.EmptyHint}" FontSize="11" Margin="0,8,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               HorizontalAlignment="Center"/>
                    <!-- 「装了但还没重启」追加提示：否则空态会让人以为插件没生效。 -->
                    <TextBlock x:Name="RestartHint" Text="{loc:Loc Key=PluginWidget.NeedsRestart}"
                               FontSize="11" Margin="0,12,0,0"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
