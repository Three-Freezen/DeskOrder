<UserControl x:Class="DesktopZones.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
             xmlns:components="clr-namespace:DesktopZones.Views.Components">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,12">
    <StackPanel>
      <TextBlock Text="{loc:Loc Key=Settings.PageTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"
                 Foreground="{DynamicResource Brush.Text.Primary}"/>

      <!-- 常规 -->
      <TextBlock Text="{loc:Loc Key=Settings.General}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel>
          <CheckBox x:Name="StartWithWindowsBox" Content="{loc:Loc Key=Settings.StartWithWindows}" Margin="0,6,0,6"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>
          <CheckBox x:Name="StartMinimizedBox" Content="{loc:Loc Key=Settings.StartMinimized}" Margin="0,6,0,6"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="StartMinimized_Changed" Unchecked="StartMinimized_Changed"/>
          <CheckBox x:Name="AutoAlignBox" Content="{loc:Loc Key=Settings.AutoAlign}" Margin="0,6,0,6"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="AutoAlign_Changed" Unchecked="AutoAlign_Changed"/>
          <CheckBox x:Name="ReverseSyncBox" Content="{loc:Loc Key=Settings.ReverseSync}" Margin="0,6,0,2"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="ReverseSync_Changed" Unchecked="ReverseSync_Changed"/>
          <TextBlock Text="{loc:Loc Key=Settings.ReverseSync.Hint}" FontSize="11" Margin="24,0,0,8"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
          <CheckBox x:Name="ImagePreviewBox" Content="{loc:Loc Key=Settings.ImagePreview}" Margin="0,6,0,2"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="ImagePreview_Changed" Unchecked="ImagePreview_Changed"/>
          <TextBlock Text="{loc:Loc Key=Settings.ImagePreview.Hint}" FontSize="11" Margin="24,0,0,8"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
          <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Loc Key=Settings.Language}" VerticalAlignment="Center" Margin="0,0,0,0"
                       Foreground="{DynamicResource Brush.Text.Primary}"/>
            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="120"
                      SelectionChanged="Language_Changed">
              <ComboBoxItem Content="{loc:Loc Key=Menu.Chinese}" Tag="zh"/>
              <ComboBoxItem Content="{loc:Loc Key=Menu.English}" Tag="en"/>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 外观 -->
      <TextBlock Text="{loc:Loc Key=Settings.Appearance}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{loc:Loc Key=Settings.Theme}" Margin="0,6,0,6"
                     Foreground="{DynamicResource Brush.Text.Primary}"/>
          <Border Background="{DynamicResource Brush.Bg.Input}" CornerRadius="4" Padding="2">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ThemeSystemRb" Content="{loc:Loc Key=Theme.System}" GroupName="Theme" Style="{StaticResource SegmentItem}" Checked="ThemeRb_Changed"/>
              <RadioButton x:Name="ThemeLightRb"  Content="{loc:Loc Key=Theme.Light}"  GroupName="Theme" Style="{StaticResource SegmentItem}" Checked="ThemeRb_Changed"/>
              <RadioButton x:Name="ThemeDarkRb"   Content="{loc:Loc Key=Theme.Dark}"   GroupName="Theme" Style="{StaticResource SegmentItem}" Checked="ThemeRb_Changed"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 快捷键 -->
      <TextBlock Text="{loc:Loc Key=Note.Hotkey}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel x:Name="HotkeyStack"/>
      </Border>

      <!-- 更新 -->
      <TextBlock Text="{loc:Loc Key=Settings.Update}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=Settings.CheckUpdate}" Foreground="{DynamicResource Brush.Text.Primary}"/>
              <TextBlock x:Name="UpdateStatusText" Text="{loc:Loc Key=Settings.UpToDate}" FontSize="11" Margin="0,2,0,0"
                         Foreground="{DynamicResource Brush.Text.Tertiary}"/>
            </StackPanel>
            <Button x:Name="UpdateButton" Grid.Column="1" Content="{loc:Loc Key=Settings.CheckUpdate}"
                    Click="UpdateButton_Click" Cursor="Hand"
                    FontWeight="SemiBold" Padding="14,6" MinWidth="96"
                    Style="{DynamicResource FillBtn}"/>
          </Grid>
          <ProgressBar x:Name="UpdateProgress" Height="3" Minimum="0" Maximum="100"
                       Visibility="Collapsed" Margin="0,8,0,0"/>
          <TextBlock x:Name="ReleaseLink" Visibility="Collapsed" FontSize="11" Margin="0,6,0,0">
            <Hyperlink Click="ReleaseLink_Click" Cursor="Hand"
                       Foreground="{DynamicResource Brush.Text.Secondary}" TextDecorations="Underline">
              <Run Text="{loc:Loc Key=Settings.ViewRelease}"/>
            </Hyperlink>
          </TextBlock>
          <CheckBox x:Name="AutoCheckUpdateBox" Content="{loc:Loc Key=Settings.AutoCheckUpdate}" Margin="0,8,0,2"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="AutoCheckUpdate_Changed" Unchecked="AutoCheckUpdate_Changed"/>
          <CheckBox x:Name="DeleteSetupAfterUpdateBox" Content="{loc:Loc Key=Settings.DeleteSetupAfterUpdate}" Margin="0,6,0,2"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="DeleteSetupAfterUpdate_Changed" Unchecked="DeleteSetupAfterUpdate_Changed"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
