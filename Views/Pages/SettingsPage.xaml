<UserControl x:Class="DesktopZones.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
             xmlns:components="clr-namespace:DesktopZones.Views.Components">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,12">
    <StackPanel>
      <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"
                 Foreground="{DynamicResource Brush.Text.Primary}"/>

      <!-- 常规 -->
      <TextBlock Text="常规" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel>
          <CheckBox x:Name="StartWithWindowsBox" Content="开机自启动" Margin="0,6,0,6"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>
          <CheckBox x:Name="StartMinimizedBox" Content="启动时最小化到托盘" Margin="0,6,0,6"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="StartMinimized_Changed" Unchecked="StartMinimized_Changed"/>
          <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="语言" VerticalAlignment="Center" Margin="0,0,0,0"
                       Foreground="{DynamicResource Brush.Text.Primary}"/>
            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="120"
                      SelectionChanged="Language_Changed">
              <ComboBoxItem Content="简体中文" Tag="zh"/>
              <ComboBoxItem Content="English" Tag="en"/>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 外观 -->
      <TextBlock Text="外观" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="主题" Margin="0,6,0,6"
                     Foreground="{DynamicResource Brush.Text.Primary}"/>
          <Border Background="{DynamicResource Brush.Bg.Input}" CornerRadius="4" Padding="2">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ThemeSystemRb" Content="跟随系统" GroupName="Theme" Style="{StaticResource SegmentItem}" Checked="ThemeRb_Changed"/>
              <RadioButton x:Name="ThemeLightRb"  Content="浅色"     GroupName="Theme" Style="{StaticResource SegmentItem}" Checked="ThemeRb_Changed"/>
              <RadioButton x:Name="ThemeDarkRb"   Content="深色"     GroupName="Theme" Style="{StaticResource SegmentItem}" Checked="ThemeRb_Changed"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 快捷键 -->
      <TextBlock Text="{loc:Loc Note.Hotkey}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel x:Name="HotkeyStack"/>
      </Border>

      <!-- 更新 -->
      <TextBlock Text="更新" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="检查更新" Foreground="{DynamicResource Brush.Text.Primary}"/>
            <TextBlock Text="已是最新版本 v0.9.0" FontSize="11" Margin="0,2,0,0"
                       Foreground="{DynamicResource Brush.Text.Tertiary}"/>
          </StackPanel>
          <Button Grid.Column="1" Content="检查更新" Click="CheckUpdate_Click" Cursor="Hand"
                  Background="{DynamicResource Brush.Accent.Solid}"
                  Foreground="{DynamicResource Brush.Accent.On}" FontWeight="SemiBold"
                  Padding="14,6" BorderThickness="0"/>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
