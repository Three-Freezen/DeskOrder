<UserControl x:Class="DesktopZones.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
             xmlns:components="clr-namespace:DesktopZones.Views.Components">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,12">
    <StackPanel>
      <TextBlock Text="{loc:Loc Key=Settings.PageTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"
                 Foreground="{DynamicResource Brush.Text.Primary}"/>

      <!-- 常规 -->
      <TextBlock Text="{loc:Loc Key=Settings.General}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border x:Name="GeneralSectionCard" Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel>
          <CheckBox x:Name="StartWithWindowsBox" Content="{loc:Loc Key=Settings.StartWithWindows}" Margin="0,6,0,6"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>
          <CheckBox x:Name="StartMinimizedBox" Content="{loc:Loc Key=Settings.StartMinimized}" Margin="0,6,0,6"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="StartMinimized_Changed" Unchecked="StartMinimized_Changed"/>
          <CheckBox x:Name="AutoAlignBox" Content="{loc:Loc Key=Settings.AutoAlign}" Margin="0,6,0,6"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="AutoAlign_Changed" Unchecked="AutoAlign_Changed"/>
          <CheckBox x:Name="ReverseSyncBox" Content="{loc:Loc Key=Settings.ReverseSync}" Margin="0,6,0,2"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="ReverseSync_Changed" Unchecked="ReverseSync_Changed"/>
          <TextBlock Text="{loc:Loc Key=Settings.ReverseSync.Hint}" FontSize="11" Margin="24,0,0,8"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
          <CheckBox x:Name="ImagePreviewBox" Content="{loc:Loc Key=Settings.ImagePreview}" Margin="0,6,0,2"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="ImagePreview_Changed" Unchecked="ImagePreview_Changed"/>
          <TextBlock Text="{loc:Loc Key=Settings.ImagePreview.Hint}" FontSize="11" Margin="24,0,0,8"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
          <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Loc Key=Settings.Language}" VerticalAlignment="Center" Margin="0,0,0,0"
                       Foreground="{DynamicResource Brush.Text.Primary}"/>
            <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="236"
                      SelectionChanged="Language_Changed"/>
          </Grid>
          <TextBlock x:Name="LanguageHint" FontSize="11" Margin="0,0,0,8"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- 插件：原本混在「常规」卡片里，v1.2.3 起独立成一栏（开关 / 启动加载 / 镜像 / 缓存 / 插件自带设置） -->
      <TextBlock x:Name="PluginsSectionHeader" Text="{loc:Loc Key=Settings.Plugins}" FontSize="11"
                 FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border x:Name="PluginsSectionCard" Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel>
          <CheckBox x:Name="PluginsEnabledBox" Content="{loc:Loc Key=Settings.Plugins.Enabled}" Margin="0,6,0,2"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="PluginsEnabled_Changed" Unchecked="PluginsEnabled_Changed"/>
          <TextBlock Text="{loc:Loc Key=Settings.Plugins.Hint}" FontSize="11" Margin="24,0,0,8"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>

          <!-- 启动时加载插件（只影响代码插件；语言包 / 外观包是纯数据，不受影响） -->
          <CheckBox x:Name="LoadPluginsAtStartupBox" Content="{loc:Loc Key=Settings.Plugins.LoadAtStartup}"
                    Margin="0,6,0,2" Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="LoadPluginsAtStartup_Changed" Unchecked="LoadPluginsAtStartup_Changed"/>
          <TextBlock Text="{loc:Loc Key=Settings.Plugins.LoadAtStartup.Hint}" FontSize="11" Margin="24,0,0,10"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>

          <!-- 索引镜像地址：留空 = 内置默认 registry；应用前会校验（https 或本机 http） -->
          <TextBlock Text="{loc:Loc Key=Settings.Plugins.Mirror}" Margin="0,0,0,6"
                     Foreground="{DynamicResource Brush.Text.Primary}"/>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MirrorUrlBox" Grid.Column="0" FontSize="11" Height="28" Padding="8,0"
                     VerticalAlignment="Center"/>
            <Button x:Name="MirrorApplyButton" Grid.Column="1" Content="{loc:Loc Key=Settings.Plugins.Mirror.Apply}"
                    Margin="8,0,0,0" VerticalAlignment="Center" Click="MirrorApply_Click"
                    FontSize="11" Padding="12,5" MinWidth="72" Style="{DynamicResource FillBtn}"/>
            <Button x:Name="MirrorResetButton" Grid.Column="2" Content="{loc:Loc Key=Settings.Plugins.Mirror.Reset}"
                    Margin="8,0,0,0" VerticalAlignment="Center" Click="MirrorReset_Click"
                    FontSize="11" Padding="12,5" MinWidth="72" Style="{DynamicResource OutlineBtn}"/>
          </Grid>
          <TextBlock x:Name="MirrorStatusText" FontSize="11" Margin="0,2,0,4"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"
                     Visibility="Collapsed"/>
          <!-- 默认地址在代码里带上 PluginCatalogService.DefaultRegistryUrl 填入，避免两处各写一份 -->
          <TextBlock x:Name="MirrorHintText" FontSize="11" Margin="0,0,0,10"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>

          <!-- 图片缓存：本地封面缩略图（按 URL SHA-1 缓存，LRU 上限 50 MB） -->
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=Settings.Plugins.Cache}"
                         Foreground="{DynamicResource Brush.Text.Primary}"/>
              <TextBlock x:Name="CacheSizeText" FontSize="11" Margin="0,2,0,0"
                         Foreground="{DynamicResource Brush.Text.Tertiary}"/>
            </StackPanel>
            <Button x:Name="ClearImageCacheButton" Grid.Column="1"
                    Content="{loc:Loc Key=Settings.Plugins.Cache.Clear}"
                    Margin="12,0,0,0" VerticalAlignment="Center" Click="ClearImageCache_Click"
                    FontSize="11" Padding="12,5" Style="{DynamicResource OutlineBtn}"/>
          </Grid>
          <TextBlock x:Name="ImageCacheStatusText" FontSize="11" Margin="0,0,0,8"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"
                     Visibility="Collapsed"/>

          <!-- API v5：已启用插件通过 host.Settings.Register 声明的设置项，由宿主统一渲染 -->
          <Grid Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=Settings.Plugins.Settings}"
                         Foreground="{DynamicResource Brush.Text.Primary}"/>
              <TextBlock x:Name="PluginSettingsHint" FontSize="11" Margin="0,2,0,0"
                         Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="PluginSettingsButton" Grid.Column="1"
                    Content="{loc:Loc Key=Settings.Plugins.Settings.Open}"
                    Margin="12,0,0,0" VerticalAlignment="Center" Click="OpenPluginSettings_Click"
                    FontSize="11" Padding="12,5" Style="{DynamicResource OutlineBtn}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- 次级分区 -->
      <TextBlock Text="{loc:Loc Key=Settings.Subfolder}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel>
          <Grid Margin="0,6,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Loc Key=Settings.Subfolder.ExpandCorner}" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Primary}"/>
            <ComboBox x:Name="ExpandCornerCombo" Grid.Column="1" Width="120"
                      SelectionChanged="ExpandCorner_Changed">
              <ComboBoxItem Content="{loc:Loc Key=Settings.Subfolder.Corner.TopLeft}" Tag="TopLeft"/>
              <ComboBoxItem Content="{loc:Loc Key=Settings.Subfolder.Corner.BottomLeft}" Tag="BottomLeft"/>
              <ComboBoxItem Content="{loc:Loc Key=Settings.Subfolder.Corner.TopRight}" Tag="TopRight"/>
              <ComboBoxItem Content="{loc:Loc Key=Settings.Subfolder.Corner.BottomRight}" Tag="BottomRight"/>
            </ComboBox>
          </Grid>
          <TextBlock Text="{loc:Loc Key=Settings.Subfolder.ExpandCorner.Hint}" FontSize="11" Margin="0,2,0,10"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
          <CheckBox x:Name="SquareSubfolderBox" Content="{loc:Loc Key=Settings.Subfolder.Square}" Margin="0,4,0,2"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="SquareSubfolder_Changed" Unchecked="SquareSubfolder_Changed"/>
          <TextBlock Text="{loc:Loc Key=Settings.Subfolder.Square.Hint}" FontSize="11" Margin="24,0,0,8"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- 外观 -->
      <TextBlock Text="{loc:Loc Key=Settings.Appearance}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{loc:Loc Key=Settings.Theme}" Margin="0,6,0,6"
                     Foreground="{DynamicResource Brush.Text.Primary}"/>
          <Border Background="{DynamicResource Brush.Bg.Input}" CornerRadius="4" Padding="2">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ThemeSystemRb" Content="{loc:Loc Key=Theme.System}" GroupName="Theme" Style="{StaticResource SegmentItem}" Checked="ThemeRb_Changed"/>
              <RadioButton x:Name="ThemeLightRb"  Content="{loc:Loc Key=Theme.Light}"  GroupName="Theme" Style="{StaticResource SegmentItem}" Checked="ThemeRb_Changed"/>
              <RadioButton x:Name="ThemeDarkRb"   Content="{loc:Loc Key=Theme.Dark}"   GroupName="Theme" Style="{StaticResource SegmentItem}" Checked="ThemeRb_Changed"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- 玻璃渲染方案 -->
      <TextBlock Text="{loc:Loc Key=Settings.Renderer}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel>
          <CheckBox x:Name="WallpaperRendererBox" Content="{loc:Loc Key=Settings.Renderer.Wallpaper}"
                    Margin="0,6,0,2" Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="WallpaperRenderer_Changed" Unchecked="WallpaperRenderer_Changed"/>
          <TextBlock Text="{loc:Loc Key=Settings.Renderer.Wallpaper.Hint}" FontSize="11" Margin="24,0,0,8"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
          <Grid Margin="24,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=Settings.Renderer.Source}" FontSize="11"
                         Foreground="{DynamicResource Brush.Text.Tertiary}"/>
              <TextBlock x:Name="WallpaperSourceText" Text="" FontSize="11" Margin="0,2,0,0"
                         Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="ResampleButton" Grid.Column="1" Content="{loc:Loc Key=Settings.Renderer.Resample}"
                    Margin="12,0,0,0" VerticalAlignment="Center"
                    Click="Resample_Click"
                    FontWeight="SemiBold" Padding="14,6" MinWidth="96"
                    Style="{DynamicResource FillBtn}"/>
          </Grid>
          <TextBlock x:Name="ResampleHintText" Text="{loc:Loc Key=Settings.Renderer.Resample.Hint}"
                     FontSize="11" Margin="24,0,0,6"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- 快捷键 -->
      <TextBlock Text="{loc:Loc Key=Note.Hotkey}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel x:Name="HotkeyStack"/>
      </Border>

      <!-- 更新 -->
      <TextBlock Text="{loc:Loc Key=Settings.Update}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,8"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <Border Background="{DynamicResource Brush.Bg.Surface}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
              CornerRadius="6" Padding="14,8" Margin="0,0,0,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{loc:Loc Key=Settings.CheckUpdate}" Foreground="{DynamicResource Brush.Text.Primary}"/>
              <TextBlock x:Name="UpdateStatusText" Text="{loc:Loc Key=Settings.UpToDate}" FontSize="11" Margin="0,2,0,0"
                         Foreground="{DynamicResource Brush.Text.Tertiary}"/>
            </StackPanel>
            <Button x:Name="UpdateButton" Grid.Column="1" Content="{loc:Loc Key=Settings.CheckUpdate}"
                    Click="UpdateButton_Click" Cursor="Hand"
                    FontWeight="SemiBold" Padding="14,6" MinWidth="96"
                    Style="{DynamicResource FillBtn}"/>
          </Grid>
          <ProgressBar x:Name="UpdateProgress" Height="3" Minimum="0" Maximum="100"
                       Visibility="Collapsed" Margin="0,8,0,0"/>
          <TextBlock x:Name="ReleaseLink" Visibility="Collapsed" FontSize="11" Margin="0,6,0,0">
            <Hyperlink Click="ReleaseLink_Click" Cursor="Hand"
                       Foreground="{DynamicResource Brush.Text.Secondary}" TextDecorations="Underline">
              <Run Text="{loc:Loc Key=Settings.ViewRelease}"/>
            </Hyperlink>
          </TextBlock>
          <CheckBox x:Name="AutoCheckUpdateBox" Content="{loc:Loc Key=Settings.AutoCheckUpdate}" Margin="0,8,0,2"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="AutoCheckUpdate_Changed" Unchecked="AutoCheckUpdate_Changed"/>
          <CheckBox x:Name="DeleteSetupAfterUpdateBox" Content="{loc:Loc Key=Settings.DeleteSetupAfterUpdate}" Margin="0,6,0,2"
                    Foreground="{DynamicResource Brush.Text.Primary}"
                    Checked="DeleteSetupAfterUpdate_Changed" Unchecked="DeleteSetupAfterUpdate_Changed"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
