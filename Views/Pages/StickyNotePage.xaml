<UserControl x:Class="DesktopZones.Views.Pages.StickyNotePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
             xmlns:components="clr-namespace:DesktopZones.Views.Components">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="20,16,20,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Text="{loc:Loc Manage.Notes}" FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
          <TextBlock x:Name="CountLabel" Margin="8,0,0,0" FontSize="11"
                     FontFamily="Cascadia Code, Consolas, monospace"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="SortBtn" Content="⇅ 名称" Click="SortBtn_Click" Cursor="Hand"
                  Background="Transparent" BorderThickness="0"
                  Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11"
                  Padding="8,6" ToolTip="排序方式"/>
          <Button Content="+ 新建便签" Click="NewNote_Click" Cursor="Hand" Margin="8,0,0,0"
                  Background="{DynamicResource Brush.Accent.Solid}"
                  Foreground="{DynamicResource Brush.Accent.On}" FontWeight="SemiBold"
                  Padding="14,6" BorderThickness="0"/>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,12">
      <Grid>
        <ItemsControl x:Name="ListHost">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <StackPanel x:Name="EmptyHint" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0">
          <TextBlock Text="还没有便签" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center"/>
          <TextBlock Text="点击右上方「+ 新建便签」" FontSize="11" Margin="0,8,0,0"
                     Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
