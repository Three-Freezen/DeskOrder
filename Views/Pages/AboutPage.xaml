<UserControl x:Class="DesktopZones.Views.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image Source="/Resources/Icons/icon-256.png" Width="96" Height="96"
             HorizontalAlignment="Center" Margin="0,0,0,16"/>
      <TextBlock Text="DeskOrder" FontSize="20" FontWeight="SemiBold"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource Brush.Text.Primary}"/>
      <TextBlock Text="v0.9.0" FontSize="12" FontFamily="Cascadia Code, Consolas, monospace"
                 HorizontalAlignment="Center" Margin="0,4,0,16"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
      <TextBlock Text="轻量级 Windows 桌面分区工具，帮助你用快捷键快速将窗口对齐到屏幕的固定区域。"
                 FontSize="13" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                 Margin="0,0,0,16"
                 Foreground="{DynamicResource Brush.Text.Secondary}"/>
      <TextBlock Text="WPF · .NET 10 · C# 12 · MIT License"
                 FontSize="11" FontFamily="Cascadia Code, Consolas, monospace"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource Brush.Text.Tertiary}"/>
    </StackPanel>
  </Grid>
</UserControl>
