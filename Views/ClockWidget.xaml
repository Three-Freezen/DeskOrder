<Window x:Class="DesktopZones.Views.ClockWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        xmlns:h="clr-namespace:DesktopZones.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True">

    <Grid>
        <!-- Main content wrapper -->
        <Border x:Name="MainContent" Visibility="Visible" ClipToBounds="True" CornerRadius="10">
            <Grid PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
                  PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown">
                <!-- Context menu on root Grid for full-area right-click -->
        <Grid.ContextMenu>
            <ContextMenu>
                <!-- ponytail 2026-08-27: 5 段结构 — 前 3 项(切换模式/秒/12-24h) /
                     设置 / 最小化 / 删除时钟。设置走 PropertyWindowService 与齿轮
                     入口对齐。删除时钟加二级确认。 -->
                <MenuItem x:Name="CtxSwitchMode" Header="{loc:Loc Key=Clock.AnalogMode}" Click="SwitchMode_Click"/>
                <MenuItem x:Name="CtxToggleSeconds" Header="{loc:Loc Key=Clock.HideSeconds}" Click="ToggleSeconds_Click"/>
                <MenuItem x:Name="CtxToggle24h" Header="{loc:Loc Key=Clock.Format12h}" Click="Toggle24h_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxSettings" Header="{loc:Loc Key=Clock.Settings}" Click="Settings_Click"/>
                <Separator/>
                <!-- ponytail 2026-08-27: 锁定/解锁 — 复用 LockBtn_Click; OnServiceLockChanged
                     / ApplyLockState 切锁定态同步菜单 Header;切语言后下次打开也会刷新。 -->
                <MenuItem x:Name="CtxLock" Header="{loc:Loc Key=Common.Lock}" Click="LockBtn_Click"/>
                <MenuItem x:Name="CtxMinimize" Header="{loc:Loc Key=Clock.Minimize}" Click="Minimize_Click"/>
                <MenuItem x:Name="CtxDelete" Header="{loc:Loc Key=Clock.Delete}" Click="Delete_Click" Foreground="#FF6666"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Main content wrapped in Border with rounded corners -->
        <Border x:Name="ClockBorder" CornerRadius="10"
                BorderBrush="#40FFFFFF" BorderThickness="1"
                Background="Transparent" Padding="0">
            <Grid>
                <!-- ponytail: separate Rectangle for fill color (mirrors ZoneWindow's FillRect).
                     Setting Border.Background inside a transparent window with AllowsTransparency=True
                     does NOT reliably re-render — the WPF visual cache holds the old brush. A
                     dedicated Rectangle child paints reliably when its Fill is reassigned. -->
                <Rectangle x:Name="FillRect" RadiusX="10" RadiusY="10"
                           Fill="#02000000" IsHitTestVisible="False"/>
                <!-- ponytail: 数字背景图全出血铺满整窗（位于 Margin 网格之下，文字/按钮之上），
                     MainContent 的圆角 + ClipToBounds 负责裁圆角。只在数字模式显示（ApplyMode 切换）。 -->
                <Border x:Name="DigitalBgBorder" ClipToBounds="True" IsHitTestVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Visibility="Collapsed">
                    <Image x:Name="DigitalBgImage" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Opacity="0" IsHitTestVisible="False"/>
                </Border>
                <Grid Margin="10">
                    <!-- Lock button (top-left, symmetric with HideBtn top-right) -->
                    <!-- ponytail: 小按钮统一口径 —— 平时无底盘方块(去掉了原来的 #01000000 方框),
                         悬停铺一层 #30FFFFFF 高光, 字色不随悬停变化; Style 置空绕开主题隐式样式。 -->
                    <Button x:Name="LockBtn" Content="🔓" Width="20" Height="20"
                        FontSize="10" Foreground="#60FFFFFF"
                        Background="Transparent" BorderThickness="0"
                        Template="{x:Static h:HoverHighlight.RoundedButtonTemplate}" h:HoverHighlight.IsEnabled="True"
                        Cursor="Hand" Click="LockBtn_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="6,0,0,0" Panel.ZIndex="10"/>

                    <!-- Hide button (top-right) -->
                    <Button x:Name="HideBtn" Content="─" Width="20" Height="20"
                        FontSize="10" Foreground="#60FFFFFF"
                        Background="Transparent" BorderThickness="0"
                        Template="{x:Static h:HoverHighlight.RoundedButtonTemplate}" h:HoverHighlight.IsEnabled="True"
                        Cursor="Hand" Click="HideBtn_Click"
                        MouseLeftButtonDown="HideBtn_MouseDown"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,0,6,0" Panel.ZIndex="10"/>

                <!-- Digital mode — Viewbox scales the text proportionally with the window,
                     so enlarging the clock also enlarges the time/date text in sync. -->
                <Viewbox x:Name="DigitalViewbox" Stretch="Uniform" Visibility="Visible">
                    <Grid x:Name="DigitalPanel" Width="300" Height="120">
                        <!-- Text content stacked vertically -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TimeText" Text="00:00:00"
                                       FontSize="48" FontWeight="Light"
                                       FontFamily="Segoe UI"
                                       Foreground="#EEFFFFFF"
                                       TextAlignment="Center"/>
                            <TextBlock x:Name="DateText" Text="2026-06-10"
                                       FontSize="16" Foreground="#AAFFFFFF"
                                       TextAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Viewbox>

                <!-- Analog mode — Viewbox scales the face proportionally with the window. -->
                <Viewbox x:Name="AnalogViewbox" Stretch="Uniform" Visibility="Collapsed">
                    <Grid x:Name="AnalogPanel" Width="220" Height="220">
                    <!-- Clock face background (Meridian: R110, 1px rim) -->
                    <Ellipse x:Name="AnalogFaceEllipse" Width="220" Height="220" Fill="#18000000"
                             Stroke="#2EFFFFFF" StrokeThickness="1"/>

                    <!-- Custom background image (clipped to clock circle) -->
                    <Canvas x:Name="AnalogBgClip" Width="220" Height="220" IsHitTestVisible="False"
                            ClipToBounds="True"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas.Clip>
                            <EllipseGeometry x:Name="AnalogBgClipGeo" Center="110,110" RadiusX="110" RadiusY="110"/>
                        </Canvas.Clip>
                        <Image x:Name="ClockBgImage" Width="220" Height="220" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Opacity="0" IsHitTestVisible="False"/>
                    </Canvas>

                    <!-- Meridian inner hairline, r92 -->
                    <Ellipse x:Name="AnalogInnerRing" Width="184" Height="184"
                             Fill="Transparent" Stroke="#0EFFFFFF" StrokeThickness="0.6"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsHitTestVisible="False"/>

                    <!-- Meridian markers generated into 3 frozen paths (minute / hour / cardinal) -->
                    <Canvas x:Name="MarkerCanvas" Width="220" Height="220" IsHitTestVisible="False">
                        <Path x:Name="MinuteTickPath" Stroke="#F2F7FF" StrokeThickness="0.55" Opacity="0.34"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="HourTickPath" Stroke="#F2F7FF" StrokeThickness="1.55" Opacity="0.88"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="CardinalTickPath" Stroke="#F2F7FF" StrokeThickness="2.15" Opacity="0.95"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="NorthIndexPath" Stroke="#4CC9F0" StrokeThickness="0.9" Opacity="0.85"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>

                    <!-- Hour hand: tapered, points to 12 at rest; rotate around (110,110). -->
                    <Polygon x:Name="HourHandShape" Fill="#FFFFFFFF"
                             Stroke="#FFFFFFFF" StrokeThickness="0.35" StrokeLineJoin="Round"
                             Points="110,56 112.3,110 110.5,119 109.5,119 107.7,110"
                             IsHitTestVisible="False">
                        <Polygon.RenderTransform>
                            <RotateTransform Angle="0" CenterX="110" CenterY="110"/>
                        </Polygon.RenderTransform>
                    </Polygon>

                    <!-- Minute hand: tapered, points to 12 at rest. -->
                    <Polygon x:Name="MinuteHandShape" Fill="#FFFFFFFF"
                             Stroke="#FFFFFFFF" StrokeThickness="0.35" StrokeLineJoin="Round"
                             Points="110,30 111.35,110 110.35,121 109.65,121 108.65,110"
                             IsHitTestVisible="False">
                        <Polygon.RenderTransform>
                            <RotateTransform Angle="0" CenterX="110" CenterY="110"/>
                        </Polygon.RenderTransform>
                    </Polygon>

                    <!-- Second hand + r72 signal dot rotate as one group. -->
                    <Canvas x:Name="SecondHandGroup" Width="220" Height="220" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <RotateTransform Angle="0" CenterX="110" CenterY="110"/>
                        </Canvas.RenderTransform>
                        <Line x:Name="SecondHand" X1="110" Y1="126" X2="110" Y2="20"
                              Stroke="#FFFF6666" StrokeThickness="0.9" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                        <Ellipse x:Name="SecondHandDot" Width="2.5" Height="2.5" Fill="#FFFF6666"
                                 Canvas.Left="108.75" Canvas.Top="36.75"/>
                    </Canvas>

                    <!-- Center cap -->
                    <Ellipse x:Name="CenterCap" Width="6.8" Height="6.8" Fill="#FFFFFFFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsHitTestVisible="False"/>
                    <Ellipse x:Name="CenterHole" Width="2.5" Height="2.5" Fill="#B0080A0F"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsHitTestVisible="False"/>
                </Grid>
                </Viewbox>
                </Grid>
            </Grid>
        </Border>

        <!-- ponytail: liquid-glass chromatic overlay — additive, never replaces
             ClockBorder's configured BorderBrush/BorderThickness. -->
        <Border x:Name="ClockGlassBorder" CornerRadius="10"
                Background="Transparent" BorderThickness="0"
                IsHitTestVisible="False" Panel.ZIndex="20"/>

        <!-- Four corner resize grips -->
        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="SizeNWSE" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="TL"/>
        <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="SizeNESW" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="TR"/>
        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Cursor="SizeNESW" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="BL"/>
        <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="SizeNWSE" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="BR"/>
            </Grid>
        </Border>

        <Border x:Name="RestoreButton"
                Visibility="Collapsed"
                Width="36" Height="36"
                CornerRadius="18"
                Background="{DynamicResource Menu.Bg.Surface}"
                BorderThickness="0"
                Cursor="Hand"
                MouseLeftButtonDown="Restore_MouseDown"
                MouseMove="Restore_MouseMove"
                MouseLeftButtonUp="Restore_MouseUp"
                MouseEnter="Restore_Enter" MouseLeave="Restore_Leave">
            <Grid>
                <Path x:Name="RestoreIconPath" Width="18" Height="18"
                      Stretch="Uniform" Stroke="#C0FFFFFF" StrokeThickness="1.5"
                      StrokeLineJoin="Round" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="RestoreIconChar" Text="🕐"
                           FontSize="18" Foreground="#C0FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
