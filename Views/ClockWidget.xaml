<Window x:Class="DesktopZones.Views.ClockWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True">

    <Grid>
        <!-- Main content wrapper -->
        <Border x:Name="MainContent" Visibility="Visible" ClipToBounds="True" CornerRadius="10">
            <Grid PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
                  PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown">
                <!-- Context menu on root Grid for full-area right-click -->
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="CtxSwitchMode" Header="Analog Mode" Click="SwitchMode_Click"/>
                <MenuItem x:Name="CtxToggleSeconds" Header="Hide Seconds" Click="ToggleSeconds_Click"/>
                <MenuItem x:Name="CtxToggle24h" Header="12-Hour" Click="Toggle24h_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxToggleRestore" Header="Disable Restore" Click="ToggleRestore_Click"/>
                <MenuItem x:Name="CtxDelete" Header="Delete Clock" Click="Delete_Click" Foreground="#FF6666"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Main content wrapped in Border with rounded corners -->
        <Border x:Name="ClockBorder" CornerRadius="10"
                BorderBrush="#40FFFFFF" BorderThickness="1"
                Background="Transparent" Padding="0">
            <Grid>
                <!-- ponytail: separate Rectangle for fill color (mirrors ZoneWindow's FillRect).
                     Setting Border.Background inside a transparent window with AllowsTransparency=True
                     does NOT reliably re-render — the WPF visual cache holds the old brush. A
                     dedicated Rectangle child paints reliably when its Fill is reassigned. -->
                <Rectangle x:Name="FillRect" RadiusX="10" RadiusY="10"
                           Fill="#02000000" IsHitTestVisible="False"/>
                <Grid Margin="10">
                    <!-- Lock button (top-left, symmetric with HideBtn top-right) -->
                    <Button x:Name="LockBtn" Content="🔓" Width="20" Height="20"
                        FontSize="10" Foreground="#60FFFFFF"
                        Background="#01000000" BorderThickness="0"
                        Cursor="Hand" Click="LockBtn_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8,4,0,0" Panel.ZIndex="10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                    <!-- Hide button (top-right) -->
                    <Button x:Name="HideBtn" Content="─" Width="20" Height="20"
                        FontSize="10" Foreground="#60FFFFFF"
                        Background="#01000000" BorderThickness="0"
                        Cursor="Hand" Click="HideBtn_Click"
                        MouseLeftButtonDown="HideBtn_MouseDown"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,4,8,0" Panel.ZIndex="10">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Digital mode -->
                <Grid x:Name="DigitalPanel" Visibility="Visible"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Digital background image -->
                    <Border x:Name="DigitalBgBorder" ClipToBounds="True" IsHitTestVisible="False"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Image x:Name="DigitalBgImage" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Opacity="0" IsHitTestVisible="False"/>
                    </Border>
                    <!-- Text content stacked vertically -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeText" Text="00:00:00"
                                   FontSize="48" FontWeight="Light"
                                   FontFamily="Segoe UI"
                                   Foreground="#EEFFFFFF"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="DateText" Text="2026-06-10"
                                   FontSize="16" Foreground="#AAFFFFFF"
                                   TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Analog mode -->
                <Grid x:Name="AnalogPanel" Visibility="Collapsed"
                      Width="200" Height="200"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Clock face background -->
                    <Ellipse x:Name="AnalogFaceEllipse" Width="200" Height="200" Fill="#18000000"
                             Stroke="#40FFFFFF" StrokeThickness="2"/>

                    <!-- Custom background image (clipped to clock circle) -->
                    <Canvas x:Name="AnalogBgClip" Width="200" Height="200" IsHitTestVisible="False"
                            ClipToBounds="True"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas.Clip>
                            <EllipseGeometry x:Name="AnalogBgClipGeo" Center="100,100" RadiusX="100" RadiusY="100"/>
                        </Canvas.Clip>
                        <Image x:Name="ClockBgImage" Width="200" Height="200" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Opacity="0" IsHitTestVisible="False"/>
                    </Canvas>

                    <!-- Markers generated programmatically -->
                    <Canvas x:Name="MarkerCanvas" Width="200" Height="200"/>

                    <!-- Hour hand (rotates around clock center 100,100) -->
                    <Line x:Name="HourHand" X1="100" Y1="100" X2="100" Y2="55"
                          Stroke="#FFFFFFFF" StrokeThickness="4" StrokeEndLineCap="Round"
                          StrokeStartLineCap="Round">
                        <Line.RenderTransform>
                            <RotateTransform Angle="0" CenterX="100" CenterY="100"/>
                        </Line.RenderTransform>
                    </Line>

                    <!-- Minute hand (rotates around clock center 100,100) -->
                    <Line x:Name="MinuteHand" X1="100" Y1="100" X2="100" Y2="30"
                          Stroke="#CCFFFFFF" StrokeThickness="2.5" StrokeEndLineCap="Round">
                        <Line.RenderTransform>
                            <RotateTransform Angle="0" CenterX="100" CenterY="100"/>
                        </Line.RenderTransform>
                    </Line>

                    <!-- Second hand (rotates around clock center 100,100) -->
                    <Line x:Name="SecondHand" X1="100" Y1="110" X2="100" Y2="22"
                          Stroke="#FFFF6666" StrokeThickness="1">
                        <Line.RenderTransform>
                            <RotateTransform Angle="0" CenterX="100" CenterY="100"/>
                        </Line.RenderTransform>
                    </Line>

                    <!-- Center dot -->
                    <Ellipse Width="10" Height="10" Fill="#FFFFFFFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5"/>

                    <!-- Date window -->
                    <Border x:Name="DateWindowBorder" Width="36" Height="20" CornerRadius="4"
                            Background="#20FFFFFF" BorderBrush="#40FFFFFF"
                            BorderThickness="0.5"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,30,0">
                        <TextBlock x:Name="AnalogDateText" Text="10"
                                   FontSize="11" Foreground="#AAFFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Four corner resize grips -->
        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                Cursor="SizeNWSE" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="TL"/>
        <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                Cursor="SizeNESW" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="TR"/>
        <Border Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Cursor="SizeNESW" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="BL"/>
        <Border Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Cursor="SizeNWSE" Background="Transparent"
                MouseLeftButtonDown="ResizeGrip_Down" Tag="BR"/>
            </Grid>
        </Border>

        <Border x:Name="RestoreButton"
                Visibility="Collapsed"
                Width="36" Height="36"
                CornerRadius="18"
                Background="#DD1A1A2E"
                BorderThickness="0"
                Cursor="Hand"
                MouseLeftButtonDown="Restore_MouseDown"
                MouseMove="Restore_MouseMove"
                MouseLeftButtonUp="Restore_MouseUp"
                MouseEnter="Restore_Enter" MouseLeave="Restore_Leave">
            <TextBlock x:Name="RestoreIconChar" Text="🕐"
                       FontSize="18" Foreground="#C0FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
