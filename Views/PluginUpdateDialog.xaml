<Window x:Class="DesktopZones.Views.PluginUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Width="620" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="12"
          BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
    <Grid Margin="22,18,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
        <TextBlock Text="{loc:Loc Key=Plugin.Update.Title}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text.Primary}"/>
      </Grid>

      <StackPanel Grid.Row="1" Margin="0,14,0,0">
        <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}"/>
        <TextBlock x:Name="VersionText" Margin="0,5,0,0" FontSize="12"
                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
      </StackPanel>

      <StackPanel Grid.Row="2" Margin="0,14,0,0">
        <TextBlock Text="{loc:Loc Key=Plugin.Update.Changelog}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"/>
        <Border Margin="0,6,0,0" Padding="10,8" CornerRadius="6" MaxHeight="180"
                Background="{DynamicResource Brush.Bg.Surface}" BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border.Subtle}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="ChangelogText" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
          </ScrollViewer>
        </Border>
        <!-- 一个包多类型：新版本比旧版本多了能力时在这里显式提示（不额外增加勾选门槛）。 -->
        <Border x:Name="KindsBar" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,7"
                CornerRadius="6" Background="{DynamicResource Brush.Accent.Wash}">
          <TextBlock x:Name="AddedKindsText" FontSize="11.5" TextWrapping="Wrap" LineHeight="18"
                     Foreground="{DynamicResource Brush.Accent}"/>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="3" Margin="0,14,0,0">
        <TextBlock Text="{loc:Loc Key=Plugin.Update.Permissions}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"/>
        <StackPanel x:Name="PermissionsHost" Margin="0,6,0,0"/>
      </StackPanel>

      <CheckBox x:Name="ConsentCheck" Grid.Row="4" Margin="0,12,0,0" FontSize="12"
                Cursor="Hand" Visibility="Collapsed"
                Foreground="{DynamicResource Brush.Text.Primary}"
                Checked="ConsentCheck_Changed" Unchecked="ConsentCheck_Changed"/>

      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="{loc:Loc Key=Common.Cancel}" Width="92" Height="32" Cursor="Hand"
                Style="{DynamicResource OutlineBtn}" Click="Cancel_Click"/>
        <Button x:Name="UpdateButton" Content="{loc:Loc Key=Plugin.Update}" Width="92" Height="32"
                Margin="10,0,0,0" Cursor="Hand" FontWeight="SemiBold"
                Style="{DynamicResource FillBtn}" Click="Update_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
