<Window x:Class="DesktopZones.Views.PluginBatchUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Width="620" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" MaxHeight="760">
  <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="12"
          BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
    <Grid Margin="22,18,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
        <TextBlock Text="{loc:Loc Key=Plugin.Batch.Title}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text.Primary}"/>
      </Grid>

      <!-- 汇总：将依次更新 N 个插件（逐条列出名称 / 版本 / changelog / 权限变化）。 -->
      <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,10,0,0" FontSize="12"
                 TextWrapping="Wrap" LineHeight="19"
                 Foreground="{DynamicResource Brush.Text.Secondary}"/>

      <!-- 需逐个确认（新增联网权限）的提示条：这些条目不会进入批量。 -->
      <Border x:Name="ConsentBar" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0"
              Padding="10,7" CornerRadius="6" Background="#14FFB020"
              BorderBrush="#40FFB020" BorderThickness="1">
        <TextBlock x:Name="ConsentBarText" FontSize="11.5" TextWrapping="Wrap" LineHeight="18"
                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
      </Border>

      <Border Grid.Row="3" Margin="0,12,0,0" Padding="2,2,2,2" CornerRadius="6"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ItemsHost" Margin="8,8,8,4"/>
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="{loc:Loc Key=Common.Cancel}" Width="92" Height="32" Cursor="Hand"
                Style="{DynamicResource OutlineBtn}" Click="Cancel_Click"/>
        <Button x:Name="ConfirmButton" Width="132" Height="32" Margin="10,0,0,0" Cursor="Hand"
                FontWeight="SemiBold" Style="{DynamicResource FillBtn}" Click="Confirm_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
