<Window x:Class="DesktopZones.Views.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <!-- ponytail 2026-08-24: locked dark-theme dropdown chrome. The sticky note
             sits over user-picked fill colors (yellow / custom image / etc.) so its
             own chrome ignores the management interface theme palette; the dropdowns
             (font size + font color picker) need a stable dark background that
             stays readable regardless of the surrounding note color. These
             brushes intentionally mirror Theme.Colors.Dark.xaml hex values and
             are NOT bound to Brush.* — when the management UI flips to Light/HC
             the dropdowns keep this dark look. -->
        <SolidColorBrush x:Key="LockedDark.Bg"        Color="#262626"/>
        <SolidColorBrush x:Key="LockedDark.Input"     Color="#2A2A2A"/>
        <SolidColorBrush x:Key="LockedDark.Border"    Color="#454545"/>
        <SolidColorBrush x:Key="LockedDark.BgHover"   Color="#2E2E2E"/>
        <SolidColorBrush x:Key="LockedDark.Text"      Color="#ECECEC"/>
        <SolidColorBrush x:Key="LockedDark.TextDim"   Color="#A8A8A8"/>
        <SolidColorBrush x:Key="LockedDark.Accent"    Color="#2E97F0"/>
        <SolidColorBrush x:Key="LockedDark.AccentWash" Color="#242E97F0"/>
    </Window.Resources>
    <Grid>
        <!-- Main content wrapper -->
        <Border x:Name="MainContent" Visibility="Visible" ClipToBounds="True" CornerRadius="10">
            <Grid>
                <Border x:Name="NoteBorder" CornerRadius="10"
                        BorderBrush="#40FFFFFF" BorderThickness="1">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="CtxToggleRestore" Header="Disable Restore" Click="ToggleRestore_Click"/>
                    <Separator/>
                    <MenuItem x:Name="CtxDelete" Header="Delete Note" Click="Delete_Click" Foreground="#FF6666"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Body fill (excludes the title bar when TitleBarFillIndependent) -->
                <Rectangle x:Name="BodyFillRect" Grid.RowSpan="3" IsHitTestVisible="False"
                           Fill="#08000000"/>

                <!-- Background image -->
                <Border x:Name="NoteBgBorder" Grid.RowSpan="3" ClipToBounds="True" IsHitTestVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Image x:Name="NoteBgImage" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Opacity="0" IsHitTestVisible="False"/>
                </Border>

                <!-- Title bar -->
                <Border x:Name="TitleBarBorder" Grid.Row="0" Height="28" CornerRadius="10,10,0,0"
                        Cursor="SizeAll" MouseLeftButtonDown="TitleBar_Drag"
                        Background="#20000000">
                    <Grid>
                        <TextBox x:Name="TitleBox" Text="Note"
                                 FontSize="12" Foreground="#E0E0E0"
                                 Background="Transparent" BorderThickness="0"
                                 CaretBrush="#E0E0E0"
                                 VerticalAlignment="Center" HorizontalAlignment="Left"
                                 Width="120" Margin="10,0,0,0"
                                 MaxWidth="180"
                                 LostFocus="TitleBox_LostFocus"
                                 KeyDown="TitleBox_KeyDown"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                            <Button x:Name="LockBtn" Content="🔓" Width="20" Height="20"
                                    FontSize="10"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Click="LockBtn_Click" Margin="3,0,0,0"
                                    Foreground="#80FFFFFF"
                                    MouseEnter="LockBtn_Enter" MouseLeave="LockBtn_Leave"/>
                            <Button x:Name="SaveBtn" Content="💾" Width="20" Height="20"
                                    FontSize="10"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Click="SaveBtn_Click" Margin="3,0,0,0"
                                    Foreground="#80FFFFFF"
                                    MouseEnter="SaveBtn_Enter" MouseLeave="SaveBtn_Leave"/>
                            <Button x:Name="PinBtn" Content="📌" Width="20" Height="20"
                                    FontSize="10"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Click="PinBtn_Click" Margin="3,0,0,0"
                                    Foreground="#80FFFFFF"
                                    MouseEnter="PinBtn_Enter" MouseLeave="PinBtn_Leave"/>
                            <Button x:Name="HideBtn" Content="─" Width="20" Height="20"
                                    FontSize="11" Foreground="#80FFFFFF"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Click="HideBtn_Click" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Formatting toolbar -->
                <Border Grid.Row="1" Background="#10000000" Padding="4,2">
                    <StackPanel Orientation="Horizontal">
                        <!-- Font Size — locked white regardless of adaptive: the number itself
                             (10/12/14/…) is a label, not an icon, and shouldn't compete with bg.
                             ponytail 2026-08-24: chrome locked to dark-theme hex via Window.Resources
                             LockedDark.* brushes (independent of ThemeService). ComboBoxItems get a
                             local Style override that mirrors the dark-theme hover/selected states
                             so the dropdown stays consistently dark even when the management UI
                             flips to Light/HC. -->
                        <ComboBox x:Name="FontSizeCombo" Width="50" Height="22"
                                   FontSize="11" Foreground="#FFFFFF"
                                   Background="{StaticResource LockedDark.Input}"
                                   BorderBrush="{StaticResource LockedDark.Border}"
                                   BorderThickness="1" Padding="2,0"
                                   SelectedIndex="2"
                                   SelectionChanged="FontSizeCombo_SelectionChanged">
                            <ComboBox.Resources>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource LockedDark.Text}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource LockedDark.BgHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource LockedDark.AccentWash}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="10" Tag="10"/>
                            <ComboBoxItem Content="12" Tag="12"/>
                            <ComboBoxItem Content="14" Tag="14"/>
                            <ComboBoxItem Content="16" Tag="16"/>
                            <ComboBoxItem Content="18" Tag="18"/>
                            <ComboBoxItem Content="20" Tag="20"/>
                            <ComboBoxItem Content="24" Tag="24"/>
                            <ComboBoxItem Content="28" Tag="28"/>
                            <ComboBoxItem Content="32" Tag="32"/>
                            <ComboBoxItem Content="36" Tag="36"/>
                            <ComboBoxItem Content="48" Tag="48"/>
                        </ComboBox>

                        <Rectangle Width="1" Fill="#20FFFFFF" Margin="4,2"/>

                        <!-- Bold -->
                        <Button x:Name="BoldBtn" Content="B" Width="24" Height="24"
                                FontSize="12" FontWeight="Bold"
                                Foreground="#E0E0E0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="BoldBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Italic -->
                        <Button x:Name="ItalicBtn" Content="I" Width="24" Height="24"
                                FontSize="12" FontStyle="Italic"
                                Foreground="#E0E0E0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="ItalicBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Underline -->
                        <Button x:Name="UnderlineBtn" Content="U" Width="24" Height="24"
                                FontSize="12"
                                Foreground="#E0E0E0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="UnderlineBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <!-- ponytail: no Foreground here — explicit local value would
                                         override the inherited Button.Foreground and block the
                                         adaptive color refresh. -->
                                    <TextBlock Text="U" FontSize="12"
                                               TextDecorations="Underline"/>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <Rectangle Width="1" Fill="#20FFFFFF" Margin="4,2"/>

                        <!-- Font Color -->
                        <Button x:Name="FontColorBtn" Content="A" Width="24" Height="24"
                                FontSize="12" FontWeight="Bold"
                                Foreground="#E0E0E0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="FontColorBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Popup x:Name="FontColorPopup" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=FontColorBtn}"
                               Placement="Bottom" AllowsTransparency="True">
                            <!-- ponytail 2026-08-24: popup chrome uses LockedDark.* brushes from
                                 Window.Resources (independent of ThemeService). Preset swatch
                                 Background values stay hardcoded — they ARE the colors they
                                 represent. Preset borders + ColorCustomBtn all use the same
                                 locked brushes so the popup looks consistent regardless of
                                 the management interface theme. -->
                            <Border Background="{StaticResource LockedDark.Bg}" CornerRadius="8"
                                    BorderBrush="{StaticResource LockedDark.Border}" BorderThickness="1"
                                    Padding="8">
                                <StackPanel>
                                    <TextBlock Text="Text Color" FontSize="10"
                                               Foreground="{StaticResource LockedDark.TextDim}" Margin="0,0,0,6"/>
                                    <WrapPanel x:Name="ColorPresetsPanel" Width="200">
                                        <Border x:Name="PresetTransparent" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,0,4,4" Cursor="Hand" Tag="#01000000"
                                                BorderBrush="{StaticResource LockedDark.Border}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorPreset_Click" ToolTip="Transparent">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#CCCCCC" Offset="0.5"/>
                                                    <GradientStop Color="#FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="PresetBlack" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,0,4,4" Cursor="Hand" Tag="#000000"
                                                Background="#000000" BorderBrush="{StaticResource LockedDark.Border}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorPreset_Click"/>
                                        <Border x:Name="PresetWhite" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,0,4,4" Cursor="Hand" Tag="#FFFFFF"
                                                Background="#FFFFFF" BorderBrush="{StaticResource LockedDark.Border}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorPreset_Click"/>
                                        <Border x:Name="PresetGray" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,0,4,4" Cursor="Hand" Tag="#808080"
                                                Background="#808080" BorderBrush="{StaticResource LockedDark.Border}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorPreset_Click"/>
                                        <Border x:Name="PresetRed" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,0,4,4" Cursor="Hand" Tag="#FF0000"
                                                Background="#FF0000" BorderBrush="{StaticResource LockedDark.Border}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorPreset_Click"/>
                                        <Border x:Name="PresetOrange" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,0,4,4" Cursor="Hand" Tag="#FF7D00"
                                                Background="#FF7D00" BorderBrush="{StaticResource LockedDark.Border}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorPreset_Click"/>
                                        <Border x:Name="PresetYellow" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,0,4,4" Cursor="Hand" Tag="#FFFF00"
                                                Background="#FFFF00" BorderBrush="{StaticResource LockedDark.Border}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorPreset_Click"/>
                                        <Border x:Name="PresetGreen" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,0,4,4" Cursor="Hand" Tag="#00FF00"
                                                Background="#00FF00" BorderBrush="{StaticResource LockedDark.Border}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorPreset_Click"/>
                                        <Border x:Name="PresetBlue" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,0,4,4" Cursor="Hand" Tag="#0000FF"
                                                Background="#0000FF" BorderBrush="{StaticResource LockedDark.Border}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorPreset_Click"/>
                                        <Border x:Name="PresetIndigo" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,0,4,4" Cursor="Hand" Tag="#00FFFF"
                                                Background="#00FFFF" BorderBrush="{StaticResource LockedDark.Border}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorPreset_Click"/>
                                        <Border x:Name="PresetViolet" Width="24" Height="24" CornerRadius="12"
                                                Margin="0,0,4,4" Cursor="Hand" Tag="#FF00FF"
                                                Background="#FF00FF" BorderBrush="{StaticResource LockedDark.Border}" BorderThickness="1"
                                                MouseLeftButtonDown="ColorPreset_Click"/>
                                        <!-- Custom -->
                                        <Button x:Name="ColorCustomBtn" Content="..." Width="24" Height="24"
                                                FontSize="9" Foreground="{StaticResource LockedDark.TextDim}"
                                                Background="{StaticResource LockedDark.Input}" BorderBrush="{StaticResource LockedDark.Border}"
                                                BorderThickness="1" Cursor="Hand"
                                                Click="ColorCustomBtn_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="12"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>

                <!-- Content area (RichTextBox for per-character formatting) -->
                <RichTextBox x:Name="ContentBox" Grid.Row="2"
                             FontSize="14" Foreground="#E0E0E0"
                             Background="Transparent" BorderThickness="0"
                             CaretBrush="#E0E0E0"
                             VerticalScrollBarVisibility="Hidden"
                             Margin="8,4,8,8" MinHeight="100"
                             AcceptsTab="True"
                             SelectionChanged="ContentBox_SelectionChanged"
                             TextChanged="ContentBox_TextChanged"
                             PreviewTextInput="ContentBox_TextInput"/>
            </Grid>
        </Border>

                <!-- Four corner resize grips -->
                <Border x:Name="GripTL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Cursor="SizeNWSE" Background="Transparent"
                        MouseLeftButtonDown="ResizeGrip_Down" Tag="TL"/>
                <Border x:Name="GripTR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Cursor="SizeNESW" Background="Transparent"
                        MouseLeftButtonDown="ResizeGrip_Down" Tag="TR"/>
                <Border x:Name="GripBL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Cursor="SizeNESW" Background="Transparent"
                        MouseLeftButtonDown="ResizeGrip_Down" Tag="BL"/>
                <Border x:Name="GripBR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Cursor="SizeNWSE" Background="Transparent"
                        MouseLeftButtonDown="ResizeGrip_Down" Tag="BR"/>
            </Grid>
        </Border>

        <!-- Restore button (minimized state) -->
        <Border x:Name="RestoreButton"
                Visibility="Collapsed"
                Width="36" Height="36"
                CornerRadius="18"
                Background="#DD1A1A2E"
                BorderThickness="0"
                Cursor="Hand"
                MouseLeftButtonDown="Restore_MouseDown"
                MouseMove="Restore_MouseMove"
                MouseLeftButtonUp="Restore_MouseUp"
                MouseEnter="Restore_Enter" MouseLeave="Restore_Leave">
            <TextBlock x:Name="RestoreIconChar" Text="📝"
                       FontSize="18" Foreground="#C0FFFFFF"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
