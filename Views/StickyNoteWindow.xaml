<Window x:Class="DesktopZones.Views.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="False"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown">
    <Grid>
        <!-- Main content wrapper -->
        <Border x:Name="MainContent" Visibility="Visible" ClipToBounds="True" CornerRadius="10">
            <Grid>
                <Border x:Name="NoteBorder" CornerRadius="10"
                        BorderBrush="#40FFFFFF" BorderThickness="1">
            <Border.ContextMenu>
                <ContextMenu>
                    <!-- ponytail 2026-08-28: 6 段结构 — 置顶 / 保存·另存为·打开文件 /
                         设置 / 最小化 / 删除便签。保存组直接绑定 💾 按钮同款功能。
                         关闭/开启可恢复按钮选项已删除;设置走 PropertyWindowService
                         与齿轮入口对齐。删除便签加二级确认。 -->
                    <MenuItem x:Name="CtxPinTop" Header="{loc:Loc Key=Note.PinTop}" Click="PinTop_Click"/>
                    <Separator/>
                    <MenuItem x:Name="CtxSave" Header="{loc:Loc Key=Note.Save}" Click="CtxSave_Click"/>
                    <MenuItem x:Name="CtxSaveAs" Header="{loc:Loc Key=Note.SaveAs}" Click="CtxSaveAs_Click"/>
                    <MenuItem x:Name="CtxOpenFile" Header="{loc:Loc Key=Note.OpenFile}" Click="CtxOpenFile_Click"/>
                    <Separator/>
                    <MenuItem x:Name="CtxSettings" Header="{loc:Loc Key=Note.Settings}" Click="Settings_Click"/>
                    <Separator/>
                    <!-- ponytail 2026-08-27: 锁定/解锁 — 复用 LockBtn_Click; 锁定态变化时
                         ApplyLockState 同步菜单 Header;切语言后下次打开也会刷新。 -->
                    <MenuItem x:Name="CtxLock" Header="{loc:Loc Key=Common.Lock}" Click="LockBtn_Click"/>
                    <MenuItem x:Name="CtxMinimize" Header="{loc:Loc Key=Note.Minimize}" Click="Minimize_Click"/>
                    <MenuItem x:Name="CtxDelete" Header="{loc:Loc Key=Note.Delete}" Click="Delete_Click" Foreground="#FF6666"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Body fill (excludes the title bar when TitleBarFillIndependent) -->
                <Rectangle x:Name="BodyFillRect" Grid.RowSpan="3" IsHitTestVisible="False"
                           Fill="#08000000"/>

                <!-- Background image -->
                <Border x:Name="NoteBgBorder" Grid.RowSpan="3" ClipToBounds="True" IsHitTestVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Image x:Name="NoteBgImage" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Opacity="0" IsHitTestVisible="False"/>
                </Border>

                <!-- Title bar -->
                <Border x:Name="TitleBarBorder" Grid.Row="0" Height="28" CornerRadius="10,10,0,0"
                        Cursor="SizeAll" MouseLeftButtonDown="TitleBar_Drag"
                        Background="#20000000">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" Margin="10,0,0,0">
                            <Path x:Name="TitleIconPath" Width="12" Height="12"
                                  Stretch="Uniform" Stroke="#E0E0E0" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" VerticalAlignment="Center"
                                  Margin="0,0,4,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TitleIconChar" Text="" FontSize="12"
                                       Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="TitleBox" Text="Note"
                                     FontSize="12" Foreground="#E0E0E0"
                                     Background="Transparent" BorderThickness="0"
                                     CaretBrush="#E0E0E0"
                                     VerticalAlignment="Center" HorizontalAlignment="Left"
                                     Width="120"
                                     MaxWidth="180"
                                     PreviewMouseLeftButtonDown="TitleBox_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="TitleBox_PreviewMouseMove"
                                     LostFocus="TitleBox_LostFocus"
                                     KeyDown="TitleBox_KeyDown"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                            <Button x:Name="LockBtn" Content="🔓" Width="20" Height="20"
                                    FontSize="10"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Click="LockBtn_Click" Margin="3,0,0,0"
                                    Foreground="#80FFFFFF"
                                    MouseEnter="LockBtn_Enter" MouseLeave="LockBtn_Leave"/>
                            <Button x:Name="SaveBtn" Content="💾" Width="20" Height="20"
                                    FontSize="10"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Click="SaveBtn_Click" Margin="3,0,0,0"
                                    Foreground="#80FFFFFF"
                                    MouseEnter="SaveBtn_Enter" MouseLeave="SaveBtn_Leave"/>
                            <Button x:Name="PinBtn" Content="📌" Width="20" Height="20"
                                    FontSize="10"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Click="PinBtn_Click" Margin="3,0,0,0"
                                    Foreground="#80FFFFFF"
                                    MouseEnter="PinBtn_Enter" MouseLeave="PinBtn_Leave"/>
                            <Button x:Name="HideBtn" Content="─" Width="20" Height="20"
                                    FontSize="11" Foreground="#80FFFFFF"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Click="HideBtn_Click" Margin="3,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Formatting toolbar -->
                <Border x:Name="ToolbarBorder" Grid.Row="1" Background="#10000000" Padding="4,2">
                    <StackPanel Orientation="Horizontal">
                        <!-- Font Size — 跟随系统深浅色(Menu.* 调色板)，与管理界面主题解耦。 -->
                        <ComboBox x:Name="FontSizeCombo" Width="50" Height="22"
                                   FontSize="11"
                                   Style="{DynamicResource Menu.ComboBox}"
                                   ItemContainerStyle="{DynamicResource Menu.ComboBoxItem}"
                                   Padding="2,0"
                                   SelectedIndex="2"
                                   SelectionChanged="FontSizeCombo_SelectionChanged">
                            <ComboBoxItem Content="10" Tag="10"/>
                            <ComboBoxItem Content="12" Tag="12"/>
                            <ComboBoxItem Content="14" Tag="14"/>
                            <ComboBoxItem Content="16" Tag="16"/>
                            <ComboBoxItem Content="18" Tag="18"/>
                            <ComboBoxItem Content="20" Tag="20"/>
                            <ComboBoxItem Content="24" Tag="24"/>
                            <ComboBoxItem Content="28" Tag="28"/>
                            <ComboBoxItem Content="32" Tag="32"/>
                            <ComboBoxItem Content="36" Tag="36"/>
                            <ComboBoxItem Content="48" Tag="48"/>
                        </ComboBox>

                        <Rectangle Width="1" Fill="#20FFFFFF" Margin="4,2"/>

                        <!-- Bold -->
                        <Button x:Name="BoldBtn" Content="B" Width="24" Height="24"
                                FontSize="12" FontWeight="Bold"
                                Foreground="#E0E0E0"
                                Background="Transparent" BorderThickness="0"
                                Focusable="False"
                                Cursor="Hand" Click="BoldBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Italic -->
                        <Button x:Name="ItalicBtn" Content="I" Width="24" Height="24"
                                FontSize="12" FontStyle="Italic"
                                Foreground="#E0E0E0"
                                Background="Transparent" BorderThickness="0"
                                Focusable="False"
                                Cursor="Hand" Click="ItalicBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Underline -->
                        <Button x:Name="UnderlineBtn" Content="U" Width="24" Height="24"
                                FontSize="12"
                                Foreground="#E0E0E0"
                                Background="Transparent" BorderThickness="0"
                                Focusable="False"
                                Cursor="Hand" Click="UnderlineBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <!-- ponytail: no Foreground here — explicit local value would
                                         override the inherited Button.Foreground and block the
                                         adaptive color refresh. -->
                                    <TextBlock Text="U" FontSize="12"
                                               TextDecorations="Underline"/>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>

                        <Rectangle Width="1" Fill="#20FFFFFF" Margin="4,2"/>

                        <!-- Font Color -->
                        <Button x:Name="FontColorBtn" Content="A" Width="24" Height="24"
                                FontSize="12" FontWeight="Bold"
                                Foreground="#E0E0E0"
                                Background="Transparent" BorderThickness="0"
                                Focusable="False"
                                Cursor="Hand" Click="FontColorBtn_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Popup x:Name="FontColorPopup" StaysOpen="True"
                               PlacementTarget="{Binding ElementName=FontColorBtn}"
                               Placement="Bottom" AllowsTransparency="True">
                            <!-- ponytail 2026-08-28: StaysOpen=True — 与 ZoneWindow 的
                                 SubfolderFlyoutPopup 同款。StaysOpen=False 的 Popup 会
                                 抢鼠标捕获,透明窗口里的色块收不到点击。关闭由窗口级
                                 PreviewMouseLeftButtonDown / Deactivated / HideNote 手动
                                 管理。配色跟随系统深浅色(Menu.* 调色板),与分区右键菜单
                                 对齐:预设标签 + 6×2 圆角小方块网格(代码构建) + 分隔线
                                 + 全宽自定义按钮。 -->
                            <Border Background="{DynamicResource Menu.Bg.Surface}" CornerRadius="6"
                                    BorderBrush="{DynamicResource Menu.Border.Subtle}" BorderThickness="1"
                                    Padding="6" MinWidth="220">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Common.Preset}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Menu.Text.Secondary}" Margin="4,2,0,4"/>
                                    <UniformGrid x:Name="ColorPresetsPanel" Columns="6" Rows="2"/>
                                    <Separator Margin="0,4" Background="{DynamicResource Menu.Separator}"/>
                                    <Border x:Name="ColorCustomBtn"
                                            Background="{DynamicResource Menu.Bg.Hover}"
                                            BorderBrush="{DynamicResource Menu.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            HorizontalAlignment="Stretch" Padding="8,6" Cursor="Hand">
                                        <TextBlock Text="{loc:Loc Key=Common.Custom}"
                                                   Foreground="{DynamicResource Menu.Text.Primary}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>

                <!-- Content area (RichTextBox for per-character formatting) -->
                <RichTextBox x:Name="ContentBox" Grid.Row="2"
                             FontSize="14" Foreground="#E0E0E0"
                             Background="Transparent" BorderThickness="0"
                             CaretBrush="#E0E0E0"
                             VerticalScrollBarVisibility="Hidden"
                             Margin="8,4,8,8" MinHeight="100"
                             AcceptsTab="True"
                             SelectionChanged="ContentBox_SelectionChanged"
                             PreviewKeyDown="ContentBox_PreviewKeyDown"
                             PreviewMouseLeftButtonDown="ContentBox_PreviewMouseLeftButtonDown"
                             PreviewTextInput="ContentBox_PreviewTextInput"
                             TextChanged="ContentBox_TextChanged"/>
            </Grid>
        </Border>

        <!-- ponytail: liquid-glass chromatic overlay — additive, never replaces
             NoteBorder's configured BorderBrush/BorderThickness. -->
        <Border x:Name="NoteGlassBorder" CornerRadius="10"
                Background="Transparent" BorderThickness="0"
                IsHitTestVisible="False" Panel.ZIndex="20"/>

                <!-- Four corner resize grips -->
                <Border x:Name="GripTL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Cursor="SizeNWSE" Background="Transparent"
                        MouseLeftButtonDown="ResizeGrip_Down" Tag="TL"/>
                <Border x:Name="GripTR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Cursor="SizeNESW" Background="Transparent"
                        MouseLeftButtonDown="ResizeGrip_Down" Tag="TR"/>
                <Border x:Name="GripBL" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Cursor="SizeNESW" Background="Transparent"
                        MouseLeftButtonDown="ResizeGrip_Down" Tag="BL"/>
                <Border x:Name="GripBR" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Cursor="SizeNWSE" Background="Transparent"
                        MouseLeftButtonDown="ResizeGrip_Down" Tag="BR"/>
            </Grid>
        </Border>

        <!-- Restore button (minimized state) -->
        <Border x:Name="RestoreButton"
                Visibility="Collapsed"
                Width="36" Height="36"
                CornerRadius="18"
                Background="{DynamicResource Menu.Bg.Surface}"
                BorderThickness="0"
                Cursor="Hand"
                MouseLeftButtonDown="Restore_MouseDown"
                MouseMove="Restore_MouseMove"
                MouseLeftButtonUp="Restore_MouseUp"
                MouseEnter="Restore_Enter" MouseLeave="Restore_Leave">
            <Grid>
                <Path x:Name="RestoreIconPath" Width="18" Height="18"
                      Stretch="Uniform" Stroke="#C0FFFFFF" StrokeThickness="1.5"
                      StrokeLineJoin="Round" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Visibility="Collapsed"/>
                <TextBlock x:Name="RestoreIconChar" Text="📝"
                           FontSize="18" Foreground="#C0FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
