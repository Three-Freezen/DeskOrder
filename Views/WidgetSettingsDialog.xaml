<Window x:Class="DesktopZones.Views.WidgetSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget Settings" Width="440" Height="640"
        MinWidth="400" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#E610111A"/>
        <SolidColorBrush x:Key="Acc" Color="#7C3AED"/>
        <SolidColorBrush x:Key="T1" Color="#E8E8F0"/>
        <SolidColorBrush x:Key="T2" Color="#8888A0"/>
        <SolidColorBrush x:Key="T3" Color="#606080"/>
        <SolidColorBrush x:Key="IBg" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="IBd" Color="#15FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#10FFFFFF"/>

        <Style x:Key="DTb" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource IBg}"/>
            <Setter Property="Foreground" Value="{StaticResource T1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource IBd}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="DLb" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource T2}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Dark ComboBox -->
        <ControlTemplate x:Key="DarkComboTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                    Background="{StaticResource IBg}" BorderBrush="{StaticResource IBd}"
                    BorderThickness="1" Foreground="{StaticResource T1}"
                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                    ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="6,4">
                                <Grid>
                                    <Path x:Name="Arrow" Data="M0,0L4,4L8,0" Fill="{StaticResource T2}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}"
                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,4,20,4"
                    VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                    AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Border x:Name="DropDownBorder" Background="{StaticResource IBg}"
                            BorderBrush="{StaticResource IBd}" BorderThickness="1" CornerRadius="4"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{TemplateBinding ActualWidth}">
                        <ScrollViewer><ItemsPresenter/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboTemplate}"/>
            <Setter Property="Background" Value="{StaticResource IBg}"/>
            <Setter Property="Foreground" Value="{StaticResource T1}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource IBg}"/>
            <Setter Property="Foreground" Value="{StaticResource T1}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" CornerRadius="12" BorderBrush="#15FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#AA000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="DialogTitle" Text="Widget Settings" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource T1}" Margin="0,4,0,8"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- ══ Widget Dimensions (sticky note / panel only) ══ -->
                    <StackPanel x:Name="WidgetDimensionSection" Visibility="Collapsed" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock x:Name="LabelWidth" Style="{StaticResource DLb}"/><TextBox x:Name="WidthBox" Style="{StaticResource DTb}" Text="{Binding WidgetWidth, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock x:Name="LabelHeight" Style="{StaticResource DLb}"/><TextBox x:Name="HeightBox" Style="{StaticResource DTb}" Text="{Binding WidgetHeight, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ══ Title Text Color (sticky note only) ══ -->
                    <StackPanel x:Name="TitleTextColorSection" Visibility="Collapsed">
                        <TextBlock x:Name="LabelTitleTextColor" Style="{StaticResource DLb}"/>
                        <StackPanel x:Name="TitleTextColorPresets" Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#E0E0E0" Background="#E0E0E0" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleTextColorPreset_Click"/>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#FFFFFF" Background="#FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleTextColorPreset_Click"/>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#000000" Background="#000000" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleTextColorPreset_Click"/>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#808080" Background="#808080" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleTextColorPreset_Click"/>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#FF0000" Background="#FF0000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleTextColorPreset_Click"/>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#FF7D00" Background="#FF7D00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleTextColorPreset_Click"/>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#FFFF00" Background="#FFFF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleTextColorPreset_Click"/>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#00FF00" Background="#00FF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleTextColorPreset_Click"/>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#0000FF" Background="#0000FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleTextColorPreset_Click"/>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#00FFFF" Background="#00FFFF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleTextColorPreset_Click"/>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#FF00FF" Background="#FF00FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleTextColorPreset_Click"/>
                            <Button x:Name="TitleTextColorCustomBtn" Content="..." Width="32" Height="28" Background="{StaticResource IBg}" Foreground="{StaticResource T2}" BorderBrush="{StaticResource IBd}" BorderThickness="1" Cursor="Hand" FontSize="10" Click="TitleTextColorCustom_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- ══ Common: Use Global Appearance ══ -->
                    <CheckBox x:Name="UseGlobalAppearanceBox" Margin="0,4,0,8"
                              Foreground="{StaticResource T1}" FontSize="13"
                              IsChecked="{Binding UseGlobalAppearance}"
                              Checked="UseGlobal_Changed" Unchecked="UseGlobal_Changed">
                        <TextBlock x:Name="LabelUseGlobal" Text="全局外观"/>
                    </CheckBox>

                    <!-- ══ Common: Border Thickness ══ -->
                    <TextBlock x:Name="LabelBorderThickness" Style="{StaticResource DLb}"/>
                    <TextBox x:Name="BorderThicknessBox" Style="{StaticResource DTb}" Text="{Binding BorderThicknessText, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- ══ Common: Border Color ══ -->
                    <TextBlock x:Name="LabelBorderColor" Style="{StaticResource DLb}"/>
                    <StackPanel x:Name="BorderColorPresets" Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#01000000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click" ToolTip="Transparent"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#CCCCCC" Offset="0.5"/><GradientStop Color="#FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60000000" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#000000"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#FFFFFF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60808080" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#808080"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF0000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF0000"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF7D00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF7D00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FFFF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#FFFF00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#6000FF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#00FF00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#600000FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#0000FF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#6000FFFF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#00FFFF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF00FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="BorderColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF00FF"/></Border.Background></Border>
                        <Button x:Name="BorderCustomBtn" Content="..." Width="32" Height="28" Background="{StaticResource IBg}" Foreground="{StaticResource T2}" BorderBrush="{StaticResource IBd}" BorderThickness="1" Cursor="Hand" FontSize="10" Click="BorderCustom_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
                    </StackPanel>

                    <!-- ══ Common: Fill Color ══ -->
                    <TextBlock x:Name="LabelFillColor" Style="{StaticResource DLb}"/>
                    <StackPanel x:Name="FillColorPresets" Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#01000000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click" ToolTip="Transparent"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#CCCCCC" Offset="0.5"/><GradientStop Color="#FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60000000" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#000000"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#FFFFFF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60808080" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#808080"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF0000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF0000"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF7D00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF7D00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FFFF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#FFFF00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#6000FF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#00FF00"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#600000FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#0000FF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#6000FFFF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#00FFFF"/></Border.Background></Border>
                        <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF00FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="FillColorPreset_Click"><Border.Background><SolidColorBrush Color="#FF00FF"/></Border.Background></Border>
                        <Button x:Name="FillCustomBtn" Content="..." Width="32" Height="28" Background="{StaticResource IBg}" Foreground="{StaticResource T2}" BorderBrush="{StaticResource IBd}" BorderThickness="1" Cursor="Hand" FontSize="10" Click="FillCustom_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
                    </StackPanel>

                    <!-- ══ Common: Fill Opacity ══ -->
                    <TextBlock x:Name="LabelFillOpacity" Style="{StaticResource DLb}"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Slider x:Name="FillOpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" Background="Transparent" Cursor="Hand" ValueChanged="FillOpacity_Changed"/>
                        <TextBlock x:Name="FillOpacityLabel" Grid.Column="1" Foreground="{StaticResource T2}" FontSize="11" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>

                    <!-- Enable Restore Button -->
                    <CheckBox x:Name="EnableRestoreButtonToggle" IsChecked="True"
                              Foreground="{StaticResource T1}" FontSize="13" Margin="0,12,0,0">
                        <TextBlock x:Name="LabelEnableRestoreButton"/>
                    </CheckBox>

                    <!-- ══ Liquid Glass ══ -->
                    <Border Background="#08FFFFFF" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="GlassSectionTitle" Text="Glass Effect"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource T1}" Margin="0,0,0,6"/>

                            <!-- Liquid Glass toggle + settings -->
                            <TextBlock x:Name="LabelGlassIntensity" Style="{StaticResource DLb}" Margin="0,0,0,4"/>
                            <StackPanel x:Name="GlassIntensityPanel">
                                <CheckBox x:Name="LiquidGlassToggle" Foreground="{StaticResource T1}" FontSize="13" Margin="0,0,0,4"/>
                                <Button x:Name="LiquidGlassSettingsBtn" Content="💧 液态玻璃设置"
                                        Width="200" Height="34" FontSize="12" FontWeight="SemiBold"
                                        Cursor="Hand" Margin="0,0,0,4"
                                        Click="LiquidGlassSettings_Click"
                                        Background="#7C3AED" Foreground="White"
                                        BorderThickness="1" BorderBrush="#807C3AED">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ══ Title Bar Fill (sticky note only) ══ -->
                    <StackPanel x:Name="TitleBarSection" Visibility="Collapsed">
                        <TextBlock x:Name="LabelTitleBar" Style="{StaticResource DLb}"/>
                        <StackPanel x:Name="TitleBarPresets" Orientation="Horizontal" Margin="0,2,0,0">
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#01000000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarPreset_Click" ToolTip="Transparent"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#CCCCCC" Offset="0.5"/><GradientStop Color="#FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60000000" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarPreset_Click"><Border.Background><SolidColorBrush Color="#000000"/></Border.Background></Border>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarPreset_Click"><Border.Background><SolidColorBrush Color="#FFFFFF"/></Border.Background></Border>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60808080" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarPreset_Click"><Border.Background><SolidColorBrush Color="#808080"/></Border.Background></Border>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF0000" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarPreset_Click"><Border.Background><SolidColorBrush Color="#FF0000"/></Border.Background></Border>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF7D00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarPreset_Click"><Border.Background><SolidColorBrush Color="#FF7D00"/></Border.Background></Border>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FFFF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarPreset_Click"><Border.Background><SolidColorBrush Color="#FFFF00"/></Border.Background></Border>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#6000FF00" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarPreset_Click"><Border.Background><SolidColorBrush Color="#00FF00"/></Border.Background></Border>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#600000FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarPreset_Click"><Border.Background><SolidColorBrush Color="#0000FF"/></Border.Background></Border>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#6000FFFF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarPreset_Click"><Border.Background><SolidColorBrush Color="#00FFFF"/></Border.Background></Border>
                            <Border Width="28" Height="28" CornerRadius="14" Margin="0,0,6,0" Cursor="Hand" Tag="#60FF00FF" BorderBrush="#40FFFFFF" BorderThickness="1" MouseLeftButtonDown="TitleBarPreset_Click"><Border.Background><SolidColorBrush Color="#FF00FF"/></Border.Background></Border>
                        </StackPanel>

                        <!-- Title bar opacity -->
                        <TextBlock x:Name="LabelTitleOpacity" Style="{StaticResource DLb}"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Slider x:Name="TitleOpacitySlider" Minimum="0" Maximum="100" TickFrequency="5" Background="Transparent" Cursor="Hand"/>
                            <TextBlock x:Name="TitleOpacityLabel" Grid.Column="1" Foreground="{StaticResource T2}" FontSize="11" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Button opacity -->
                        <TextBlock x:Name="LabelButtonOpacity" Style="{StaticResource DLb}"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Slider x:Name="ButtonOpacitySlider" Minimum="5" Maximum="100" TickFrequency="5" Background="Transparent" Cursor="Hand"/>
                            <TextBlock x:Name="ButtonOpacityLabel" Grid.Column="1" Foreground="{StaticResource T2}" FontSize="11" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>

                        <!-- ══ Background Image - Analog (clock only) ══ -->
                    <StackPanel x:Name="BgImageSection" Visibility="Collapsed">
                        <TextBlock x:Name="LabelBgImageAnalog" Style="{StaticResource DLb}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="BgImagePathBox" Style="{StaticResource DTb}" IsReadOnly="True"/>
                            <Button Grid.Column="1" x:Name="CropBtn" Content="✂" Width="28" Background="{StaticResource Acc}" Foreground="White" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand" FontSize="12" Click="CropBgImage_Click" IsEnabled="False"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources></Button>
                            <Button Grid.Column="2" x:Name="BrowseBgBtn" Content="..." Width="32" Background="{StaticResource Acc}" Foreground="White" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand" FontSize="12" Click="BrowseBgImage_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources></Button>
                        </Grid>
                        <Button x:Name="ClearBgBtn" Content="Clear" Background="Transparent" Foreground="#FF6666" BorderThickness="0" Cursor="Hand" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" Click="ClearBgImage_Click"/>

                        <!-- Stretch mode -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LabelBgStretch" VerticalAlignment="Center" Foreground="{StaticResource T2}" FontSize="11" Width="60" Visibility="Collapsed"/>
                            <ComboBox Grid.Column="1" x:Name="BgStretchCombo" Style="{StaticResource DarkCombo}" Margin="6,0,0,0" Visibility="Collapsed">
                                <ComboBoxItem x:Name="CropFill" Content="Fill" Tag="Fill" Foreground="{StaticResource T1}" Background="{StaticResource IBg}"/>
                                <ComboBoxItem x:Name="CropUniform" Content="Uniform" Tag="Uniform" Foreground="{StaticResource T1}" Background="{StaticResource IBg}"/>
                                <ComboBoxItem x:Name="CropUniformToFill" Content="UniformToFill" Tag="UniformToFill" Foreground="{StaticResource T1}" Background="{StaticResource IBg}"/>
                                <ComboBoxItem x:Name="CropNone" Content="None" Tag="None" Foreground="{StaticResource T1}" Background="{StaticResource IBg}"/>
                            </ComboBox>
                        </Grid>

                        <!-- Image offset -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock x:Name="LabelOffsetX" Style="{StaticResource DLb}"/><TextBox x:Name="OffsetXBox" Style="{StaticResource DTb}" Text="0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock x:Name="LabelOffsetY" Style="{StaticResource DLb}"/><TextBox x:Name="OffsetYBox" Style="{StaticResource DTb}" Text="0"/></StackPanel>
                        </Grid>

                        <!-- Zoom -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LabelZoom" VerticalAlignment="Center" Foreground="{StaticResource T2}" FontSize="11" Width="60"/>
                            <Slider Grid.Column="1" x:Name="ZoomSlider" Minimum="0.5" Maximum="3" TickFrequency="0.1" Background="Transparent" Cursor="Hand" Margin="6,0,0,0"/>
                            <TextBlock x:Name="ZoomLabel" Grid.Column="2" Foreground="{StaticResource T1}" FontSize="13" FontWeight="SemiBold" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Image opacity -->
                        <TextBlock x:Name="LabelBgOpacity" Style="{StaticResource DLb}"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Slider x:Name="BgOpacitySlider" Minimum="5" Maximum="100" TickFrequency="5" Background="Transparent" Cursor="Hand"/>
                            <TextBlock x:Name="BgOpacityLabel" Grid.Column="1" Foreground="{StaticResource T2}" FontSize="11" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- ══ Background Image - Digital (clock only) ══ -->
                    <StackPanel x:Name="DigitalBgImageSection" Visibility="Collapsed">
                        <TextBlock x:Name="LabelBgImageDigital" Style="{StaticResource DLb}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="DigitalBgImagePathBox" Style="{StaticResource DTb}" IsReadOnly="True"/>
                            <Button Grid.Column="1" x:Name="DigitalCropBtn" Content="✂" Width="28" Background="{StaticResource Acc}" Foreground="White" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand" FontSize="12" Click="DigitalCropBgImage_Click" IsEnabled="False"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources></Button>
                            <Button Grid.Column="2" x:Name="DigitalBrowseBgBtn" Content="..." Width="32" Background="{StaticResource Acc}" Foreground="White" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand" FontSize="12" Click="DigitalBrowseBgImage_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources></Button>
                        </Grid>
                        <Button x:Name="DigitalClearBgBtn" Content="Clear" Background="Transparent" Foreground="#FF6666" BorderThickness="0" Cursor="Hand" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" Click="DigitalClearBgImage_Click"/>

                        <!-- Stretch mode -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LabelDigitalBgStretch" VerticalAlignment="Center" Foreground="{StaticResource T2}" FontSize="11" Width="60" Visibility="Collapsed"/>
                            <ComboBox Grid.Column="1" x:Name="DigitalBgStretchCombo" Style="{StaticResource DarkCombo}" Margin="6,0,0,0" Visibility="Collapsed">
                                <ComboBoxItem x:Name="DCropFill" Content="Fill" Tag="Fill" Foreground="{StaticResource T1}" Background="{StaticResource IBg}"/>
                                <ComboBoxItem x:Name="DCropUniform" Content="Uniform" Tag="Uniform" Foreground="{StaticResource T1}" Background="{StaticResource IBg}"/>
                                <ComboBoxItem x:Name="DCropUniformToFill" Content="UniformToFill" Tag="UniformToFill" Foreground="{StaticResource T1}" Background="{StaticResource IBg}"/>
                                <ComboBoxItem x:Name="DCropNone" Content="None" Tag="None" Foreground="{StaticResource T1}" Background="{StaticResource IBg}"/>
                            </ComboBox>
                        </Grid>

                        <!-- Image offset -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock x:Name="LabelDigitalOffsetX" Style="{StaticResource DLb}"/><TextBox x:Name="DigitalOffsetXBox" Style="{StaticResource DTb}" Text="0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock x:Name="LabelDigitalOffsetY" Style="{StaticResource DLb}"/><TextBox x:Name="DigitalOffsetYBox" Style="{StaticResource DTb}" Text="0"/></StackPanel>
                        </Grid>

                        <!-- Zoom -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LabelDigitalZoom" VerticalAlignment="Center" Foreground="{StaticResource T2}" FontSize="11" Width="60"/>
                            <Slider Grid.Column="1" x:Name="DigitalZoomSlider" Minimum="0.5" Maximum="3" TickFrequency="0.1" Background="Transparent" Cursor="Hand" Margin="6,0,0,0"/>
                            <TextBlock x:Name="DigitalZoomLabel" Grid.Column="2" Foreground="{StaticResource T1}" FontSize="13" FontWeight="SemiBold" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- Image opacity -->
                        <TextBlock x:Name="LabelDigitalBgOpacity" Style="{StaticResource DLb}"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Slider x:Name="DigitalBgOpacitySlider" Minimum="5" Maximum="100" TickFrequency="5" Background="Transparent" Cursor="Hand"/>
                            <TextBlock x:Name="DigitalBgOpacityLabel" Grid.Column="1" Foreground="{StaticResource T2}" FontSize="11" Width="36" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="LoadPresetButton" Content="加载预设" Background="#15FFFFFF" Foreground="{StaticResource T2}" BorderBrush="{StaticResource IBd}" BorderThickness="1" Padding="16,8" Cursor="Hand" FontSize="12" Click="LoadPreset_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
                <Button x:Name="SavePresetButton" Content="保存预设" Background="#15FFFFFF" Foreground="{StaticResource T2}" BorderBrush="{StaticResource IBd}" BorderThickness="1" Padding="16,8" Margin="8,0,0,0" Cursor="Hand" FontSize="12" Click="SavePreset_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
                <Button x:Name="CancelButton" Content="Cancel" Background="#15FFFFFF" Foreground="{StaticResource T2}" BorderBrush="{StaticResource IBd}" BorderThickness="1" Padding="20,8" Margin="8,0,0,0" Cursor="Hand" FontSize="12" Click="CancelButton_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
                <Button x:Name="ApplyButton" Content="Apply" Background="{StaticResource Acc}" Foreground="White" BorderThickness="0" Padding="20,8" Margin="8,0,0,0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Click="ApplyButton_Click"><Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources></Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
