<Window x:Class="DesktopZones.Views.OverwriteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Title="Overwrite Preset"
        Width="360" Height="200"
        MinWidth="320" MinHeight="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="12"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#AA000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="DialogTitle" Text="{loc:Loc Key=Preset.OverwriteTitle}"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,8"/>

            <!-- Title/content divider (自适应文字色,同液态玻璃二级窗口) -->
            <Border Grid.Row="1" Height="1" Margin="0,0,0,10"
                    Background="{DynamicResource Menu.Separator}"/>

            <!-- Prompt -->
            <TextBlock x:Name="PromptText" Grid.Row="2"
                       Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="13"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       LineHeight="22"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Content="{loc:Loc Key=Preset.Cancel}"
                        Padding="20,8" Cursor="Hand" FontSize="12"
                        Click="CancelButton_Click"
                        Style="{DynamicResource OutlineBtn}"/>
                <Button x:Name="OverwriteButton" Content="{loc:Loc Key=Preset.Overwrite}"
                        Padding="20,8" Margin="8,0,0,0"
                        Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                        IsDefault="True"
                        Click="OverwriteButton_Click"
                        Style="{DynamicResource FillBtn}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
