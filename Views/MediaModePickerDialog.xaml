<Window x:Class="DesktopZones.Views.MediaModePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Title="{loc:Loc Key=Media.NewTitle}" Width="440" Height="330"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="{DynamicResource Menu.Bg.Surface}" CornerRadius="12"
            BorderBrush="{DynamicResource Menu.Border.Subtle}" BorderThickness="1">
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleLabel" Text="{loc:Loc Key=Media.NewTitle}"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Menu.Text.Primary}" Margin="0,2,0,10"/>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource Menu.Separator}" Margin="0,0,0,12"/>
            <TextBlock Grid.Row="2" x:Name="HintLabel" Text="{loc:Loc Key=Media.NewModeHint}"
                       FontSize="11" Foreground="{DynamicResource Menu.Text.Secondary}" Margin="0,0,0,12"/>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 律动条。
                     卡片的点击走 PreviewMouseLeftButtonDown（按下即选中）而不是
                     MouseLeftButtonUp：窗口的 OnMouseLeftButtonDown 会调 DragMove，
                     它的模态循环把鼠标抬起吞掉 → Up 永远不来（跟 PanelWindow 里
                     「设置界面点了没反应」同一个坑）。按下时 e.Handled=true 顺便
                     阻止冒泡到窗口，卡片区域就不会被拿来拖窗口。 -->
                <Border x:Name="BarsCard" Grid.Column="0" CornerRadius="10" Cursor="Hand"
                        Background="{DynamicResource Menu.Bg.Hover}"
                        BorderBrush="{DynamicResource Menu.Border.Subtle}" BorderThickness="1"
                        PreviewMouseLeftButtonDown="BarsCard_Click">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                        <Grid Height="54">
                            <Rectangle Width="86" Height="4" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource Menu.Text.Primary}" Opacity="0.35"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                        HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Rectangle Width="5" Height="16" RadiusX="2.5" RadiusY="2.5" Fill="#7CF5FF" Margin="2,0"/>
                                <Rectangle Width="5" Height="30" RadiusX="2.5" RadiusY="2.5" Fill="#6ED9FF" Margin="2,0"/>
                                <Rectangle Width="5" Height="42" RadiusX="2.5" RadiusY="2.5" Fill="#8FB4FF" Margin="2,0"/>
                                <Rectangle Width="5" Height="24" RadiusX="2.5" RadiusY="2.5" Fill="#B58CFF" Margin="2,0"/>
                                <Rectangle Width="5" Height="12" RadiusX="2.5" RadiusY="2.5" Fill="#C88CFF" Margin="2,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Loc Key=Media.ModeBars}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Menu.Text.Primary}"
                                   HorizontalAlignment="Center" Margin="0,12,0,2"/>
                        <TextBlock Text="{loc:Loc Key=MediaProp.Section.Bars}" FontSize="10"
                                   Foreground="{DynamicResource Menu.Text.Secondary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 唱片机 -->
                <Border x:Name="VinylCard" Grid.Column="2" CornerRadius="10" Cursor="Hand"
                        Background="{DynamicResource Menu.Bg.Hover}"
                        BorderBrush="{DynamicResource Menu.Border.Subtle}" BorderThickness="1"
                        PreviewMouseLeftButtonDown="VinylCard_Click">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                        <Grid Height="54" Width="54" HorizontalAlignment="Center">
                            <Ellipse Width="50" Height="50" Fill="#16161B"
                                     Stroke="{DynamicResource Menu.Border.Subtle}" StrokeThickness="1"/>
                            <Ellipse Width="24" Height="24" Fill="#3C4250"/>
                            <Ellipse Width="4" Height="4" Fill="#0C0C0E"/>
                            <Path Data="{StaticResource Icon.Media}" Width="18" Height="18"
                                  Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Stroke="{DynamicResource Menu.Text.Primary}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" Margin="0,0,-2,-2"/>
                        </Grid>
                        <TextBlock Text="{loc:Loc Key=Media.ModeVinyl}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Menu.Text.Primary}"
                                   HorizontalAlignment="Center" Margin="0,12,0,2"/>
                        <TextBlock Text="{loc:Loc Key=MediaProp.Section.Vinyl}" FontSize="10"
                                   Foreground="{DynamicResource Menu.Text.Secondary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelBtn" Content="{loc:Loc Key=Media.Cancel}"
                        Padding="16,6" Cursor="Hand" Click="Cancel_Click"
                        Style="{DynamicResource OutlineBtn}"/>
                <Button x:Name="CreateBtn" Content="{loc:Loc Key=Media.Create}"
                        Padding="18,6" Margin="8,0,0,0" Cursor="Hand" Click="Create_Click"
                        Style="{DynamicResource FillBtn}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
