                                            <TextBlock Grid.Column="1" Text="会议准备" FontSize="8" Foreground="#D0D0E0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="×" FontSize="9" Foreground="#80666688" VerticalAlignment="Center" Margin="3,0,0,0" Cursor="Hand"/>
                                        </Grid>
                                        <!-- Note item 2 (unchecked) -->
                                        <Grid Margin="0,1" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="11" Height="11" CornerRadius="2" BorderBrush="#50FFFFFF" BorderThickness="1" Background="Transparent" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="提交周报" FontSize="8" Foreground="#D0D0E0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="×" FontSize="9" Foreground="#80666688" VerticalAlignment="Center" Margin="3,0,0,0" Cursor="Hand"/>
                                        </Grid>
                                        <!-- Note item 3 (unchecked, truncated) -->
                                        <Grid Margin="0,1" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="11" Height="11" CornerRadius="2" BorderBrush="#50FFFFFF" BorderThickness="1" Background="Transparent" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="下午茶歇" FontSize="8" Foreground="#D0D0E0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="×" FontSize="9" Foreground="#80666688" VerticalAlignment="Center" Margin="3,0,0,0" Cursor="Hand"/>
