                        <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StickyNoteCardTemplate">
            <Border Style="{StaticResource CardFrameStyle}"
                    MouseEnter="Card_MouseEnter"
                    MouseLeave="Card_MouseLeave"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    Loaded="Card_Loaded">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Margin="8,8,8,2" ClipToBounds="True" CornerRadius="6"
                            Background="{Binding Payload.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}"
                            BorderThickness="{Binding Payload.BorderThickness}">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{Binding Payload.BorderColor, Converter={StaticResource Hex2Color}}"/>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- FillColor backdrop -->
                            <Rectangle Grid.RowSpan="3" Stretch="Fill" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding Payload.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08FFEB3B}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- Background image (only when path set) -->
                            <Image Grid.RowSpan="3" Source="{Binding Payload.BackgroundImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Opacity>
                                    <Binding Path="Payload.BackgroundImageOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.3"/>
                                </Image.Opacity>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Payload.BackgroundImagePath}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <!-- Row 0: Title bar — title text + Save/Pin/Hide buttons (matches StickyNoteWindow TitleBarBorder) -->
                            <Border Grid.Row="0" CornerRadius="3,3,0,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Payload.TitleBarFillColor, Converter={StaticResource Hex2Color}, FallbackValue=#20000000}"/>
                                </Border.Background>
                                <Grid ClipToBounds="True">
                                    <TextBlock Text="Note" FontSize="9" VerticalAlignment="Center" Margin="7,0,0,0">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{Binding Payload.TitleTextColor, Converter={StaticResource Hex2Color}, FallbackValue=#E0E0E0}"/>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,3,0" VerticalAlignment="Center">
                                        <Button Content="💾" Width="14" Height="14" FontSize="7" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0" Foreground="#80FFFFFF"/>
                                        <Button Content="📌" Width="14" Height="14" FontSize="7" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0" Foreground="#80FFFFFF"/>
                                        <Button Content="─" Width="14" Height="14" FontSize="8" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0,0,0" Foreground="#80FFFFFF"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Row 1: Formatting toolbar — Font Size combo + B/I/U/A buttons (matches StickyNoteWindow formatting toolbar) -->
                            <Border Grid.Row="1" Background="#10000000" Padding="4,1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="12" CornerRadius="2" Background="#1E1E36" BorderBrush="#30FFFFFF" BorderThickness="1" Margin="0,0,3,0">
                                        <TextBlock Text="14" FontSize="7" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E0E0E0"/>
                                    </Border>
                                    <Rectangle Width="1" Fill="#20FFFFFF" Margin="2,1"/>
                                    <Button Content="B" Width="11" Height="12" FontSize="7" FontWeight="Bold" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#E0E0E0"/>
                                    <Button Content="I" Width="11" Height="12" FontSize="7" FontStyle="Italic" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#E0E0E0"/>
                                    <Button Content="U" Width="11" Height="12" FontSize="7" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#E0E0E0">
                                        <Button.ContentTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="U" FontSize="7" TextDecorations="Underline" Foreground="#E0E0E0"/>
                                            </DataTemplate>
                                        </Button.ContentTemplate>
                                    </Button>
                                    <Rectangle Width="1" Fill="#20FFFFFF" Margin="2,1"/>
                                    <Button Content="A" Width="11" Height="12" FontSize="7" FontWeight="Bold" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#E0E0E0"/>
                                </StackPanel>
                            </Border>
                            <!-- Row 2: Content area (truncated text) -->
                            <StackPanel Grid.Row="2" Margin="6,4,6,4">
                                <TextBlock Text="{Binding Payload.Content, FallbackValue=便签内容…}" FontSize="9" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding Payload.TitleTextColor, Converter={StaticResource Hex2Color}, FallbackValue=#202020}"/>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.RowSpan="3" IsHitTestVisible="False">
                                <Border.Background><Binding Path="Payload.GlassColorMode" Converter="{StaticResource GlassMode2Brush}"/></Border.Background>
                                <Border.Opacity><Binding Path="Payload.GlassTintOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.7"/></Border.Opacity>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12,4,12,8" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MergedGroupCardTemplate">
            <Border Style="{StaticResource CardFrameStyle}"
                    MouseEnter="Card_MouseEnter"
                    MouseLeave="Card_MouseLeave"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    Loaded="Card_Loaded">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Margin="8,8,8,2" ClipToBounds="True"
                            CornerRadius="{Binding Payload.MergedGroupStyle.CornerRadius}"
                            BorderThickness="{Binding Payload.MergedGroupStyle.BorderThickness}"
                            Background="{Binding Payload.MergedGroupStyle.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{Binding Payload.MergedGroupStyle.BorderColor, Converter={StaticResource Hex2Color}}"/>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="6"/>
                            </Grid.RowDefinitions>
                            <Rectangle Grid.RowSpan="4" Stretch="Fill" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding Payload.MergedGroupStyle.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image Grid.RowSpan="4" Source="{Binding Payload.MergedGroupStyle.BackgroundImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Opacity>
                                    <Binding Path="Payload.MergedGroupStyle.BackgroundImageOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.3"/>
                                </Image.Opacity>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Payload.MergedGroupStyle.BackgroundImagePath}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <!-- Row 0: Title bar (matches ZoneWindow TitleBarBg Height=24 scaled to 14) -->
                            <Border Grid.Row="0" CornerRadius="3,3,0,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Payload.MergedGroupStyle.TitleBarFillColor, Converter={StaticResource Hex2Color}, FallbackValue=#FF7C3AED}"/>
                                </Border.Background>
                                <Grid ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,0,0">
                                        <TextBlock Text="⊞" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding Payload.MergedGroupStyle.IconColor, Converter={StaticResource Hex2Color}, FallbackValue=#FFFFFF}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Text="Merged Group" FontSize="8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="80">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding Payload.MergedGroupStyle.TitleTextColor, Converter={StaticResource Hex2Color}, FallbackValue=#FFFFFF}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,3,0" VerticalAlignment="Center">
                                        <Border Width="11" Height="10" CornerRadius="2" Background="#30FFFFFF" Margin="0,0,2,0">
                                            <TextBlock Text="+" FontSize="7" FontWeight="Bold" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="11" Height="10" CornerRadius="2" Background="#30FFFFFF" Margin="0,0,2,0">
                                            <TextBlock Text="⚙" FontSize="6" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="11" Height="10" CornerRadius="2" Background="#30FFFFFF">
                                            <TextBlock Text="─" FontSize="7" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Row 1: SubZoneTabsRow (matches ZoneWindow SubZoneTabsRow Height=24 scaled to 14) -->
                            <Border Grid.Row="1" Background="#08FFFFFF" Padding="3,0,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="2" Background="#30FFFFFF" Padding="4,1" Margin="0,0,2,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⊞" FontSize="7" Margin="0,0,2,0" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="Zone1" FontSize="6" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="2" Background="#10FFFFFF" Padding="4,1" Margin="0,0,2,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⊞" FontSize="7" Margin="0,0,2,0" Foreground="#A0FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="Zone 2" FontSize="6" Foreground="#A0FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- Row 2: Body area -->
                            <Grid Grid.Row="2"/>
                            <!-- Row 3: Bottom bar (matches ZoneWindow BottomBar Height=8 scaled to 6) -->
                            <Border Grid.Row="3" Background="#08FFFFFF" CornerRadius="0,0,3,3"/>
                            <Border IsHitTestVisible="False" Grid.RowSpan="4">
                                <Border.Background><Binding Path="Payload.GlassColorMode" Converter="{StaticResource GlassMode2Brush}"/></Border.Background>
                                <Border.Opacity><Binding Path="Payload.GlassTintOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.7"/></Border.Opacity>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12,4,12,8" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PanelCardTemplate">
            <Border Style="{StaticResource CardFrameStyle}"
                    MouseEnter="Card_MouseEnter"
                    MouseLeave="Card_MouseLeave"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    Loaded="Card_Loaded">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Margin="8,8,8,2" ClipToBounds="True" CornerRadius="6"
                            Background="{Binding PanelFillBrush, FallbackValue=#08000000}" BorderThickness="1">
                        <Border.BorderBrush>
                            <Binding Path="PanelBorderBrush" FallbackValue="#30FFFFFF"/>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- FillColor backdrop (matches Calendar/Zone/MergedGroup/Clock pattern) -->
                            <Rectangle Grid.RowSpan="2" Stretch="Fill" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding Payload.PanelFillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- Background image (only when path set) -->
                            <Image Grid.RowSpan="2" Source="{Binding Payload.PanelBackgroundImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Opacity>
                                    <Binding Path="Payload.PanelBackgroundImageOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.3"/>
                                </Image.Opacity>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Payload.PanelBackgroundImagePath}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <!-- Row 0: TopBar — 6 columns matching PanelWindow.TopBar (Clock+Date | Title | Search | Toggle | Import | Settings+Hide) -->
                            <Border Grid.Row="0" CornerRadius="3,3,0,0" Background="#10FFFFFF" Padding="3,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Col 0: Clock (locked to current time 15:42) -->
                                    <TextBlock Grid.Column="0" Text="14:30" FontSize="6" Foreground="#A0FFFFFF" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <!-- Col 1: Title Panel -->
                                    <TextBlock Grid.Column="1" Text="Panel" FontSize="6" FontWeight="SemiBold" Foreground="#E8E8F0" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <!-- Col 2: Search bar -->
                                    <Border Grid.Column="2" Height="11" CornerRadius="5" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,3,0">
                                        <TextBlock Text="{loc:Loc Key=Panel.Search}" FontSize="5" Foreground="#606080" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Border>
                                    <!-- Col 3: Grid/List toggle -->
                                    <Border Grid.Column="3" Width="11" Height="11" CornerRadius="2" Background="#20FFFFFF" Margin="0,0,2,0">
                                        <TextBlock Text="▦" FontSize="6" Foreground="#E8E8F0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Col 4: Import (+) -->
                                    <Border Grid.Column="4" Width="11" Height="11" CornerRadius="2" Background="#30FFFFFF" Margin="0,0,2,0">
                                        <TextBlock Text="+" FontSize="7" FontWeight="Bold" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Col 5: Settings (⚙) + Hide (─) -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="11" Height="11" CornerRadius="2" Background="#30FFFFFF" Margin="0,0,2,0">
                                            <TextBlock Text="⚙" FontSize="6" Foreground="#8080A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="11" Height="11" CornerRadius="2" Background="#30FFFFFF">
                                            <TextBlock Text="─" FontSize="6" Foreground="#8080A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Row 1: empty (icon display removed per user request) -->
                            <Grid Grid.Row="1"/>
                            <!-- Gradient backdrop (LiquidGlass). Default-collapsed; shown only when
                                 the preset has no explicit PanelFillColor (i.e. the card uses the
                                 gradient as its base canvas). Presets with a real FillColor keep
                                 their picked color exactly — no AuroraCyan hue-shift. -->
                            <Border Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed">
                                <Border.Background>
                                    <Binding Path="Payload.GlassColorMode" Converter="{StaticResource GlassMode2Brush}"/>
                                </Border.Background>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PanelFillColor}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12,4,12,8" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SubfolderCardTemplate">
            <!-- ponytail 2026-08-26: SubFolder 预设卡 — 纯样式预览(填充色/背景图/液态玻璃/
                 圆角),卡片上不放名称等额外内容;名称 + 日期放在下方信息栏(参考分区卡片)。
                 面板里不再有预设卡列表,预设卡统一挪到本二级界面。 -->
            <Border Style="{StaticResource CardFrameStyle}"
                    MouseEnter="Card_MouseEnter"
                    MouseLeave="Card_MouseLeave"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    Loaded="Card_Loaded">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Margin="8,8,8,2" ClipToBounds="True"
                            BorderBrush="#30FFFFFF" BorderThickness="1"
                            CornerRadius="{Binding Payload.CornerRounded, Converter={x:Static vm:BoolToCornerRadiusConverter.Instance}}">
                        <Border.Background>
                            <Binding Path="SubfolderFillBrush" FallbackValue="#08000000"/>
                        </Border.Background>
                        <Grid>
                            <!-- Background image (only when path set) -->
                            <Image Source="{Binding Payload.BackgroundImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Opacity>
                                    <Binding Path="Payload.BackgroundImageOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.3"/>
                                </Image.Opacity>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Payload.BackgroundImagePath}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <!-- Liquid glass preview (null when the preset has no glass) -->
                            <Rectangle Fill="{Binding SubfolderGlassBrush}" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12,4,12,8" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <local:PresetCardTemplateSelector x:Key="CardSelector"
                ZoneTemplate="{StaticResource ZoneCardTemplate}"
                ClockAnalogTemplate="{StaticResource ClockAnalogCardTemplate}"
                ClockDigitalTemplate="{StaticResource ClockDigitalCardTemplate}"
                CalendarTemplate="{StaticResource CalendarCardTemplate}"
                StickyNoteTemplate="{StaticResource StickyNoteCardTemplate}"
                MergedGroupTemplate="{StaticResource MergedGroupCardTemplate}"
                PanelTemplate="{StaticResource PanelCardTemplate}"
                SubfolderTemplate="{StaticResource SubfolderCardTemplate}"/>
    </Window.Resources>

    <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="12" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#AA000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="12,16,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="DialogTitle" Text="{loc:Loc Key=Preset.LoadButton}"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,12"/>

            <!-- Title/content divider (自适应文字色,同液态玻璃二级窗口) -->
            <Border Grid.Row="1" Height="1" Margin="0,0,0,10"
                    Background="{DynamicResource Menu.Separator}"/>

            <Grid Grid.Row="2">
                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="ℹ" FontSize="32" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHintText" Text="{loc:Loc Key=Preset.Empty}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="14"
                               Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="CardScroller" Padding="0,0" Visibility="Collapsed">
                    <ItemsControl x:Name="PresetList"
                                  HorizontalAlignment="Center"
                                  ItemTemplateSelector="{StaticResource CardSelector}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- ponytail: CardHeight=290 matches the Calendar card's intentional tall layout
                 (see CalendarCardTemplate comment above). Non-Calendar cards stay at 220
                 from CardFrameStyle — FanPanel reserves 290 per slot but smaller cards
                 only fill what they need, so fan spacing stays consistent. -->
                                <local:FanPanel CardWidth="180" CardHeight="290" StepWidth="45" VerticalPadding="60"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelButton" Content="{loc:Loc Key=Preset.Cancel}"
                        Padding="20,8" Cursor="Hand" FontSize="12"
                        Click="CancelButton_Click"
                        Style="{DynamicResource OutlineBtn}"/>
                <Button x:Name="ApplyButton" Content="{loc:Loc Key=Preset.Apply}"
                        Padding="20,8" Margin="8,0,0,0"
                        Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                        IsDefault="True" IsEnabled="False"
                        Click="ApplyButton_Click"
                        Style="{DynamicResource FillBtn}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>