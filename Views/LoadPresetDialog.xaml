                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="3"/></Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <!-- Note item 1 (checked) -->
                                        <Grid Margin="0,1" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="11" Height="11" CornerRadius="2" BorderBrush="#806C63FF" BorderThickness="1" Background="#306C63FF" Margin="0,0,4,0" VerticalAlignment="Center">
                                                <TextBlock Text="✓" FontSize="8" Foreground="#6C63FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
