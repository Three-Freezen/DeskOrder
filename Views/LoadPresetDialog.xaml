<Window x:Class="DesktopZones.Views.LoadPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
        xmlns:local="clr-namespace:DesktopZones.Views"
        xmlns:Models="clr-namespace:DesktopZones.Models"
        xmlns:vm="clr-namespace:DesktopZones.ViewModels"
        Title="Load Preset"
        Width="640" Height="540"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- ponytail: no local chrome brush aliases — chrome fields below use
             {DynamicResource Brush.*} directly so ThemeService.RepaintBrushes'
             dict-instance swap actually reaches them (StaticResource would freeze
             to the old brush reference and never repaint on theme change). -->

        <!-- Shared card preview backing: same gradient every card uses as its base canvas
             (matches the gradient placeholder ZoneCard originally drew on top of FillColor).
             Replaces the per-card "#FFC0C0C0" gray backing. FillColor Rectangle sits above
             this, so when FillColor is transparent the gradient shows through; when opaque
             it tints/hides the gradient. -->
        <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#60FF6B9D" Offset="0"/>
            <GradientStop Color="#608D6BFF" Offset="0.5"/>
            <GradientStop Color="#60FFB36B" Offset="1"/>
        </LinearGradientBrush>

        <local:HexColorConverter x:Key="Hex2Color"/>
        <local:PercentToOpacityConverter x:Key="PercentToOpacity"/>
        <local:LiquidGlassBrushConverter x:Key="GlassMode2Brush"/>
        <local:ModeToVisibilityConverter x:Key="Mode2Vis"/>
        <local:ModeToNameConverter x:Key="Mode2Name"/>

        <Style x:Key="CardFrameStyle" TargetType="Border">
            <Setter Property="Width" Value="180"/>
            <Setter Property="Height" Value="220"/>
            <Setter Property="Background" Value="#FF0E0E14"/>
            <Setter Property="BorderBrush" Value="#15787878"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#AA000000" Opacity="0.55"/>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ZoneCardTemplate">
            <Border Style="{StaticResource CardFrameStyle}"
                    MouseEnter="Card_MouseEnter"
                    MouseLeave="Card_MouseLeave"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    Loaded="Card_Loaded">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Margin="8,8,8,2" ClipToBounds="True"
                            CornerRadius="{Binding Payload.CornerRadius}"
                            BorderThickness="{Binding Payload.BorderThickness}"
                            Background="{Binding Payload.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{Binding Payload.BorderColor, Converter={StaticResource Hex2Color}}"/>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- FillColor spans both rows so the title bar area tints with the preset fill
                                 (matches ZoneWindow's FillRect covering the whole zone). Transparent FillColor
                                 lets the CardGradientBrush backing show through. -->
                            <Rectangle Grid.RowSpan="2" Stretch="Fill" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding Payload.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image Grid.RowSpan="2" Source="{Binding Payload.BackgroundImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Opacity>
                                    <Binding Path="Payload.BackgroundImageOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.3"/>
                                </Image.Opacity>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Payload.BackgroundImagePath}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Border x:Name="TitleBarBg" Grid.Row="0" CornerRadius="3,3,0,0">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Payload.TitleBarFillColor, Converter={StaticResource Hex2Color}, FallbackValue=#FF7C3AED}"/>
                                </Border.Background>
                                <Grid ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,0,0">
                                        <TextBlock Text="⊞" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding Payload.IconColor, Converter={StaticResource Hex2Color}, FallbackValue=#FFFFFF}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Text="New Zone" FontSize="8" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="80">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding Payload.TitleTextColor, Converter={StaticResource Hex2Color}, FallbackValue=#A0FFFFFF}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,3,0" VerticalAlignment="Center">
                                        <Border Width="11" Height="10" CornerRadius="2" Background="#30FFFFFF" Margin="0,0,2,0">
                                            <TextBlock Text="+" FontSize="7" FontWeight="Bold" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="11" Height="10" CornerRadius="2" Background="#30FFFFFF" Margin="0,0,2,0">
                                            <TextBlock Text="⚙" FontSize="6" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="11" Height="10" CornerRadius="2" Background="#30FFFFFF">
                                            <TextBlock Text="─" FontSize="7" Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Payload.TileMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Border Grid.RowSpan="2" IsHitTestVisible="False">
                                <Border.Background>
                                    <Binding Path="Payload.GlassColorMode" Converter="{StaticResource GlassMode2Brush}"/>
                                </Border.Background>
                                <Border.Opacity>
                                    <Binding Path="Payload.GlassTintOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.5"/>
                                </Border.Opacity>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12,4,12,8" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ClockDigitalCardTemplate">
            <Border Style="{StaticResource CardFrameStyle}"
                    MouseEnter="Card_MouseEnter"
                    MouseLeave="Card_MouseLeave"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    Loaded="Card_Loaded">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Margin="8,8,8,2"
                            Background="{Binding Payload.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}"
                            BorderThickness="{Binding Payload.BorderThickness}">
                        <Border.Clip>
                            <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,164,210"/>
                        </Border.Clip>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{Binding Payload.BorderColor, Converter={StaticResource Hex2Color}}"/>
                        </Border.BorderBrush>
                        <Grid ClipToBounds="True">
                            <Rectangle Grid.RowSpan="2" Stretch="Fill" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding Payload.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image Grid.RowSpan="2" Source="{Binding Payload.DigitalBackgroundImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Opacity>
                                    <Binding Path="Payload.DigitalBackgroundImageOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.3"/>
                                </Image.Opacity>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Payload.DigitalBackgroundImagePath}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Button Content="─" Width="11" Height="11" FontSize="6" Foreground="#60FFFFFF"
                                    Background="#01000000" BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0" Panel.ZIndex="10">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="2"/></Style>
                                </Button.Resources>
                            </Button>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="14:30:00" FontSize="28" FontWeight="Light" FontFamily="Segoe UI" TextAlignment="Center">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding Payload.TextColor, Converter={StaticResource Hex2Color}, FallbackValue=#EEFFFFFF}"/>
                                    </TextBlock.Foreground>
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#AA000000" Opacity="0.7"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="2026-01-01  周四" FontSize="9" Foreground="#AAFFFFFF" TextAlignment="Center" Margin="0,3,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="0" Color="#66000000" Opacity="0.6"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <Binding Path="Payload.GlassColorMode" Converter="{StaticResource GlassMode2Brush}"/>
                                </Border.Background>
                                <Border.Opacity>
                                    <Binding Path="Payload.GlassTintOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.5"/>
                                </Border.Opacity>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12,4,12,8" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Digital" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="10"/>
                            <TextBlock Text=" · " Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="10"/>
                            <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ClockAnalogCardTemplate">
            <Border Style="{StaticResource CardFrameStyle}"
                    MouseEnter="Card_MouseEnter"
                    MouseLeave="Card_MouseLeave"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    Loaded="Card_Loaded">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Margin="8,8,8,2" Background="{Binding Payload.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}" BorderThickness="{Binding Payload.BorderThickness}">
                        <Border.Clip>
                            <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,164,210"/>
                        </Border.Clip>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{Binding Payload.BorderColor, Converter={StaticResource Hex2Color}}"/>
                        </Border.BorderBrush>
                        <Grid>
                            <Rectangle Grid.RowSpan="2" Stretch="Fill" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding Payload.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image Grid.RowSpan="2" Source="{Binding Payload.BackgroundImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Opacity>
                                    <Binding Path="Payload.BackgroundImageOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.3"/>
                                </Image.Opacity>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Payload.BackgroundImagePath}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Button Content="─" Width="11" Height="11" FontSize="6" Foreground="#60FFFFFF"
                                    Background="#01000000" BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0" Panel.ZIndex="10">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="2"/></Style>
                                </Button.Resources>
                            </Button>
                            <Grid Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="140" Height="140" Fill="#18000000" Stroke="#40FFFFFF" StrokeThickness="2"/>
                                <Rectangle Width="2" Height="8" Fill="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                <Rectangle Width="2" Height="8" Fill="#80FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <Rectangle Width="2" Height="8" Fill="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                <Rectangle Width="2" Height="8" Fill="#80FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                <!-- ponytail: Hand angles are intentionally hardcoded to a 14:30:00 snapshot
                                     rather than computed per-card-load. Preset cards are static layout
                                     previews — animating them or reading current time per card would
                                     cost cycles every 500ms (Card_Loaded fires once) and create a
                                     distracting flicker across the fan. Add a per-card time read here
                                     only if the user explicitly asks for "live time on every card". -->
                                <Line X1="70" Y1="70" X2="70" Y2="38" Stroke="White" StrokeThickness="3.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                    <Line.RenderTransform><RotateTransform Angle="75"/></Line.RenderTransform>
                                </Line>
                                <Line X1="70" Y1="70" X2="70" Y2="22" Stroke="#CCFFFFFF" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                    <Line.RenderTransform><RotateTransform Angle="180"/></Line.RenderTransform>
                                </Line>
                                <Line X1="70" Y1="75" X2="70" Y2="18" Stroke="#FFFF6666" StrokeThickness="1"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Line.RenderTransform><RotateTransform Angle="0"/></Line.RenderTransform>
                                </Line>
                                <Ellipse Width="7" Height="7" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Width="22" Height="12" CornerRadius="2" Background="#20FFFFFF" BorderBrush="#40FFFFFF"
                                        BorderThickness="0.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="1" FontSize="8" Foreground="#AAFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <Border IsHitTestVisible="False">
                                <Border.Background>
                                    <Binding Path="Payload.GlassColorMode" Converter="{StaticResource GlassMode2Brush}"/>
                                </Border.Background>
                                <Border.Opacity>
                                    <Binding Path="Payload.GlassTintOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.5"/>
                                </Border.Opacity>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12,4,12,8" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Analog" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="10"/>
                            <TextBlock Text=" · " Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="10"/>
                            <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CalendarCardTemplate">
            <!-- ponytail: Calendar card is intentionally taller (290) than CardFrameStyle's
                 default 220 — the month header + Today button + weekday row + 6×7 day grid
                 + Notes panel all stack vertically and need the extra ~70px. Other card
                 kinds (Zone/Clock/etc.) stay at 220 since their content is single-row.
                 FanPanel below matches CardHeight=290 so this card centers correctly. -->
            <Border Style="{StaticResource CardFrameStyle}" Width="180" Height="290"
                    MouseEnter="Card_MouseEnter"
                    MouseLeave="Card_MouseLeave"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    Loaded="Card_Loaded">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Margin="8,8,8,2" ClipToBounds="True" CornerRadius="10"
                            Background="{Binding Payload.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}"
                            BorderThickness="{Binding Payload.BorderThickness}">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{Binding Payload.BorderColor, Converter={StaticResource Hex2Color}}"/>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- FillColor spans all 5 rows (matches CalendarWidget.ApplyAcrylic setting FillColor on the whole CalendarBorder). -->
                            <Rectangle Grid.RowSpan="5" Stretch="Fill" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding Payload.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Image Grid.RowSpan="5" Source="{Binding Payload.BackgroundImagePath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Opacity>
                                    <Binding Path="Payload.BackgroundImageOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.3"/>
                                </Image.Opacity>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Payload.BackgroundImagePath}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <!-- HideBtn overlay (matches CalendarWidget HideBtn at top-right) -->
                            <Button Content="─" Width="11" Height="11" FontSize="6" Foreground="#40FFFFFF"
                                    Background="#10FFFFFF" BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0" Panel.ZIndex="1">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="2"/></Style>
                                </Button.Resources>
                            </Button>
                            <!-- Row 0: Month/Year header + nav arrows (matches CalendarWidget Row 0) -->
                            <Grid Grid.Row="0" Margin="0,2,0,1">
                                <Button Content="&#x25C0;" Width="11" Height="11" FontSize="6" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Margin="3,0,0,0"
                                        Foreground="#AAFFFFFF"/>
                                <TextBlock Text="{Binding MonthLabel}" FontSize="8" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding Payload.TextColor, Converter={StaticResource Hex2Color}, FallbackValue=#EEFFFFFF}"/>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <Button Content="&#x25B6;" Width="11" Height="11" FontSize="6" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Margin="0,0,16,0"
                                        Foreground="#AAFFFFFF"/>
                            </Grid>
                            <!-- Row 1: Today button (matches CalendarWidget TodayBtn) -->
                            <Button Grid.Row="1" Content="Today" FontSize="6" Foreground="#6C63FF"
                                    Background="Transparent" BorderBrush="#406C63FF" BorderThickness="1"
                                    Padding="4,1" Cursor="Hand" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <!-- Row 2: Weekday headers -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding WeekdayLabels}" Margin="0,0,0,1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="6" HorizontalAlignment="Center" Foreground="#8080A0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Row 3: Day cells grid (6 rows × 7 cols) -->
                            <ItemsControl Grid.Row="3" ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="6" Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Border CornerRadius="4" Margin="1"
                                                    Background="{Binding DataContext.Payload.TodayColor, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource Hex2Color}, FallbackValue=#FF6C63FF}"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding Day}" FontSize="6"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#808080"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="True">
                                                                <Setter Property="Foreground">
                                                                    <Setter.Value>
                                                                        <!-- ponytail: AncestorType=ContentPresenter walks from DayCell up
                                                                             to the ContentPresenter (whose DataContext is the parent PresetCardItem).
                                                                             Previous AncestorType=ItemsControl landed on the Days ItemsControl
                                                                             whose DataContext is the Days collection — binding silently failed
                                                                             and FallbackValue #202020 was always used. -->
                                                                        <SolidColorBrush Color="{Binding DataContext.Payload.TextColor, RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource Hex2Color}, FallbackValue=#202020}"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Grid.RowSpan="5" IsHitTestVisible="False">
                                <Border.Background><Binding Path="Payload.GlassColorMode" Converter="{StaticResource GlassMode2Brush}"/></Border.Background>
                                <Border.Opacity><Binding Path="Payload.GlassTintOpacity" Converter="{StaticResource PercentToOpacity}" FallbackValue="0.7"/></Border.Opacity>
                            </Border>
                            <!-- Row 4: Notes panel (matches CalendarWidget NotesPanel — 120/404 ≈ 30% body height) -->
                            <Border Grid.Row="4" Background="#15FFFFFF" CornerRadius="4" Margin="3,3,3,3" Padding="5,4" MinHeight="70">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="备注" FontSize="8" Foreground="#AAA0C0" VerticalAlignment="Center"/>
                                        <Button Content="+" Width="12" Height="12" FontSize="9" Foreground="#6C63FF"
                                                Background="#20FFFFFF" BorderThickness="0" Cursor="Hand" Margin="5,0,0,0">
