<Window x:Class="DesktopZones.Views.LoadPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopZones.Views"
        xmlns:Models="clr-namespace:DesktopZones.Models"
        Title="Load Zone Preset"
        Width="640" Height="540"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#E610111A"/>
        <SolidColorBrush x:Key="Acc" Color="#7C3AED"/>
        <SolidColorBrush x:Key="T1" Color="#E8E8F0"/>
        <SolidColorBrush x:Key="T2" Color="#8888A0"/>
        <SolidColorBrush x:Key="T3" Color="#606080"/>
        <SolidColorBrush x:Key="IBg" Color="#0AFFFFFF"/>
        <SolidColorBrush x:Key="IBd" Color="#15FFFFFF"/>

        <local:HexColorConverter x:Key="Hex2Color"/>
        <local:PercentToOpacityConverter x:Key="PercentToOpacity"/>
        <local:LiquidGlassBrushConverter x:Key="GlassMode2Brush"/>
        <local:TitleBarFillConverter x:Key="TitleBarFill2"/>

        <!-- Card visual template. TransformGroup = RotateTransform (set in code) +
             ScaleTransform (animated in code on hover/select) — so the same Border
             handles both fan rotation and the hover-pop animation. -->
        <DataTemplate x:Key="PresetCardTemplate">
            <Border x:Name="Card" Width="180" Height="220"
                    Background="#FF0E0E14"
                    BorderBrush="#15787878" BorderThickness="1"
                    CornerRadius="12" Cursor="Hand"
                    MouseEnter="Card_MouseEnter"
                    MouseLeave="Card_MouseLeave"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown"
                    Loaded="Card_Loaded">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="DeletePresetMenuItem" Click="DeletePresetMenuItem_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="CardRotate" Angle="0"/>
                        <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#AA000000" Opacity="0.55"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="ZonePreview" Margin="8,8,8,2"
                            ClipToBounds="True"
                            CornerRadius="{Binding Zone.CornerRadius}"
                            BorderThickness="{Binding Zone.BorderThickness}"
                            Background="#FFC0C0C0">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{Binding Zone.BorderColor, Converter={StaticResource Hex2Color}}"/>
                        </Border.BorderBrush>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="TitleBarBg" Grid.Row="0"
                                    CornerRadius="3,3,0,0">
                                <!--
                                  Title-bar fill now mirrors what the live zone actually
                                  displays: the user's Zone.TitleBarFillColor (parsed via
                                  Hex2Color). The previous GlassColorMode-based approach
                                  was rendering as washed-out tan on light backdrop.
                                -->
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Zone.TitleBarFillColor, Converter={StaticResource Hex2Color}, FallbackValue=#FF7C3AED}"/>
                                </Border.Background>
                                <Grid ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="3,0,0,0">
                                        <TextBlock Text="⊞" FontSize="9"
                                                   VerticalAlignment="Center" Margin="0,0,3,0">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding Zone.IconColor, Converter={StaticResource Hex2Color}, FallbackValue=#FFFFFF}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Text="New Zone" FontSize="8"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="80">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding Zone.TitleTextColor, Converter={StaticResource Hex2Color}, FallbackValue=#A0FFFFFF}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,3,0" Opacity="0.4">
                                        <Border Width="6" Height="4" CornerRadius="1"
                                                Background="#60FFFFFF" Margin="0,0,1,0"/>
                                        <Border Width="6" Height="4" CornerRadius="1"
                                                Background="#60FFFFFF" Margin="0,0,1,0"/>
                                        <Border Width="6" Height="4" CornerRadius="1"
                                                Background="#60FFFFFF"/>
                                    </StackPanel>
                                </Grid>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Zone.QuickBarMode}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Grid Grid.Row="1" ClipToBounds="True">
                                <!--
                                  Layer 0a — preset's image (crisp, no blur). Visible iff path set.
                                -->
                                <Image Source="{Binding Zone.BackgroundImagePath}"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Zone.BackgroundImagePath}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!--
                                  Layer 0b — gradient fallback for presets without an image.
                                -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#60FF6B9D" Offset="0"/>
                                            <GradientStop Color="#608D6BFF" Offset="0.5"/>
                                            <GradientStop Color="#60FFB36B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Zone.BackgroundImagePath}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>

                                <!--
                                  Layer 1 — FillColor tint. Hex already carries the alpha byte
                                  from the FillOpacityPercent slider.
                                -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{Binding Zone.FillColor, Converter={StaticResource Hex2Color}, FallbackValue=#08000000}"/>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <!--
                                  Layer 2 — hard-stacked LiquidGlass overlay. Gradient is built
                                  on the fly from Zone.GlassColorMode so each preset's card
                                  reflects its actual color choice (OceanBlue → blue, RosePink →
                                  pink, ForestGreen → green, etc.) — mirroring what the live zone
                                  does via DWM blur with the same base color table.
                                -->
                                <Border IsHitTestVisible="False">
                                    <Border.Background>
                                        <Binding Path="Zone.GlassColorMode"
                                                 Converter="{StaticResource GlassMode2Brush}"/>
                                    </Border.Background>
                                    <Border.Opacity>
                                        <Binding Path="Zone.GlassTintOpacity"
                                                 Converter="{StaticResource PercentToOpacity}"
                                                 FallbackValue="0.7"/>
                                    </Border.Opacity>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="12,4,12,8" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{StaticResource T1}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}"
                                   Foreground="{StaticResource T3}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" CornerRadius="12" BorderBrush="#15FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#AA000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="12,16,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="DialogTitle" Text="加载分区预设"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource T1}" Margin="0,2,0,12"/>

            <!-- Body: empty hint + card scroller. Cards themselves scale up on hover/select,
                 and Panel.SetZIndex in code-behind lifts the lifted card above its neighbours. -->
            <Grid Grid.Row="1">
                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="ℹ" FontSize="32" Foreground="{StaticResource T3}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyHintText" Text="暂无预设"
                               Foreground="{StaticResource T2}" FontSize="14"
                               Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border x:Name="CardScroller" Padding="0,0" Visibility="Collapsed">
                    <ItemsControl x:Name="PresetList"
                                  HorizontalAlignment="Center"
                                  ItemTemplate="{StaticResource PresetCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:FanPanel CardWidth="180" CardHeight="220" StepWidth="45" VerticalPadding="60"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelButton" Content="取消"
                        Background="#15FFFFFF" Foreground="{StaticResource T2}"
                        BorderBrush="{StaticResource IBd}" BorderThickness="1"
                        Padding="20,8" Cursor="Hand" FontSize="12"
                        Click="CancelButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="ApplyButton" Content="应用"
                        Background="{StaticResource Acc}" Foreground="White"
                        BorderThickness="0" Padding="20,8" Margin="8,0,0,0"
                        Cursor="Hand" FontSize="12" FontWeight="SemiBold"
                        IsDefault="True" IsEnabled="False"
                        Click="ApplyButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
