<Window x:Class="DesktopZones.Views.PanelPopupMotionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Title="{loc:Loc Key=Motion.Title}" Width="320" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource Brush.Bg.Chrome}" CornerRadius="10"
            BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
            MouseLeftButtonDown="TitleBar_Down">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleLabel" Text="{loc:Loc Key=Motion.Title}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,4,0,12"/>

            <!-- Title/content divider -->
            <Border Grid.Row="1" Height="1" Margin="0,0,0,10"
                    Background="{DynamicResource Menu.Separator}"/>

            <!-- 展开原点(桌面四角) -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="OriginLabel" Text="{loc:Loc Key=PanelPopupMotion.Origin}" FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock x:Name="OriginHint" Text="{loc:Loc Key=PanelPopupMotion.OriginHint}" FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" MaxWidth="170"/>
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="OriginCombo" VerticalAlignment="Center" Width="130">
                    <ComboBoxItem x:Name="ItemOriginTopLeft" Content="{loc:Loc PanelPopupMotionOriginTopLeft}" Tag="TopLeft"/>
                    <ComboBoxItem x:Name="ItemOriginTopRight" Content="{loc:Loc PanelPopupMotionOriginTopRight}" Tag="TopRight"/>
                    <ComboBoxItem x:Name="ItemOriginBottomLeft" Content="{loc:Loc PanelPopupMotionOriginBottomLeft}" Tag="BottomLeft"/>
                    <ComboBoxItem x:Name="ItemOriginBottomRight" Content="{loc:Loc PanelPopupMotionOriginBottomRight}" Tag="BottomRight"/>
                </ComboBox>
            </Grid>

            <!-- Animation kind -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="AnimationKindLabel" Text="{loc:Loc Key=Motion.AnimationKind}" FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock x:Name="AnimationKindHint" Text="{loc:Loc Key=Motion.AnimationKindHint}" FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" TextWrapping="Wrap" MaxWidth="170"/>
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="AnimationCombo" VerticalAlignment="Center" Width="120">
                    <ComboBoxItem x:Name="ItemScaleExpand" Content="{loc:Loc MotionAnimationScaleExpand}" Tag="ScaleExpand"/>
                    <ComboBoxItem x:Name="ItemFade" Content="{loc:Loc MotionAnimationFade}" Tag="Fade"/>
                    <ComboBoxItem x:Name="ItemBounceExpand" Content="{loc:Loc MotionAnimationBounceExpand}" Tag="BounceExpand"/>
                    <ComboBoxItem x:Name="ItemDirectionalExpand" Content="{loc:Loc MotionAnimationDirectionalExpand}" Tag="DirectionalExpand"/>
                    <ComboBoxItem x:Name="ItemVerticalExpand" Content="{loc:Loc MotionAnimationVerticalExpand}" Tag="VerticalExpand"/>
                    <ComboBoxItem x:Name="ItemNone" Content="{loc:Loc MotionAnimationNone}" Tag="None"/>
                </ComboBox>
            </Grid>

            <!-- Speed slider -->
            <Grid Grid.Row="4" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SpeedLabel" Text="{loc:Loc Key=Motion.Speed}" FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock x:Name="SpeedHint" Text="{loc:Loc Key=Motion.SpeedHint}" FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                </StackPanel>
                <Slider Grid.Column="1" x:Name="SpeedSlider"
                        Minimum="0.25" Maximum="2.0" TickFrequency="0.25"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock Grid.Column="2" x:Name="SpeedValueText"
                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="{loc:Loc Key=Preset.Cancel}"
                        Padding="14,6" Cursor="Hand" Click="Cancel_Click"
                        Style="{DynamicResource OutlineBtn}"/>
                <Button x:Name="OkBtn" Content="{loc:Loc Key=Preset.Save}"
                        Padding="14,6" Margin="8,0,0,0"
                        Cursor="Hand" IsDefault="True" Click="Ok_Click"
                        Style="{DynamicResource FillBtn}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
