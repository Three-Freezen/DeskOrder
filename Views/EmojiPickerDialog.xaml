<Window x:Class="DesktopZones.Views.EmojiPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emoji" Width="380" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#F01A1A2E" CornerRadius="12"
            BorderBrush="#30FFFFFF" BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleLabel" Text="Pick Emoji" FontSize="14"
                       FontWeight="SemiBold" Foreground="#E8E8F0" Margin="4,4,0,10"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="EmojiGrid"/>
            </ScrollViewer>

            <Button x:Name="CancelBtn" Content="Cancel" Grid.Row="2"
                    Background="Transparent" Foreground="#8888A0"
                    BorderBrush="#404060" BorderThickness="1"
                    Padding="16,6" Cursor="Hand" FontSize="12"
                    HorizontalAlignment="Right" Margin="0,10,0,0"
                    Click="Cancel_Click">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
