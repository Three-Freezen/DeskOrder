<Window x:Class="DesktopZones.Views.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:DesktopZones.Views.Components"
        Title="DeskOrder" Width="1100" Height="680"
        MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
  <Border Background="{DynamicResource Brush.Bg.Base}" CornerRadius="10"
          BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="Black" Opacity="0.45"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="216"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="RightCol" Width="0"/>
      </Grid.ColumnDefinitions>

      <!-- Title bar -->
      <Border Grid.Row="0" Grid.ColumnSpan="3"
              Background="{DynamicResource Brush.Bg.Chrome}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0">
            <Path Width="16" Height="16" Margin="0,0,8,0" Stretch="Uniform"
                  Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.6"
                  StrokeLineJoin="Round"
                  Data="{StaticResource Icon.Zones}" VerticalAlignment="Center"/>
            <TextBlock Text="DeskOrder" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
            <TextBlock x:Name="CrumbSection" Text="分区" FontSize="12"
                       Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
            <TextBlock Text="/" FontSize="11" Margin="6,0"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
            <TextBlock x:Name="CrumbCurrent" Text="工作区" FontSize="12"
                       Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Width="46" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="MinimizeButton_Click" ToolTip="最小化">
              <Path Width="10" Height="10"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"
                    StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Minimize}"/>
            </Button>
            <Button x:Name="MaxBtn" Width="46" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="MaxBtn_Click" ToolTip="最大化">
              <Path Width="10" Height="10"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"
                    StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Maximize}"/>
            </Button>
            <Button Width="46" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="CloseButton_Click" ToolTip="关闭">
              <Path Width="10" Height="10"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"
                    StrokeLineJoin="Round"
                    Data="{StaticResource Icon.Close}"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Sidebar -->
      <components:SidebarNav Grid.Row="1" Grid.Column="0" x:Name="SideNav"/>

      <!-- Content -->
      <ContentControl Grid.Row="1" Grid.Column="1" x:Name="MainContent" Margin="0"/>

      <!-- PropertyPanel (docked) -->
      <components:PropertyPanel Grid.Row="1" Grid.Column="2" x:Name="DockedPanel"
                                Margin="0" Visibility="Collapsed"/>

      <!-- Status bar -->
      <Border Grid.Row="2" Grid.ColumnSpan="3"
              Background="{DynamicResource Brush.Bg.Chrome}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0"
              Padding="16,0">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                     Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="就绪" FontSize="11"
                       Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="ThemeBtn" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" ToolTip="切换主题" Click="ThemeBtn_Click">
              <Path x:Name="ThemeIcon" Width="14" Height="14" StrokeThickness="1.5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeLineJoin="Round"/>
            </Button>
            <TextBlock x:Name="ThemeLabel" Text="深色" FontSize="11" Margin="6,0,0,0"
                       Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>