<Window x:Class="DesktopZones.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopZones.Helpers"
        Title="{loc:Loc Key=Rename.Title}" Width="360" Height="180"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <!-- 背景填充/文字跟随电脑深浅色(与分区右键菜单同一套 Menu.* 调色板,不跟随管理界面主题) -->
    <Border Background="{DynamicResource Menu.Bg.Surface}" CornerRadius="10"
            BorderBrush="{DynamicResource Menu.Border.Subtle}" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleLabel" Text="Rename" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Menu.Text.Primary}" Margin="0,4,0,10"/>
            <!-- Title/content divider (贯穿;跟随电脑深浅色,同分区右键菜单分割线) -->
            <Border Grid.Row="1" Height="1" Margin="0,0,0,10"
                    Background="{DynamicResource Menu.Separator}"/>
            <!-- Optional prompt line (batch rename): hidden unless the caller passes one. -->
            <TextBlock x:Name="PromptText" Grid.Row="2" Text="" FontSize="11"
                       Foreground="{DynamicResource Menu.Text.Secondary}" TextWrapping="Wrap"
                       Margin="0,0,0,8" Visibility="Collapsed"/>
            <TextBox x:Name="NameInput" Grid.Row="3"
                     Background="{DynamicResource Menu.Bg.Hover}" Foreground="{DynamicResource Menu.Text.Primary}"
                     BorderBrush="{DynamicResource Menu.Border.Subtle}" BorderThickness="1"
                     Padding="8,6" FontSize="13"
                     KeyDown="NameInput_KeyDown"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelBtn" Content="Cancel"
                        Padding="14,6" Cursor="Hand" Click="Cancel_Click"
                        Style="{DynamicResource OutlineBtn}"/>
                <Button x:Name="OkBtn" Content="OK"
                        Padding="14,6" Margin="8,0,0,0"
                        Cursor="Hand" Click="Ok_Click"
                        Style="{DynamicResource FillBtn}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
